-- 4. MVCC: a fact row's key changed in the transaction, before the query - an
--    update of an indexed column, a new version under the new key - and a row
--    inserted with a key of the set: both found, as core's plan finds them.
BEGIN;
UPDATE fct SET fk = 1 + 331 WHERE id = 5;
INSERT INTO fct VALUES (200001, 1 + 2 * 331, 1, 999999, 'new');
SELECT okf($$SELECT f.id, f.rank, d.pk FROM fct f JOIN co d ON f.fk = d.pk
	WHERE f.fk IN (SELECT fk FROM kt WHERE prod = 7)
	ORDER BY f.rank DESC, f.id LIMIT 20$$);
                        okf                        
---------------------------------------------------
 LionOrderedJoin (key sets: kt in fct_fk), 20 rows
(1 row)

ROLLBACK;
-- 5. A partial lion index of the key: not folded into where the query does
--    not imply its predicate - it lacks rows the walk may meet - and folded
--    into where it does.  A key table of another type than the key's is no
--    key set at all (§47.7), folded or not: the plan is core's, its keys
--    looked up in the key's lion index.  And the setting off.
DROP INDEX fct_fk;
CREATE INDEX fct_fk_part ON fct USING lion (fk) WHERE prod < 10;
SELECT okf($$SELECT f.id, f.rank, d.pk FROM fct f JOIN co d ON f.fk = d.pk
	WHERE f.fk IN (SELECT fk FROM kt WHERE prod = 7)
	ORDER BY f.rank DESC, f.id LIMIT 20$$);
                   okf                   
-----------------------------------------
 LionOrderedJoin (key sets: kt), 20 rows
(1 row)

SELECT okf($$SELECT f.id, f.rank, d.pk FROM fct f JOIN co d ON f.fk = d.pk
	WHERE f.fk IN (SELECT fk FROM kt WHERE prod = 7) AND f.prod < 5
	ORDER BY f.rank DESC, f.id LIMIT 20$$);
                          okf                           
--------------------------------------------------------
 LionOrderedJoin (key sets: kt in fct_fk_part), 20 rows
(1 row)

DROP INDEX fct_fk_part;
CREATE INDEX fct_fk ON fct USING lion (fk);
CREATE TABLE ib8 AS SELECT fk::bigint AS fk FROM kt WHERE prod = 7;
ANALYZE ib8;
SELECT okf($$SELECT f.id, f.rank, d.pk FROM fct f JOIN co d ON f.fk = d.pk
	WHERE f.fk IN (SELECT fk FROM ib8) AND d.region < 5
	ORDER BY f.rank DESC, f.id LIMIT 20$$);
         okf          
----------------------
 core's plan, 20 rows
(1 row)

SET pg_lion.enable_key_set_fold = off;
SELECT okf($$SELECT f.id, f.rank, d.pk FROM fct f JOIN co d ON f.fk = d.pk
	WHERE f.fk IN (SELECT fk FROM kt WHERE prod = 7)
	ORDER BY f.rank DESC, f.id LIMIT 20$$);
                   okf                   
-----------------------------------------
 LionOrderedJoin (key sets: kt), 20 rows
(1 row)

RESET pg_lion.enable_key_set_fold;
-- 6. The fact's B-tree holds the key - an INCLUDE column here - and no lion
--    index does (§47.6, "Tested on the index tuple"): the walk tests the key
--    sets on its index tuples before it fetches, and an entry they reject is
--    turned away unfetched - Heap Fetches the rows they keep, Keys Rejected
--    by Key Sets the rest - and with nothing forced the split is the plan.
DROP INDEX fct_fk;
DROP INDEX fct_rank;
CREATE INDEX fct_rank ON fct (rank DESC) INCLUDE (fk);
ANALYZE fct;
SELECT okf($$SELECT f.id, f.rank, d.pk, d.tier FROM fct f JOIN co d ON f.fk = d.pk
	WHERE f.fk IN (SELECT fk FROM kt WHERE prod = 7)
	ORDER BY d.tier, f.rank DESC, f.id LIMIT 20$$);
                             okf                             
-------------------------------------------------------------
 LionOrderedSplit (key sets: kt tested on fct_rank), 20 rows
(1 row)

SELECT * FROM okf_run($$SELECT f.id, f.rank, d.pk, d.tier FROM fct f JOIN co d ON f.fk = d.pk
	WHERE f.fk IN (SELECT fk FROM kt WHERE prod = 7)
	ORDER BY d.tier, f.rank DESC, f.id LIMIT 20$$,
	'^\s*(Arms Run|Key Set|Keys Rejected|Index Entries Walked|Heap Fetches|Switched)');
             okf_run              
