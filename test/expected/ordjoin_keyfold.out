	LATERAL (SELECT f.id, f.rank, d.pk FROM fct f JOIN co d ON f.fk = d.pk
			  WHERE f.fk IN (SELECT fk FROM kt WHERE prod = v.p)
			  ORDER BY f.rank DESC LIMIT 100) s
	ORDER BY v.p, s.rank DESC, s.id$$);
