-- ... MVCC: a fact row's key changed in the transaction - never a HOT update,
--     the key being in the index, so the old index tuple holds the old key
--     and a new one the new - a row inserted with a key of the set, and rows
--     of the set's keys updated HOT, their index tuples' key their new
--     versions' too: all found as core's plan finds them.
BEGIN;
UPDATE fct SET fk = 1 + 331 WHERE id = 5;
INSERT INTO fct VALUES (200001, 1 + 2 * 331, 1, 999999, 'new');
UPDATE fct SET note = 'hot' WHERE fk IN (SELECT fk FROM kt WHERE prod = 7) AND id % 2 = 0;
SELECT okf($$SELECT f.id, f.rank, d.pk FROM fct f JOIN co d ON f.fk = d.pk
	WHERE f.fk IN (SELECT fk FROM kt WHERE prod = 7)
	ORDER BY f.rank DESC, f.id LIMIT 20$$);
                            okf                             
------------------------------------------------------------
 LionOrderedJoin (key sets: kt tested on fct_rank), 20 rows
(1 row)

ROLLBACK;
-- ... and the key a key column of the B-tree, after the rank it orders by
DROP INDEX fct_rank;
CREATE INDEX fct_rank ON fct (rank DESC, fk);
ANALYZE fct;
SELECT okf($$SELECT f.id, f.rank, d.pk FROM fct f JOIN co d ON f.fk = d.pk
	WHERE f.fk IN (SELECT fk FROM kt WHERE prod = 7)
	ORDER BY f.rank DESC, f.id LIMIT 20$$);
                            okf                             
------------------------------------------------------------
 LionOrderedJoin (key sets: kt tested on fct_rank), 20 rows
(1 row)

SELECT * FROM okf_run($$SELECT f.id, f.rank, d.pk FROM fct f JOIN co d ON f.fk = d.pk
	WHERE f.fk IN (SELECT fk FROM kt WHERE prod = 7)
	ORDER BY f.rank DESC, f.id LIMIT 20$$,
	'^\s*(Key Set|Keys Rejected|Index Entries Walked|Heap Fetches)');
             okf_run             
---------------------------------
