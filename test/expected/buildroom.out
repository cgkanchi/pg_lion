-- VACUUM keeps the lengths it finds and leaves everything verifiable.
DELETE FROM br WHERE id % 7 = 3;
VACUUM (FREEZE) br;
SELECT verified FROM br_shape('br_s_on');
 verified 
----------
 t
(1 row)

SELECT verified FROM br_shape('br_k_on');
