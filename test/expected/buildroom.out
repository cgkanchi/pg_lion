(1 row)

SELECT * FROM br_counts('s', 7);
 key | via_bitmap | via_count | via_heap 
-----+------------+-----------+----------
(0 rows)

SELECT * FROM br_counts('k');
 key | via_bitmap | via_count | via_heap 
-----+------------+-----------+----------
(0 rows)

DROP TABLE br;
DROP FUNCTION br_counts(text, int), br_shape(regclass);
