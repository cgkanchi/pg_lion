(1 row)

SELECT lion_ss_ix(format($$SELECT id FROM lion_ss WHERE k = ANY (%L::int[]) AND k = ANY (%L::int[]) AND tags && '{a1}'$$,
						 (SELECT array_agg(g)::text FROM generate_series(0, 35) g),
						 (SELECT array_agg(g)::text FROM generate_series(4, 39) g)));
                                lion_ss_ix                                
--------------------------------------------------------------------------
