(1 row)

RESET work_mem;
RESET pg_lion.scan_window_floor;
-- a multi-key column read whole (UNION), rechecked
SELECT lion_ss_ix($$SELECT id FROM lion_ss WHERE tags @> '{}' AND tags && '{a1,NULL}'$$);
