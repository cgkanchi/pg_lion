(1 row)

SELECT lion_ss_ix($$SELECT id FROM lion_ss WHERE tags && '{a1,a2}' AND tags && '{b2}' AND doc @@ 'd1'::tsquery AND doc @@ 'e2 | e4'::tsquery$$);
                               lion_ss_ix                               
------------------------------------------------------------------------
