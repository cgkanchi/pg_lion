SET pg_lion.scan_window_floor = '64kB';
SET work_mem = '64kB';
SELECT lion_ss_ix($$SELECT id FROM lion_ss WHERE tags && '{a1}' AND tags && '{b2}' AND k < 5$$);
                               lion_ss_ix                               
