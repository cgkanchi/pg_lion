(7 rows)

-- the pages a DELETE dirties are no longer all-visible
DELETE FROM rbi_part WHERE id % 700 = 0;
SELECT rbi_pp_counters('SELECT count(*) FROM rbi_part WHERE a = 3');
                                rbi_pp_counters                                 
--------------------------------------------------------------------------------
 Partitions: rbi_part_p1, rbi_part_p2x, rbi_part_p2d, rbi_part_p3, rbi_part_def
 Roaring Indexes: (a = 3)
 Heap Blocks Skipped via VM > 0
 Heap TIDs Rechecked > 0
 Heap Blocks Rechecked > 0
 Containers Visited > 0
(6 rows)

