SELECT lcs_check('SELECT CASE WHEN tags && ''{1}'' THEN 1.50 ELSE 0 END + CASE WHEN doc ? ''k1'' THEN 0.125 ELSE 0 END AS m, count(*) FROM lcs c WHERE NOT EXISTS (SELECT 1 FROM lcs_skip s WHERE s.a = c.n AND CASE WHEN c.tags && ''{1}'' THEN 1.50 ELSE 0 END + CASE WHEN c.doc ? ''k1'' THEN 0.125 ELSE 0 END > s.a % 2) GROUP BY 1');
