-- ... and rescanned, for each outer row: the labels located again
SELECT lcs_check('SELECT x, t.* FROM (VALUES (30), (60), (30)) v(x), LATERAL (SELECT (c.tags && ''{1}'')::int + (c.doc ? ''k1'')::int + (c.w @@ ''b2''::tsquery)::int AS m, count(*) FROM lcs c WHERE c.n < x AND NOT EXISTS (SELECT 1 FROM lcs_skip s WHERE s.a = c.n) GROUP BY 1) t');
