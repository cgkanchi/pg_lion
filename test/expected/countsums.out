-- ... and beside a GROUP BY column, which drives
SELECT lcs_check('SELECT n, (tags && ''{1}'')::int + (tags && ''{2}'')::int + (doc ? ''k1'')::int AS m, count(*) FROM lcs c WHERE NOT EXISTS (SELECT 1 FROM lcs_skip s WHERE s.a = c.id) GROUP BY 1, 2');
