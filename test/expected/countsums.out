-- ... a join clause that reads the sum, from the cell's value
SELECT lcs_check('SELECT (tags && ''{1}'')::int + (tags && ''{2}'')::int + (tags && ''{41}'')::int AS m, count(*) FROM lcs c WHERE NOT EXISTS (SELECT 1 FROM lcs_skip s WHERE s.a = c.n AND (c.tags && ''{1}'')::int + (c.tags && ''{2}'')::int + (c.tags && ''{41}'')::int < s.a % 3) GROUP BY 1');
