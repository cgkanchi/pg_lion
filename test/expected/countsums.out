-- ---------- 6. the rows changed ----------
UPDATE lcs SET tags = '{1,2,41}' WHERE id IN (523, 1046, 1569);
UPDATE lcs SET doc = NULL, labels = '{l1}' WHERE n = 7 AND id % 3 = 0;
DELETE FROM lcs WHERE n = 11 AND id % 5 = 0;
SELECT left(q, 100) AS q, lcs_check(q) FROM (VALUES
	('SELECT tier, count(*) FROM lcs_tiered GROUP BY tier'),
	('SELECT score, count(*) FROM lcs_scored t WHERE NOT EXISTS (SELECT 1 FROM lcs_skip s WHERE s.a = t.n) GROUP BY score')
) v(q);
                                                  q                                                   |                  lcs_check                   
------------------------------------------------------------------------------------------------------+----------------------------------------------
 SELECT tier, count(*) FROM lcs_tiered GROUP BY tier                                                  | 2025 cells, 3 rows, rows tested in the heap
 SELECT score, count(*) FROM lcs_scored t WHERE NOT EXISTS (SELECT 1 FROM lcs_skip s WHERE s.a = t.n) | 2025 cells, 66 rows, rows tested in the heap
(2 rows)

VACUUM lcs;
-- ---------- 7. in parallel ----------
SET max_parallel_workers_per_gather = 2;
SET parallel_setup_cost = 0;
SET parallel_tuple_cost = 0;
SET min_parallel_table_scan_size = 0;
SET min_parallel_index_scan_size = 0;
SET pg_lion.parallel_range_keys = 1;
SELECT left(q, 100) AS q, lcs_check(q) FROM (VALUES
	('SELECT tier, count(*) FROM lcs_tiered GROUP BY tier'),
	('SELECT r, score, count(*) FROM lcs_scored GROUP BY r, score'),
	('SELECT ' || lcs_terms(70) || ' AS m, count(*) FROM lcs GROUP BY 1'),
	('SELECT score, count(*) FROM lcs_scored t WHERE NOT EXISTS (SELECT 1 FROM lcs_skip s WHERE s.a = t.n) GROUP BY score')
) v(q);
                                                  q                                                   |           lcs_check           
------------------------------------------------------------------------------------------------------+-------------------------------
 SELECT tier, count(*) FROM lcs_tiered GROUP BY tier                                                  | parallel 2025 cells, 3 rows
 SELECT r, score, count(*) FROM lcs_scored GROUP BY r, score                                          | parallel 2025 cells, 302 rows
 SELECT (tags && '{0}')::int + (tags && '{1}')::int + (tags && '{2}')::int + (tags && '{3}')::int + ( | parallel 72 cells, 5 rows
 SELECT score, count(*) FROM lcs_scored t WHERE NOT EXISTS (SELECT 1 FROM lcs_skip s WHERE s.a = t.n) | 2025 cells, 66 rows
(4 rows)

RESET max_parallel_workers_per_gather;
RESET parallel_setup_cost;
RESET parallel_tuple_cost;
RESET min_parallel_table_scan_size;
RESET min_parallel_index_scan_size;
RESET pg_lion.parallel_range_keys;
SET max_parallel_workers_per_gather = 0;
RESET enable_hashjoin;
RESET enable_mergejoin;
RESET enable_nestloop;
DROP VIEW lcs_tiered;
DROP VIEW lcs_scored;
DROP TABLE lcs, lcs_skip;
DROP FUNCTION lcs_terms(int, int);
DROP FUNCTION lcs_check(text);
