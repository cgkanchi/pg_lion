DROP TABLE rs, rs_rest, rs_q, rs_list;
DROP FUNCTION rs_vec(bigint, int, float8), rs_evict(), rs_ids(text),
	rs_each(text, text), rs_same(text), rs_cursor(text), rs_grow(text),
	rs_boom(int, int), rs_fail(text), rs_evict_half(boolean),
	rs_halves(text), rs_evict_below(regclass, bigint), rs_list_rests(text);
