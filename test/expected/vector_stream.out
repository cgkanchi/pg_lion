-- What each way read, on the exact path with every page in shared buffers:
-- through a stream (17 and later) 32 of the members' blocks before the list
-- rests, the next 256 read by the scan alone, and so on by turns; asking
-- the kernel, 32 asks before they fall dormant (vector_stream_1.out on 16,
-- where stream is fadvise)
SELECT count(*) FROM (SELECT id FROM rs WHERE tag = 3
					   ORDER BY v <-> rs_vec(7, 24) LIMIT 10) s;
 count 
-------
    10
(1 row)

SET client_min_messages = debug1;
SET pg_lion.vector_prefetch = stream;
