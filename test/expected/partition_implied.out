(1 row)

SELECT lion_ip($q$SELECT x, count(*) FROM ip WHERE kind IN ('a', 'b') AND ts >= '2026-01-01' AND ts < '2026-06-01' GROUP BY x$q$);
                                                                       lion_ip                                                                       
-----------------------------------------------------------------------------------------------------------------------------------------------------
 pushed down, 5 rows; implied: (kind = ANY ('{a,b}'::text[])), (ts >= 'Thu Jan 01 00:00:00 2026 PST'::timestamp with time zone) in 1 of 2 partitions
(1 row)

/*
 * an OR across columns, implied as a whole by ip_a_2026 alone; ip_a_2025's
 * bound refutes its first arm, and leaves it fk = 3
 */
SELECT lion_ipplan($q$SELECT count(*) FROM ip WHERE kind IN ('a', 'b') AND (ts >= '2026-01-01' OR fk = 3) AND tags && '{x1}'$q$);
                                                                            lion_ipplan                                                                             
--------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (LionCount)
   Partitions: ip_a_2025, ip_a_2026, ip_b
   Lion Indexes: ((ts >= 'Thu Jan 01 00:00:00 2026 PST'::timestamp with time zone) OR (fk = 3)), (tags && '{x1}'::text[])
   Implied by Partition Bounds: (kind = ANY ('{a,b}'::text[])), ((ts >= 'Thu Jan 01 00:00:00 2026 PST'::timestamp with time zone) OR (fk = 3)) in 1 of 3 partitions
   Refuted by Partition Bounds: (ts >= 'Thu Jan 01 00:00:00 2026 PST'::timestamp with time zone) in 1 of 3 partitions
(5 rows)

SELECT lion_ip($q$SELECT count(*) FROM ip WHERE kind IN ('a', 'b') AND (ts >= '2026-01-01' OR fk = 3) AND tags && '{x1}'$q$);
                                                                              lion_ip                                                                              
-------------------------------------------------------------------------------------------------------------------------------------------------------------------
 pushed down, 1 rows; implied: (kind = ANY ('{a,b}'::text[])), ((ts >= 'Thu Jan 01 00:00:00 2026 PST'::timestamp with time zone) OR (fk = 3)) in 1 of 3 partitions
(1 row)

-- ---- OR arms the partition bounds refute ---------------------------------
/*
 * A filter per kind, ORed: in a partition of one kind the arms of the others
 * are never true and are left out, and in the arm it keeps `kind = ...` is
 * implied and left out too.  ip_a's leaves count tags && '{x1}' AND tags &&
 * '{y2}', ip_b counts tags && '{x3}', and ip_cd, whose two-value bound
 * implies what is left of the OR (kind = 'c' OR kind = 'd'), leaves it out
 * whole.  Without the refutation no partition but ip_cd has an index for
 * `kind = ...`, and the query was declined.
 */
SELECT lion_ipplan($q$SELECT count(*) FROM ip WHERE ((kind = 'a' AND tags && '{x1}' AND tags && '{y2}') OR (kind = 'b' AND tags && '{x3}') OR kind = 'c' OR kind = 'd') AND ts >= '2025-06-01'$q$);
                                                                                                                                                       lion_ipplan                                                                                                                                                       
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (LionCount)
   Partitions: ip_a_2025, ip_a_2026, ip_b, ip_cd
   Lion Indexes: (ts >= 'Sun Jun 01 00:00:00 2025 PDT'::timestamp with time zone), (((kind = 'a'::text) AND (tags && '{x1}'::text[]) AND (tags && '{y2}'::text[])) OR ((kind = 'b'::text) AND (tags && '{x3}'::text[])) OR (kind = 'c'::text) OR (kind = 'd'::text))
   Implied by Partition Bounds: (((kind = 'a'::text) AND (tags && '{x1}'::text[]) AND (tags && '{y2}'::text[])) OR ((kind = 'b'::text) AND (tags && '{x3}'::text[])) OR (kind = 'c'::text) OR (kind = 'd'::text)) in 1 of 4 partitions, (kind = 'a'::text) in 2 of 4 partitions, (kind = 'b'::text) in 1 of 4 partitions
   Refuted by Partition Bounds: ((kind = 'a'::text) AND (tags && '{x1}'::text[]) AND (tags && '{y2}'::text[])) in 1 of 4 partitions, ((kind = 'b'::text) AND (tags && '{x3}'::text[])) in 2 of 4 partitions, (kind = 'c'::text) in 3 of 4 partitions, (kind = 'd'::text) in 3 of 4 partitions
(5 rows)

SELECT lion_ip($q$SELECT count(*) FROM ip WHERE ((kind = 'a' AND tags && '{x1}' AND tags && '{y2}') OR (kind = 'b' AND tags && '{x3}') OR kind = 'c' OR kind = 'd') AND ts >= '2025-06-01'$q$);
                                                                                                                                                        lion_ip                                                                                                                                                         
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 pushed down, 1 rows; implied: (((kind = 'a'::text) AND (tags && '{x1}'::text[]) AND (tags && '{y2}'::text[])) OR ((kind = 'b'::text) AND (tags && '{x3}'::text[])) OR (kind = 'c'::text) OR (kind = 'd'::text)) in 1 of 4 partitions, (kind = 'a'::text) in 2 of 4 partitions, (kind = 'b'::text) in 1 of 4 partitions
(1 row)

SELECT lion_ip($q$SELECT count(*) FROM ip WHERE ((kind = 'a' AND tags && '{x1}' AND tags && '{y2}') OR (kind = 'b' AND tags && '{x3}') OR kind = 'c' OR kind = 'd') AND ts >= now() - interval '100 years'$q$);
                                                                                                                                                        lion_ip                                                                                                                                                         
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 pushed down, 1 rows; implied: (((kind = 'a'::text) AND (tags && '{x1}'::text[]) AND (tags && '{y2}'::text[])) OR ((kind = 'b'::text) AND (tags && '{x3}'::text[])) OR (kind = 'c'::text) OR (kind = 'd'::text)) in 1 of 4 partitions, (kind = 'a'::text) in 2 of 4 partitions, (kind = 'b'::text) in 1 of 4 partitions
(1 row)

SELECT lion_ip($q$SELECT count(*) FROM ip WHERE ((kind = 'a' AND tags && '{x1}' AND tags && '{y2}') OR (kind = 'b' AND tags && '{x3}') OR kind = 'c' OR kind = 'd') AND tags && '{y5}'$q$);
                                                                                                                                                        lion_ip                                                                                                                                                         
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 pushed down, 1 rows; implied: (((kind = 'a'::text) AND (tags && '{x1}'::text[]) AND (tags && '{y2}'::text[])) OR ((kind = 'b'::text) AND (tags && '{x3}'::text[])) OR (kind = 'c'::text) OR (kind = 'd'::text)) in 1 of 4 partitions, (kind = 'a'::text) in 2 of 4 partitions, (kind = 'b'::text) in 1 of 4 partitions
(1 row)

SELECT lion_ip($q$SELECT x, count(*) FROM ip WHERE ((kind = 'a' AND tags && '{x1}' AND tags && '{y2}') OR (kind = 'b' AND tags && '{x3}') OR kind = 'c' OR kind = 'd') AND ts >= '2025-06-01' GROUP BY x$q$);
                                                                                                                                                                                                    lion_ip                                                                                                                                                                                                    
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 pushed down, 5 rows; implied: (((kind = 'a'::text) AND (tags && '{x1}'::text[]) AND (tags && '{y2}'::text[])) OR ((kind = 'b'::text) AND (tags && '{x3}'::text[])) OR (kind = 'c'::text) OR (kind = 'd'::text)) in 1 of 4 partitions, (kind = 'a'::text) in 2 of 4 partitions, (kind = 'b'::text) in 1 of 4 partitions, (ts >= 'Sun Jun 01 00:00:00 2025 PDT'::timestamp with time zone) in 1 of 4 partitions
(1 row)

SELECT lion_ip($q$SELECT fk, x, count(*) FROM ip WHERE (kind = 'a' AND tags && '{x1}') OR (kind = 'b' AND tags && '{x3}') GROUP BY fk, x$q$);
                                                     lion_ip                                                      
------------------------------------------------------------------------------------------------------------------
 pushed down, 155 rows; implied: (kind = 'a'::text) in 2 of 3 partitions, (kind = 'b'::text) in 1 of 3 partitions
(1 row)

/*
 * An arm a sub-partition's bound refutes: ip_a_2025 keeps only the second
 * arm, ip_a_2026 both.  The first arm's range carries no pin (§32), so where
 * it is kept the count needs another clause to select rows by: tags &&
 * '{y1}', or, with ip_a_2025 the only partition left, the range on ts that
 * then drives the count.  With neither, ip_a_2026 declines the query.
 */
SELECT lion_ipplan($q$SELECT count(*) FROM ip WHERE kind = 'a' AND tags && '{y1}' AND ((ts >= '2026-03-01' AND tags && '{x1}') OR x = 2)$q$);
                                                                      lion_ipplan                                                                       
--------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (LionCount)
   Partitions: ip_a_2025, ip_a_2026
   Lion Indexes: (tags && '{y1}'::text[]), (((ts >= 'Sun Mar 01 00:00:00 2026 PST'::timestamp with time zone) AND (tags && '{x1}'::text[])) OR (x = 2))
   Implied by Partition Bounds: (kind = 'a'::text)
   Refuted by Partition Bounds: ((ts >= 'Sun Mar 01 00:00:00 2026 PST'::timestamp with time zone) AND (tags && '{x1}'::text[])) in 1 of 2 partitions
(5 rows)

SELECT lion_ip($q$SELECT count(*) FROM ip WHERE kind = 'a' AND tags && '{y1}' AND ((ts >= '2026-03-01' AND tags && '{x1}') OR x = 2)$q$);
                     lion_ip                      
--------------------------------------------------
 pushed down, 1 rows; implied: (kind = 'a'::text)
(1 row)

SELECT lion_ip($q$SELECT count(*) FROM ip WHERE kind = 'a' AND ts < '2026-01-01' AND ((ts >= '2026-03-01' AND tags && '{x1}') OR x = 2)$q$);
                     lion_ip                      
--------------------------------------------------
 pushed down, 1 rows; implied: (kind = 'a'::text)
(1 row)

SELECT lion_ip($q$SELECT count(*) FROM ip WHERE kind = 'a' AND ((ts >= '2026-03-01' AND tags && '{x1}') OR x = 2)$q$);
         lion_ip         
-------------------------
 not pushed down, 1 rows
(1 row)

/*
 * The two-value bound of ip_cd refutes the arm on 'a' and implies neither
 * `kind = 'c'` nor `kind = 'd'`: it answers them from its own index on kind.
 */
SELECT lion_ipplan($q$SELECT count(*) FROM ip WHERE (kind = 'c' AND tags && '{x1}') OR (kind = 'a' AND tags && '{x2}')$q$);
                                                                                  lion_ipplan                                                                                  
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (LionCount)
   Partitions: ip_a_2025, ip_a_2026, ip_cd
   Lion Indexes: (((kind = 'c'::text) AND (tags && '{x1}'::text[])) OR ((kind = 'a'::text) AND (tags && '{x2}'::text[])))
   Implied by Partition Bounds: (kind = 'a'::text) in 2 of 3 partitions
   Refuted by Partition Bounds: ((kind = 'c'::text) AND (tags && '{x1}'::text[])) in 2 of 3 partitions, ((kind = 'a'::text) AND (tags && '{x2}'::text[])) in 1 of 3 partitions
(5 rows)

SELECT lion_ip($q$SELECT count(*) FROM ip WHERE (kind = 'c' AND tags && '{x1}') OR (kind = 'a' AND tags && '{x2}')$q$);
                                lion_ip                                
-----------------------------------------------------------------------
 pushed down, 1 rows; implied: (kind = 'a'::text) in 2 of 3 partitions
(1 row)

SELECT lion_ip($q$SELECT fk, count(*) FROM ip WHERE (kind = 'c' AND tags && '{x1}') OR (kind = 'd' AND x = 1) OR (kind = 'b' AND tags && '{x2}') GROUP BY fk$q$);
                                 lion_ip                                 
-------------------------------------------------------------------------
 pushed down, 111 rows; implied: (kind = 'b'::text) in 1 of 2 partitions
(1 row)

/*
 * The default partition refutes the arm on 'a', but not `kind = 'e'`, which
 * it has no index for: declined, as ip_n is for the arm `kind IS NULL`.
 */
SELECT lion_ip($q$SELECT count(*) FROM ip WHERE (kind = 'e' AND tags && '{x1}') OR (kind = 'a' AND tags && '{x2}')$q$);
         lion_ip         
-------------------------
 not pushed down, 1 rows
(1 row)

SELECT lion_ip($q$SELECT count(*) FROM ip WHERE (kind IS NULL AND tags && '{x1}') OR (kind = 'b' AND tags && '{x2}')$q$);
         lion_ip         
-------------------------
 not pushed down, 1 rows
(1 row)

/*
 * Without plan-time pruning every partition is counted, and one whose bounds
 * refute every arm has nothing to count: it is not counted at all.
 */
SET enable_partition_pruning = off;
SELECT lion_ipplan($q$SELECT count(*) FROM ip WHERE (kind = 'a' AND tags && '{x1}') OR (kind = 'b' AND tags && '{x3}')$q$);
                                                                                  lion_ipplan                                                                                  
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (LionCount)
   Partitions: ip_a_2025, ip_a_2026, ip_b
   Lion Indexes: (((kind = 'a'::text) AND (tags && '{x1}'::text[])) OR ((kind = 'b'::text) AND (tags && '{x3}'::text[])))
   Implied by Partition Bounds: (kind = 'a'::text) in 2 of 3 partitions, (kind = 'b'::text) in 1 of 3 partitions
   Refuted by Partition Bounds: ((kind = 'a'::text) AND (tags && '{x1}'::text[])) in 1 of 3 partitions, ((kind = 'b'::text) AND (tags && '{x3}'::text[])) in 2 of 3 partitions
(5 rows)

SELECT lion_ip($q$SELECT count(*) FROM ip WHERE (kind = 'a' AND tags && '{x1}') OR (kind = 'b' AND tags && '{x3}')$q$);
                                                    lion_ip                                                     
----------------------------------------------------------------------------------------------------------------
 pushed down, 1 rows; implied: (kind = 'a'::text) in 2 of 3 partitions, (kind = 'b'::text) in 1 of 3 partitions
(1 row)

RESET enable_partition_pruning;
-- ---- NULLs and the default partition -------------------------------------
/*
 * ip_n holds NULL as well as 'n', so neither `kind = 'n'` nor `kind IS NULL`
 * is implied there and, with no index on kind, the query is declined; the OR
 * of the two is implied, and is left out.
 */
SELECT lion_ip($q$SELECT count(*) FROM ip WHERE kind = 'n' AND tags && '{x1}'$q$);
         lion_ip         
-------------------------
 not pushed down, 1 rows
(1 row)

SELECT lion_ip($q$SELECT count(*) FROM ip WHERE kind IS NULL AND tags && '{x1}'$q$);
         lion_ip         
-------------------------
 not pushed down, 1 rows
(1 row)

SELECT lion_ip($q$SELECT count(*) FROM ip WHERE (kind IS NULL OR kind = 'n') AND tags && '{x1}'$q$);
                               lion_ip                                
----------------------------------------------------------------------
 pushed down, 1 rows; implied: ((kind IS NULL) OR (kind = 'n'::text))
(1 row)

/*
 * The default partition's bound is the negation of every other one's, and
 * implies no equality: 'e' could share it with anything no partition lists.
 * It does imply the NOT IN of every listed value - no posting set answers
 * that, and it is left out altogether.  `kind IS NOT NULL` is implied by
 * every partition but ip_n, which holds the NULLs (the default partition
 * would, if no other partition took them) and has no index on kind:
 * declined.
 */
SELECT lion_ip($q$SELECT count(*) FROM ip WHERE kind = 'e' AND tags && '{x1}'$q$);
         lion_ip         
-------------------------
 not pushed down, 1 rows
(1 row)

SELECT lion_ip($q$SELECT count(*) FROM ip WHERE kind NOT IN ('a', 'b', 'c', 'd', 'n') AND tags && '{x1}'$q$);
                               lion_ip                               
---------------------------------------------------------------------
 pushed down, 1 rows; implied: (kind <> ALL ('{a,b,c,d,n}'::text[]))
(1 row)

SELECT lion_ip($q$SELECT count(*) FROM ip WHERE kind IS NOT NULL AND tags && '{x1}'$q$);
         lion_ip         
-------------------------
 not pushed down, 1 rows
(1 row)

-- ---- still declined ------------------------------------------------------
/* nothing left in the partitions to select rows by */
SELECT lion_ip($q$SELECT count(*) FROM ip WHERE kind = 'a'$q$);
         lion_ip         
-------------------------
 not pushed down, 1 rows
(1 row)

SELECT lion_ip($q$SELECT count(*) FROM ip WHERE kind = 'a' AND fk IS NOT NULL$q$);
         lion_ip         
-------------------------
 not pushed down, 1 rows
(1 row)

/* a pinned column the target list prints comes out of the index's key */
SELECT lion_ip($q$SELECT kind, count(*) FROM ip WHERE kind = 'b' AND tags && '{x1}' GROUP BY kind$q$);
         lion_ip         
-------------------------
 not pushed down, 1 rows
(1 row)

/* a volatile clause is the query's to run per row */
SELECT lion_ip($q$SELECT count(*) FROM ip WHERE (kind = 'a' OR random() < 0) AND tags && '{x1}'$q$);
         lion_ip         
-------------------------
 not pushed down, 1 rows
(1 row)

/* a parameter proves nothing at plan time: a generic plan declines */
PREPARE ip_kind(text) AS SELECT count(*) FROM ip WHERE kind = $1 AND tags && '{x1}';
SET plan_cache_mode = force_generic_plan;
SELECT lion_ipplan('EXECUTE ip_kind(''a'')');
                           lion_ipplan                           
-----------------------------------------------------------------
 Aggregate
   ->  Append
         Subplans Removed: 4
         ->  Bitmap Heap Scan on ip_a_2025 ip_1
               Recheck Cond: (tags && '{x1}'::text[])
               Filter: (kind = $1)
               ->  Bitmap Index Scan on ip_a_2025_tags_ts_fk_idx
                     Index Cond: (tags && '{x1}'::text[])
         ->  Bitmap Heap Scan on ip_a_2026 ip_2
               Recheck Cond: (tags && '{x1}'::text[])
               Filter: (kind = $1)
               ->  Bitmap Index Scan on ip_a_2026_tags_ts_fk_idx
                     Index Cond: (tags && '{x1}'::text[])
(13 rows)

EXECUTE ip_kind('a');
 count 
-------
  1144
(1 row)

SET plan_cache_mode = force_custom_plan;
SELECT lion_ipplan('EXECUTE ip_kind(''a'')');
                    lion_ipplan                    
---------------------------------------------------
 Custom Scan (LionCount)
   Partitions: ip_a_2025, ip_a_2026
   Lion Indexes: (tags && '{x1}'::text[])
   Implied by Partition Bounds: (kind = 'a'::text)
(4 rows)

EXECUTE ip_kind('a');
