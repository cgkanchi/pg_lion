 SELECT count(*) FROM sp WHERE 't1' = ANY (tags) AND 't2' = ANY (tags)          | count, 1 rows
 SELECT count(*) FROM sp WHERE 't1' = ANY (tags) AND 2 = ANY (i4)               | count, 1 rows
