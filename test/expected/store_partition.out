-- 4. A WHERE on the partition key, which no lion index answers: the bounds of
--    every partition counted imply it, and it is left out.  Through the
--    sub-partitions' bounds as well, where it prunes down to one partition.
SELECT * FROM lsp_plan('SELECT g, count(*), sum(v) FROM lsp WHERE kind IN (''a'', ''c'') AND k < 5 GROUP BY g');
                           lsp_plan                            
---------------------------------------------------------------
 Custom Scan (LionCount)
   Partitions: lsp_a, lsp_c
   Lion Indexes: (k < 5)
   Implied by Partition Bounds: (kind = ANY ('{a,c}'::text[]))
   Group Key: g
   Store: g, v
(6 rows)

SELECT lsp_check('SELECT g, count(*) AS n, sum(v), count(DISTINCT s) AS ds FROM lsp WHERE kind IN (''a'', ''c'') AND k < 5 GROUP BY g');
                                         lsp_check                                         
-------------------------------------------------------------------------------------------
 store (g, v, s) over 2 partitions: all from the store, 26 rows, same as the ordinary plan
(1 row)

SELECT lsp_check('SELECT count(DISTINCT g), sum(i2) FROM lsp WHERE kind <> ''zz'' AND kind IN (''b'', ''c'') AND k = 4');
                                       lsp_check                                        
----------------------------------------------------------------------------------------
 store (g, i2) over 3 partitions: all from the store, 1 rows, same as the ordinary plan
(1 row)

SELECT * FROM lsp_plan('SELECT g, count(*) FROM lsp WHERE kind = ''b'' AND id >= 20000 AND k IN (3, 4) GROUP BY g');
                             lsp_plan                             
------------------------------------------------------------------
 Custom Scan (LionCount)
   Partitions: lsp_b2
   Lion Indexes: (k = ANY ('{3,4}'::integer[]))
   Implied by Partition Bounds: (id >= 20000), (kind = 'b'::text)
   Group Key: g
   Store: g
(6 rows)

SELECT lsp_check('SELECT g, count(*) AS n, max(v) FROM lsp WHERE kind = ''b'' AND id >= 20000 AND k IN (3, 4) GROUP BY g');
                                       lsp_check                                       
---------------------------------------------------------------------------------------
 store (g, v) over 1 partition: all from the store, 11 rows, same as the ordinary plan
(1 row)

-- 5. Plan-time pruning: down to one partition, and down to none, which is
--    the planner's own empty plan.
SELECT * FROM lsp_plan('SELECT g, count(*), sum(v) FROM lsp WHERE kind = ''a'' AND k < 5 GROUP BY g');
                     lsp_plan                      
---------------------------------------------------
 Custom Scan (LionCount)
   Partitions: lsp_a
   Lion Indexes: (k < 5)
   Implied by Partition Bounds: (kind = 'a'::text)
   Group Key: g
   Store: g, v
(6 rows)

SELECT lsp_check('SELECT g, count(*) AS n, sum(v), count(DISTINCT s) AS ds FROM lsp WHERE kind = ''a'' AND k < 5 GROUP BY g');
                                        lsp_check                                         
------------------------------------------------------------------------------------------
 store (g, v, s) over 1 partition: all from the store, 26 rows, same as the ordinary plan
(1 row)

SELECT lsp_check('SELECT g, count(*) AS n FROM lsp WHERE kind = ''zz'' AND k < 5 GROUP BY g');
                   lsp_check                    
------------------------------------------------
 no pushdown, 0 rows, same as the ordinary plan
(1 row)

SELECT lsp_check('SELECT count(*), sum(v), count(DISTINCT g) FROM lsp WHERE kind = ''zz'' AND k < 5');
                   lsp_check                    
------------------------------------------------
 no pushdown, 1 rows, same as the ordinary plan
(1 row)

-- 6. Declined: a partition whose lion index does not store a gathered
--    column, unless pruning leaves it out; and one with no lion index at all.
CREATE TABLE lsp_d (LIKE lsp) WITH (autovacuum_enabled = off);
INSERT INTO lsp_d SELECT i, 'd', (i / 3) % 40, (i / 3) % 50, i, 1, 'x', date '2024-01-01'
  FROM generate_series(40000, 42999) i;
CREATE INDEX lsp_d_k ON lsp_d USING lion (k) INCLUDE (g);
VACUUM (FREEZE, ANALYZE) lsp_d;
ALTER TABLE lsp ATTACH PARTITION lsp_d FOR VALUES IN ('d');
SELECT lsp_check('SELECT g, count(*) AS n, sum(v) FROM lsp WHERE k < 5 GROUP BY g');
                    lsp_check                    
-------------------------------------------------
 no pushdown, 26 rows, same as the ordinary plan
(1 row)

SELECT lsp_check('SELECT sum(v) FROM lsp WHERE kind = ''d'' AND k < 5');
                   lsp_check                    
------------------------------------------------
 no pushdown, 1 rows, same as the ordinary plan
(1 row)

SELECT lsp_check('SELECT g, count(*) AS n FROM lsp WHERE k < 5 GROUP BY g');
                                      lsp_check                                      
-------------------------------------------------------------------------------------
 store (g) over 5 partitions: all from the store, 26 rows, same as the ordinary plan
(1 row)

SELECT lsp_check('SELECT g, count(*) AS n, sum(v) FROM lsp WHERE kind IN (''a'', ''b'', ''c'') AND k < 5 GROUP BY g');
                                       lsp_check                                        
----------------------------------------------------------------------------------------
 store (g, v) over 4 partitions: all from the store, 26 rows, same as the ordinary plan
(1 row)

ALTER TABLE lsp DETACH PARTITION lsp_d;
CREATE TABLE lsp_e (LIKE lsp) WITH (autovacuum_enabled = off);
INSERT INTO lsp_e SELECT i, 'e', (i / 3) % 40, (i / 3) % 50, i, 1, 'x', date '2024-01-01'
  FROM generate_series(40000, 42999) i;
VACUUM (FREEZE, ANALYZE) lsp_e;
ALTER TABLE lsp ATTACH PARTITION lsp_e FOR VALUES IN ('e');
SELECT lsp_check('SELECT g, count(*) AS n FROM lsp WHERE k < 5 GROUP BY g');
                    lsp_check                    
-------------------------------------------------
 no pushdown, 26 rows, same as the ordinary plan
(1 row)

SELECT lsp_check('SELECT count(DISTINCT g), sum(v) FROM lsp');
                   lsp_check                    
------------------------------------------------
 no pushdown, 1 rows, same as the ordinary plan
(1 row)

SELECT lsp_check('SELECT count(DISTINCT g), sum(v) FROM lsp WHERE kind IN (''a'', ''b'', ''c'') AND k < 5');
                                       lsp_check                                       
---------------------------------------------------------------------------------------
 store (g, v) over 4 partitions: all from the store, 1 rows, same as the ordinary plan
(1 row)

ALTER TABLE lsp DETACH PARTITION lsp_e;
DROP TABLE lsp_d, lsp_e;
-- 7. Dirty pages in one partition: rows of lsp_b updated and deleted since
--    the VACUUM, and some inserted.  Their pages' rows come from the heap,
--    for their visibility and their values; the other partitions' from the
--    store.
UPDATE lsp SET g = g + 1, s = NULL, v = v + 1 WHERE kind = 'b' AND id % 7 = 0;
DELETE FROM lsp WHERE kind = 'b' AND id % 11 = 0;
INSERT INTO lsp (id, kind, k, g, v, i2, s, d)
SELECT i, 'b', i % 40, i % 50, i, 2, 'new', date '2025-01-01'
  FROM generate_series(50000, 50299) i;
SELECT lsp_check('SELECT g, count(*) AS n, sum(v), count(DISTINCT s) AS ds FROM lsp WHERE k < 10 GROUP BY g');
                                       lsp_check                                       
---------------------------------------------------------------------------------------
 store (g, v, s) over 4 partitions: store and heap, 52 rows, same as the ordinary plan
(1 row)

SELECT lsp_check('SELECT count(*), count(DISTINCT s), sum(v), min(d), max(d) FROM lsp');
                                      lsp_check                                       
--------------------------------------------------------------------------------------
 store (s, v, d) over 4 partitions: store and heap, 1 rows, same as the ordinary plan
(1 row)

SELECT lsp_check('SELECT g, count(*) AS n, max(v) FROM lsp WHERE kind IN (''a'', ''b'') AND k IN (3, 4) GROUP BY g');
                                     lsp_check                                      
------------------------------------------------------------------------------------
 store (g, v) over 3 partitions: store and heap, 16 rows, same as the ordinary plan
(1 row)

SELECT * FROM lsp_plan('SELECT g, count(*), sum(v) FROM lsp WHERE k < 5 GROUP BY g', true);
                    lsp_plan                     
-------------------------------------------------
 Custom Scan (LionCount)
   Partitions: lsp_a, lsp_b1, lsp_b2, lsp_c
   Lion Indexes: (k < 5)
   Group Key: g
   Store: g, v
   Store Rows, from the store and the heap: 4403
   Store Rows > 0: t, From Heap > 0: t
   Store Pages Absent > 0: f
   Store Groups: 31
   Store Batches > 1: f
   Store Disk Usage > 0: f
(11 rows)

SELECT count(*) AS rows_counted FROM lsp WHERE k < 5;
 rows_counted 
--------------
         4403
(1 row)

-- ... and an open transaction's own changes, in two other partitions
BEGIN;
UPDATE lsp SET g = 999, d = date '1999-01-01' WHERE kind IN ('a', 'c') AND k = 4 AND id % 5 = 0;
DELETE FROM lsp WHERE kind = 'c' AND k = 3 AND id % 4 = 0;
INSERT INTO lsp (id, kind, k, g, d) VALUES (60000, 'a', 4, -999, date '1990-01-01');
SELECT lsp_check('SELECT g, d, count(*) AS n FROM lsp WHERE k IN (3, 4) GROUP BY g, d');
                                      lsp_check                                      
-------------------------------------------------------------------------------------
 store (g, d) over 4 partitions: store and heap, 194 rows, same as the ordinary plan
(1 row)

SELECT lsp_check('SELECT min(g), max(g), min(d), count(DISTINCT d) FROM lsp WHERE k IN (3, 4)');
                                     lsp_check                                     
-----------------------------------------------------------------------------------
 store (g, d) over 4 partitions: store and heap, 1 rows, same as the ordinary plan
(1 row)

ROLLBACK;
-- ... and after VACUUM every page is all-visible again.  INDEX_CLEANUP ON:
--     the rolled-back changes leave a page or two with a dead line pointer,
--     which VACUUM may otherwise leave to a later run, and those pages not
--     all-visible.
VACUUM (INDEX_CLEANUP ON) lsp;
SELECT lsp_check('SELECT g, count(*) AS n, sum(v), count(DISTINCT s) AS ds FROM lsp WHERE k < 10 GROUP BY g');
                                         lsp_check                                         
-------------------------------------------------------------------------------------------
 store (g, v, s) over 4 partitions: all from the store, 52 rows, same as the ordinary plan
(1 row)

SELECT lsp_check('SELECT count(*), count(DISTINCT s), sum(v), min(d), max(d) FROM lsp');
                                        lsp_check                                         
------------------------------------------------------------------------------------------
 store (s, v, d) over 4 partitions: all from the store, 1 rows, same as the ordinary plan
(1 row)

SELECT * FROM lsp_plan('SELECT g, count(*), sum(v) FROM lsp WHERE k < 5 GROUP BY g', true);
                    lsp_plan                     
-------------------------------------------------
 Custom Scan (LionCount)
   Partitions: lsp_a, lsp_b1, lsp_b2, lsp_c
   Lion Indexes: (k < 5)
   Group Key: g
   Store: g, v
   Store Rows, from the store and the heap: 4403
   Store Rows > 0: t, From Heap > 0: f
   Store Pages Absent > 0: f
   Store Groups: 31
   Store Batches > 1: f
   Store Disk Usage > 0: f
(11 rows)

-- 8. Run again: each probe of a correlated subquery counts every partition
--    afresh - one row, the groups of one, and one pruned to a partition.
SELECT * FROM lsp_plan($$SELECT x, (SELECT count(DISTINCT g) FROM lsp WHERE k = x) AS dg,
	   (SELECT sum(n) FROM (SELECT g, count(*) AS n FROM lsp WHERE k = x GROUP BY g) s) AS n,
	   (SELECT max(v) FROM lsp WHERE kind = 'c' AND k = x) AS mv
  FROM generate_series(1, 4) x ORDER BY x$$);
                            lsp_plan                             
-----------------------------------------------------------------
 Sort
   Sort Key: x.x
   ->  Function Scan on generate_series x
         SubPlan N
           ->  Custom Scan (LionCount)
                 Partitions: lsp_a, lsp_b1, lsp_b2, lsp_c
                 Lion Indexes: (k = x.x)
                 Store: g
         SubPlan N
           ->  Aggregate
                 ->  Custom Scan (LionCount)
                       Partitions: lsp_a, lsp_b1, lsp_b2, lsp_c
                       Lion Indexes: (k = x.x)
                       Group Key: g
                       Store: g
         SubPlan N
           ->  Custom Scan (LionCount)
                 Partitions: lsp_c
                 Lion Indexes: (k = x.x)
                 Implied by Partition Bounds: (kind = 'c'::text)
                 Store: v
(21 rows)

SELECT x, (SELECT count(DISTINCT g) FROM lsp WHERE k = x) AS dg,
	   (SELECT sum(n) FROM (SELECT g, count(*) AS n FROM lsp WHERE k = x GROUP BY g) s) AS n,
	   (SELECT max(v) FROM lsp WHERE kind = 'c' AND k = x) AS mv
  FROM generate_series(1, 4) x ORDER BY x;
 x | dg |  n  |        mv        
---+----+-----+------------------
 1 | 10 | 881 | 3588500000107655
 2 | 10 | 881 | 3588800000107664
 3 | 10 | 881 | 3589100000107673
 4 | 10 | 880 | 3589400000107682
(4 rows)

SET pg_lion.enable_count_pushdown = off;
SELECT x, (SELECT count(DISTINCT g) FROM lsp WHERE k = x) AS dg,
	   (SELECT sum(n) FROM (SELECT g, count(*) AS n FROM lsp WHERE k = x GROUP BY g) s) AS n,
	   (SELECT max(v) FROM lsp WHERE kind = 'c' AND k = x) AS mv
  FROM generate_series(1, 4) x ORDER BY x;
 x | dg |  n  |        mv        
---+----+-----+------------------
 1 | 10 | 881 | 3588500000107655
 2 | 10 | 881 | 3588800000107664
 3 | 10 | 881 | 3589100000107673
 4 | 10 | 880 | 3589400000107682
(4 rows)

RESET pg_lion.enable_count_pushdown;
-- 9. More groups than hash_mem holds: the node keeps every group until the
--    last partition has been counted, and those that do not fit go to batch
--    files, as a HashAggregate's do, read back once the others have gone out.
--    The groups are estimated per partition and summed, since a partitioned
--    parent is never auto-analyzed - here its own statistics say w has 10
--    values, its partitions' that it has 20000 - and the spill is priced
--    from that sum.
CREATE TABLE lspm (id int, k int, w int) PARTITION BY RANGE (id);
CREATE TABLE lspm1 PARTITION OF lspm FOR VALUES FROM (0) TO (10000)
	WITH (autovacuum_enabled = off);
CREATE TABLE lspm2 PARTITION OF lspm FOR VALUES FROM (10000) TO (20000)
	WITH (autovacuum_enabled = off);
INSERT INTO lspm SELECT i, i % 10, i % 10 FROM generate_series(0, 19999) i;
CREATE INDEX lspm_k ON lspm USING lion (k) INCLUDE (w);
VACUUM (FREEZE, ANALYZE) lspm;
UPDATE lspm SET w = id;
VACUUM (FREEZE, ANALYZE) lspm1;
VACUUM (FREEZE, ANALYZE) lspm2;
SELECT tablename, n_distinct FROM pg_stats
 WHERE tablename IN ('lspm', 'lspm1', 'lspm2') AND attname = 'w' ORDER BY 1;
 tablename | n_distinct 
-----------+------------
 lspm      |         10
 lspm1     |         -1
 lspm2     |         -1
(3 rows)

SET work_mem = 64;
SET hash_mem_multiplier = 1;
SELECT lsp_check('SELECT w, count(*) AS n FROM lspm GROUP BY w');
                                                 lsp_check                                                 
-----------------------------------------------------------------------------------------------------------
 store (w) over 2 partitions: all from the store, Store Batches > 1, 20000 rows, same as the ordinary plan
(1 row)

SELECT lsp_check('SELECT w, count(*) AS n FROM lspm WHERE k = 3 GROUP BY w');
                                                lsp_check                                                 
----------------------------------------------------------------------------------------------------------
 store (w) over 2 partitions: all from the store, Store Batches > 1, 2000 rows, same as the ordinary plan
(1 row)

SELECT * FROM lsp_plan('SELECT w, count(*) FROM lspm GROUP BY w', true);
                     lsp_plan                     
--------------------------------------------------
 Custom Scan (LionCount)
   Partitions: lspm1, lspm2
   Lion Indexes: (all rows)
   Group Key: w
   Store: w
   Store Rows, from the store and the heap: 20000
   Store Rows > 0: t, From Heap > 0: f
   Store Pages Absent > 0: f
   Store Groups: 20000
   Store Batches > 1: t
   Store Disk Usage > 0: t
(11 rows)

RESET work_mem;
RESET hash_mem_multiplier;
SELECT lsp_check('SELECT w, count(*) AS n FROM lspm GROUP BY w');
                                       lsp_check                                        
----------------------------------------------------------------------------------------
 store (w) over 2 partitions: all from the store, 20000 rows, same as the ordinary plan
(1 row)

SELECT lsp_check('SELECT w, count(*) AS n FROM lspm WHERE k = 3 GROUP BY w');
                                       lsp_check                                       
---------------------------------------------------------------------------------------
 store (w) over 2 partitions: all from the store, 2000 rows, same as the ordinary plan
(1 row)

DROP TABLE lsp, lspm;
DROP FUNCTION lsp_check(text), lsp_plan(text, boolean);
