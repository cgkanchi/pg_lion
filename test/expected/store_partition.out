-- The window store's gather over a partitioned table (DESIGN.md §40, "As
-- built: partitioned tables").
--
-- A partitioned parent whose every live leaf partition has a lion index
-- storing the gathered columns is counted a partition at a time, as §16
-- counts one: each partition's WHERE located in its own indexes, its rows
-- counted and their values gathered from its own index's store - or from its
-- heap, for a page that is not all-visible - into the node's one hash table,
-- whose groups come out when the last partition has been counted.  There is
-- no Finalize Agg above the node: count(DISTINCT) has no partial state to
-- hand one.  Partitions number their columns differently, so every column is
-- found again in each.  Every answer is checked against the pushdown off.
\set VERBOSITY terse
SET client_min_messages = warning;
LOAD 'pg_lion';
CREATE EXTENSION IF NOT EXISTS pg_lion;
RESET client_min_messages;
-- VACUUM can only set all-visible once the commit record is on disk
SET synchronous_commit = on;
SET max_parallel_workers_per_gather = 0;
/*
 * lsp_check() runs q with every other scan disabled, so that a LionCount path
 * that is built at all is the plan, under EXPLAIN ANALYZE and again for its
 * rows; then as an ordinary plan with the pushdown off, and proves the two
 * answers equal as multisets.  It says whether the node gathered from the
 * store (and which columns, over how many partitions), walked without it, or
 * was not used; whether an aggregate node sat above it; whether the gathered
 * rows came from the store, the heap or both; whether the node spilled past
 * hash_mem into more batches than one; and how many rows the query returned.
 */
CREATE FUNCTION lsp_check(q text) RETURNS text
LANGUAGE plpgsql AS $$
DECLARE
	ln text;
	used boolean := false;
	agg boolean := false;
	cols text := NULL;
	nparts int := 0;
	fromstore bigint := 0;
	fromheap bigint := 0;
	batches bigint := 0;
	nrows bigint;
	ndiff bigint;
BEGIN
	PERFORM set_config('enable_seqscan', 'off', true);
	PERFORM set_config('enable_bitmapscan', 'off', true);
	PERFORM set_config('enable_indexscan', 'off', true);
	PERFORM set_config('enable_indexonlyscan', 'off', true);
	PERFORM set_config('pg_lion.enable_count_pushdown', 'on', true);
	/* the row gather would feed an ordinary Agg; store_gather.sql tests it */
	PERFORM set_config('pg_lion.enable_store_scan', 'off', true);
	FOR ln IN EXECUTE 'EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF) ' || q LOOP
		IF ln ~ 'Custom Scan \(LionCount\)' THEN
			used := true;
		ELSIF ln ~ 'Aggregate' THEN
			agg := true;
		ELSIF ln ~ '^\s*Partitions: ' THEN
			nparts := array_length(string_to_array(substring(ln FROM 'Partitions: (.*)$'), ', '), 1);
		ELSIF ln ~ '^\s*Store: ' THEN
			cols := substring(ln FROM 'Store: (.*)$');
		ELSIF ln ~ 'Store Rows From Heap: ' THEN
			fromheap := fromheap + substring(ln FROM 'Store Rows From Heap: (\d+)')::bigint;
		ELSIF ln ~ 'Store Rows: ' THEN
			fromstore := fromstore + substring(ln FROM 'Store Rows: (\d+)')::bigint;
		ELSIF ln ~ 'Store Batches: ' THEN
			batches := batches + substring(ln FROM 'Store Batches: (\d+)')::bigint;
		END IF;
	END LOOP;
	EXECUTE format('CREATE TEMP TABLE lsp_on AS SELECT s::text AS r FROM (%s) s', q);
	PERFORM set_config('enable_seqscan', 'on', true);
	PERFORM set_config('enable_bitmapscan', 'on', true);
	PERFORM set_config('enable_indexscan', 'on', true);
	PERFORM set_config('enable_indexonlyscan', 'on', true);
	PERFORM set_config('pg_lion.enable_count_pushdown', 'off', true);
	EXECUTE format('CREATE TEMP TABLE lsp_off AS SELECT s::text AS r FROM (%s) s', q);
	PERFORM set_config('pg_lion.enable_count_pushdown', 'on', true);
	SELECT count(*) INTO nrows FROM lsp_on;
	SELECT (SELECT count(*) FROM (TABLE lsp_on EXCEPT ALL TABLE lsp_off) x) +
		   (SELECT count(*) FROM (TABLE lsp_off EXCEPT ALL TABLE lsp_on) y)
	  INTO ndiff;
	DROP TABLE lsp_on;
	DROP TABLE lsp_off;
	RETURN format('%s, %s rows, %s',
				  CASE WHEN cols IS NOT NULL THEN
					   format('store (%s) over %s partition%s%s: %s%s', cols, nparts,
							  CASE WHEN nparts = 1 THEN '' ELSE 's' END,
							  CASE WHEN agg THEN ' under an Agg' ELSE '' END,
							  CASE WHEN fromstore > 0 AND fromheap > 0 THEN 'store and heap'
								   WHEN fromstore > 0 THEN 'all from the store'
								   WHEN fromheap > 0 THEN 'all from the heap'
								   ELSE 'nothing gathered' END,
							  CASE WHEN batches > 1 THEN ', Store Batches > 1' ELSE '' END)
					   WHEN used THEN 'walk'
					   ELSE 'no pushdown' END,
				  nrows,
				  CASE WHEN ndiff = 0 THEN 'same as the ordinary plan'
					   ELSE format('DIFFERENT in %s rows', ndiff) END);
END $$;
/*
 * lsp_plan() prints the plan of q, with every other scan disabled as
 * lsp_check() runs it, and under `actual` what it did, without what differs
 * between majors or with the heap's page layout: the actual row counts (18
 * prints them with decimals), a subplan's name (19 names it expr_1 where 18
 * numbered it), and the node's counters but its groups.  How many of the
 * rows gathered came from the store and how many from the heap depends on
 * the layout too, so their total is printed, which is the rows counted, and
 * only whether each part is empty; and of the spill only whether it took
 * more batches than one, and disk.
 */
CREATE FUNCTION lsp_plan(q text, actual boolean DEFAULT false) RETURNS SETOF text
LANGUAGE plpgsql AS $$
DECLARE
	ln text;
	fromstore bigint := 0;
	fromheap bigint;
	indent text;
BEGIN
	PERFORM set_config('enable_seqscan', 'off', true);
	PERFORM set_config('enable_bitmapscan', 'off', true);
	PERFORM set_config('enable_indexscan', 'off', true);
	PERFORM set_config('enable_indexonlyscan', 'off', true);
	/* the row gather would feed an ordinary Agg; store_gather.sql tests it */
	PERFORM set_config('pg_lion.enable_store_scan', 'off', true);
	FOR ln IN EXECUTE CASE WHEN actual THEN
			'EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF) '
			ELSE 'EXPLAIN (COSTS OFF) ' END || q LOOP
		ln := regexp_replace(ln, '\s*\(actual rows=[^)]*\)', '');
		ln := regexp_replace(ln, 'SubPlan \S+', 'SubPlan N');
		indent := substring(ln FROM '^(\s*)');
		IF ln ~ '^\s*Store Rows: ' THEN
			fromstore := substring(ln FROM ': (\d+)$')::bigint;
		ELSIF ln ~ '^\s*Store Rows From Heap: ' THEN
			fromheap := substring(ln FROM ': (\d+)$')::bigint;
			RETURN NEXT format('%sStore Rows, from the store and the heap: %s',
							   indent, fromstore + fromheap);
			RETURN NEXT format('%sStore Rows > 0: %s, From Heap > 0: %s',
							   indent, fromstore > 0, fromheap > 0);
		ELSIF ln ~ '^\s*Store Pages Absent: ' THEN
			RETURN NEXT format('%sStore Pages Absent > 0: %s', indent,
							   substring(ln FROM ': (\d+)$')::bigint > 0);
		ELSIF ln ~ '^\s*Store Batches: ' THEN
			RETURN NEXT format('%sStore Batches > 1: %s', indent,
							   substring(ln FROM ': (\d+)$')::bigint > 1);
		ELSIF ln ~ '^\s*Store Disk Usage: ' THEN
			RETURN NEXT format('%sStore Disk Usage > 0: %s', indent,
							   substring(ln FROM ': (\d+) kB$')::bigint > 0);
		ELSIF actual AND ln !~ '^\s*(Store Groups|Rows Removed by Filter): ' AND
			  (ln ~ '^\s*[A-Z][A-Za-z ]*: \d+$' OR ln ~ '^\s*Range Evaluation: ') THEN
			NULL;				-- a counter of the node's, which the layout decides
		ELSE
			RETURN NEXT ln;
		END IF;
	END LOOP;
	PERFORM set_config('enable_seqscan', 'on', true);
	PERFORM set_config('enable_bitmapscan', 'on', true);
	PERFORM set_config('enable_indexscan', 'on', true);
	PERFORM set_config('enable_indexonlyscan', 'on', true);
END $$;
-- ---- the table -----------------------------------------------------------
/*
 * LIST-partitioned by kind, which no lion index covers.  lsp_a is created
 * with a column it then drops, so its attnos are the parent's plus one; lsp_b
 * is sub-partitioned by a range of id; lsp_c has its columns in another order
 * altogether.  The other columns are no function of kind - a row's kind is
 * i % 3, the others are of i / 3 - so every group, the NULL group of g
 * included, has rows in every partition.  v's sums pass int8's range.
 */
CREATE TABLE lsp (id int NOT NULL, kind text NOT NULL, k int4, g int4,
				  v int8, i2 int2, s text, d date)
	PARTITION BY LIST (kind);
CREATE TABLE lsp_a (junk int, id int NOT NULL, kind text NOT NULL, k int4,
					g int4, v int8, i2 int2, s text, d date)
	WITH (autovacuum_enabled = off);
ALTER TABLE lsp_a DROP COLUMN junk;
ALTER TABLE lsp ATTACH PARTITION lsp_a FOR VALUES IN ('a');
CREATE TABLE lsp_b PARTITION OF lsp FOR VALUES IN ('b')
	PARTITION BY RANGE (id);
CREATE TABLE lsp_b1 PARTITION OF lsp_b FOR VALUES FROM (MINVALUE) TO (20000)
	WITH (autovacuum_enabled = off);
CREATE TABLE lsp_b2 PARTITION OF lsp_b FOR VALUES FROM (20000) TO (MAXVALUE)
	WITH (autovacuum_enabled = off);
CREATE TABLE lsp_c (d date, s text, v int8, g int4, k int4, i2 int2,
					kind text NOT NULL, id int NOT NULL)
	WITH (autovacuum_enabled = off);
ALTER TABLE lsp ATTACH PARTITION lsp_c FOR VALUES IN ('c');
INSERT INTO lsp (id, kind, k, g, v, i2, s, d)
SELECT i, (ARRAY['a', 'b', 'c'])[1 + i % 3], (i / 3) % 40,
	   CASE WHEN i % 17 = 0 THEN NULL ELSE (i / 3) % 50 END,
	   CASE WHEN i % 23 = 0 THEN NULL ELSE i::int8 * 100000000003 END,
	   CASE WHEN i % 19 = 0 THEN NULL ELSE ((i / 3) % 300 - 150)::int2 END,
	   CASE WHEN i % 29 = 0 THEN NULL ELSE 's' || ((i / 3) % 45) END,
	   date '2024-01-01' + (i / 3) % 90
  FROM generate_series(1, 36000) i;
/*
 * One lion index per leaf, each on the leaf's own column numbers, storing
 * the other columns; lsp_c's in another order, and lsp_c has a second lion
 * index that stores g alone, which a gather of g alone reads there rather
 * than the wider one (the one storing fewest), while k's clause is answered
 * by the first.
 */
CREATE INDEX lsp_a_k ON lsp_a USING lion (k) INCLUDE (g, v, i2, s, d);
CREATE INDEX lsp_b1_k ON lsp_b1 USING lion (k) INCLUDE (g, v, i2, s, d);
CREATE INDEX lsp_b2_k ON lsp_b2 USING lion (k) INCLUDE (g, v, i2, s, d);
CREATE INDEX lsp_c_k ON lsp_c USING lion (k) INCLUDE (d, s, i2, v, g);
CREATE INDEX lsp_c_id ON lsp_c USING lion (id) INCLUDE (g);
VACUUM (FREEZE, ANALYZE) lsp;
-- the attnos really do differ between the partitions
SELECT c.relname, a.attname, a.attnum
  FROM pg_class c JOIN pg_attribute a ON a.attrelid = c.oid
 WHERE c.relname IN ('lsp', 'lsp_a', 'lsp_c') AND a.attname IN ('k', 'g', 'v')
 ORDER BY c.relname, a.attnum;
 relname | attname | attnum 
---------+---------+--------
 lsp     | k       |      3
 lsp     | g       |      4
 lsp     | v       |      5
 lsp_a   | k       |      4
 lsp_a   | g       |      5
 lsp_a   | v       |      6
 lsp_c   | v       |      3
 lsp_c   | g       |      4
 lsp_c   | k       |      5
(9 rows)

-- ... and every group of g has rows in every partition
SELECT count(*) AS groups, min(kinds) AS min_kinds, bool_or(g IS NULL) AS null_group
  FROM (SELECT g, count(DISTINCT kind) AS kinds FROM lsp GROUP BY g) x;
 groups | min_kinds | null_group 
--------+-----------+------------
     51 |         3 | t
(1 row)

-- 1. The plans: one LionCount node over the partitions, its Store line, and
--    nothing above it - the groups are the node's own, the HAVING too.
SELECT * FROM lsp_plan('SELECT g, count(*), sum(v) FROM lsp WHERE k < 5 GROUP BY g');
                  lsp_plan                  
--------------------------------------------
 Custom Scan (LionCount)
   Partitions: lsp_a, lsp_b1, lsp_b2, lsp_c
   Lion Indexes: (k < 5)
   Group Key: g
   Store: g, v
(5 rows)

SELECT * FROM lsp_plan('SELECT count(DISTINCT s), min(d), max(i2) FROM lsp');
                  lsp_plan                  
--------------------------------------------
 Custom Scan (LionCount)
   Partitions: lsp_a, lsp_b1, lsp_b2, lsp_c
   Lion Indexes: (all rows)
   Store: s, d, i2
(4 rows)

SELECT * FROM lsp_plan('SELECT g, i2, count(DISTINCT s) FROM lsp WHERE k IN (1, 2) GROUP BY g, i2');
                    lsp_plan                    
------------------------------------------------
 Custom Scan (LionCount)
   Partitions: lsp_a, lsp_b1, lsp_b2, lsp_c
   Lion Indexes: (k = ANY ('{1,2}'::integer[]))
   Group Key: g, i2
   Store: g, i2, s
(5 rows)

SELECT * FROM lsp_plan('SELECT g, count(*) FROM lsp WHERE k < 5 GROUP BY g HAVING count(*) > 100');
                  lsp_plan                  
--------------------------------------------
 Custom Scan (LionCount)
   Filter: ((count(*)) > 100)
   Partitions: lsp_a, lsp_b1, lsp_b2, lsp_c
   Lion Indexes: (k < 5)
   Group Key: g
   Store: g
(6 rows)

-- ... and under ANALYZE, the totals over every partition: the rows counted,
--     where they came from, and the groups formed.
SELECT * FROM lsp_plan('SELECT g, count(*), sum(v) FROM lsp WHERE k < 5 GROUP BY g', true);
                    lsp_plan                     
-------------------------------------------------
 Custom Scan (LionCount)
   Partitions: lsp_a, lsp_b1, lsp_b2, lsp_c
   Lion Indexes: (k < 5)
   Group Key: g
   Store: g, v
   Store Rows, from the store and the heap: 4500
   Store Rows > 0: t, From Heap > 0: f
   Store Pages Absent > 0: f
   Store Groups: 26
   Store Batches > 1: f
   Store Disk Usage > 0: f
(11 rows)

SELECT * FROM lsp_plan('SELECT count(DISTINCT s), sum(i2) FROM lsp', true);
                     lsp_plan                     
--------------------------------------------------
 Custom Scan (LionCount)
   Partitions: lsp_a, lsp_b1, lsp_b2, lsp_c
   Lion Indexes: (all rows)
   Store: s, i2
   Store Rows, from the store and the heap: 36000
   Store Rows > 0: t, From Heap > 0: f
   Store Pages Absent > 0: f
   Store Groups: 1
   Store Batches > 1: f
   Store Disk Usage > 0: f
(10 rows)

SELECT count(*) AS rows_counted FROM lsp WHERE k < 5;
 rows_counted 
--------------
         4500
(1 row)

-- 2. GROUP BY a stored column with every aggregate, groups and the NULL
--    group spanning the partitions; two columns; count(DISTINCT) beside them.
SELECT lsp_check('SELECT g, count(*) AS n, count(i2) AS n2, sum(v), avg(i2), min(s), max(d), count(DISTINCT s) AS ds FROM lsp WHERE k < 10 GROUP BY g');
                                            lsp_check                                             
--------------------------------------------------------------------------------------------------
 store (g, i2, v, s, d) over 4 partitions: all from the store, 51 rows, same as the ordinary plan
(1 row)

SELECT lsp_check('SELECT i2, count(*) AS n, sum(v), avg(v), min(d), max(g) FROM lsp WHERE k = 7 GROUP BY i2');
                                           lsp_check                                           
-----------------------------------------------------------------------------------------------
 store (i2, v, d, g) over 4 partitions: all from the store, 16 rows, same as the ordinary plan
(1 row)

SELECT lsp_check('SELECT g, d, count(*) AS n, sum(i2), count(DISTINCT s) AS ds FROM lsp WHERE k IN (1, 2, 3) GROUP BY g, d');
                                           lsp_check                                            
------------------------------------------------------------------------------------------------
 store (g, d, i2, s) over 4 partitions: all from the store, 162 rows, same as the ordinary plan
(1 row)

SELECT lsp_check('SELECT s, count(*) AS n, count(DISTINCT g) AS dg, count(DISTINCT d) AS dd FROM lsp WHERE k > 30 GROUP BY s');
                                         lsp_check                                         
-------------------------------------------------------------------------------------------
 store (s, g, d) over 4 partitions: all from the store, 46 rows, same as the ordinary plan
(1 row)

SELECT lsp_check('SELECT g, count(*) AS n FROM lsp WHERE k < 10 GROUP BY g HAVING count(*) > 169');
                                      lsp_check                                      
-------------------------------------------------------------------------------------
 store (g) over 4 partitions: all from the store, 24 rows, same as the ordinary plan
(1 row)

SELECT g, count(*), sum(v), count(DISTINCT s) AS ds
  FROM lsp WHERE k < 10 GROUP BY g ORDER BY g NULLS FIRST LIMIT 3;
 g | count |        sum         | ds 
---+-------+--------------------+----
   |   527 | 911451600027343548 | 45
 0 |   170 | 290116200008703486 |  9
 1 |   170 | 284164800008524944 |  9
(3 rows)

SET pg_lion.enable_count_pushdown = off;
SELECT g, count(*), sum(v), count(DISTINCT s) AS ds
  FROM lsp WHERE k < 10 GROUP BY g ORDER BY g NULLS FIRST LIMIT 3;
 g | count |        sum         | ds 
---+-------+--------------------+----
   |   527 | 911451600027343548 | 45
 0 |   170 | 290116200008703486 |  9
 1 |   170 | 284164800008524944 |  9
(3 rows)

RESET pg_lion.enable_count_pushdown;
-- ... a column the WHERE pins, printed from each partition's entry
SELECT lsp_check('SELECT k, count(*) AS n, count(DISTINCT g) AS dg, sum(v) FROM lsp WHERE k = 3 GROUP BY k');
                                       lsp_check                                       
---------------------------------------------------------------------------------------
 store (g, v) over 4 partitions: all from the store, 1 rows, same as the ordinary plan
(1 row)

-- ... gathering g alone reads it from lsp_c's narrower index there, the one
--     storing fewest columns, beside lsp_c_k, whose entries answer k; with v
--     as well, from lsp_c_k's store
SELECT lsp_check('SELECT g, count(*) AS n FROM lsp WHERE k < 10 GROUP BY g');
                                      lsp_check                                      
-------------------------------------------------------------------------------------
 store (g) over 4 partitions: all from the store, 51 rows, same as the ordinary plan
(1 row)

SELECT lsp_check('SELECT count(DISTINCT g) FROM lsp WHERE k = 3');
                                     lsp_check                                      
------------------------------------------------------------------------------------
 store (g) over 4 partitions: all from the store, 1 rows, same as the ordinary plan
(1 row)

SET enable_seqscan = off;
SET enable_bitmapscan = off;
SET enable_indexscan = off;
SET enable_indexonlyscan = off;
-- (the row gather's planning reads the meta page of every store it could
-- take g from, lsp_c_id's among them: the reads counted are the pushdown's)
SET pg_lion.enable_store_scan = off;
SELECT pg_stat_force_next_flush();
 pg_stat_force_next_flush 
--------------------------
 
(1 row)

SELECT idx_blks_hit + idx_blks_read AS c_id_reads
  FROM pg_statio_user_indexes WHERE indexrelname = 'lsp_c_id' \gset
SELECT g, count(*) FROM lsp WHERE k < 10 GROUP BY g ORDER BY g LIMIT 2;
 g | count 
---+-------
 0 |   170
 1 |   170
(2 rows)

SELECT pg_stat_force_next_flush();
 pg_stat_force_next_flush 
--------------------------
 
(1 row)

SELECT idx_blks_hit + idx_blks_read > :c_id_reads AS lsp_c_id_read
  FROM pg_statio_user_indexes WHERE indexrelname = 'lsp_c_id';
 lsp_c_id_read 
---------------
 t
(1 row)

SELECT idx_blks_hit + idx_blks_read AS c_id_reads
  FROM pg_statio_user_indexes WHERE indexrelname = 'lsp_c_id' \gset
SELECT g, count(*), sum(v) FROM lsp WHERE k < 10 GROUP BY g ORDER BY g LIMIT 2;
 g | count |        sum         
---+-------+--------------------
 0 |   170 | 290116200008703486
 1 |   170 | 284164800008524944
(2 rows)

SELECT pg_stat_force_next_flush();
 pg_stat_force_next_flush 
--------------------------
 
(1 row)

SELECT idx_blks_hit + idx_blks_read > :c_id_reads AS lsp_c_id_read
  FROM pg_statio_user_indexes WHERE indexrelname = 'lsp_c_id';
 lsp_c_id_read 
---------------
