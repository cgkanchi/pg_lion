(1 row)

RESET pg_lion.enable_store_scan;
RESET enable_seqscan;
RESET enable_bitmapscan;
RESET enable_indexscan;
RESET enable_indexonlyscan;
-- 3. No GROUP BY: the one row, over every partition.  No WHERE: the sum over
--    every row of each partition.  Nothing matching: one row without a GROUP
--    BY, none with one.
SELECT lsp_check('SELECT count(*), count(v), sum(v), avg(i2), min(d), max(s), count(DISTINCT g) FROM lsp WHERE k BETWEEN 5 AND 9');
                                            lsp_check                                            
