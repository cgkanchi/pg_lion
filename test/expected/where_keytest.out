SET enable_seqscan = off;
SET enable_bitmapscan = off;
SET pg_lion.enable_plain_scan = off;
SET pg_lion.enable_ordered_scan = off;
EXPLAIN (COSTS OFF) SELECT count(*) FROM lion_kt WHERE lower(s) = 's1';
                     QUERY PLAN                      
-----------------------------------------------------
 Custom Scan (LionCount)
   Lion Indexes: lion_kt_s ((lower(s) = 's1'::text))
(2 rows)

EXPLAIN (COSTS OFF) SELECT count(*) FROM lion_kt WHERE c LIKE 'c1%' AND s = 's3';
                                 QUERY PLAN                                 
----------------------------------------------------------------------------
 Custom Scan (LionCount)
   Lion Indexes: lion_kt_c ((c ~~ 'c1%'::text)), lion_kt_s (s = 's3'::text)
(2 rows)

EXPLAIN (COSTS OFF) SELECT s, count(*) FROM lion_kt WHERE c ~ '^c[12]$' GROUP BY 1;
                            QUERY PLAN                            
------------------------------------------------------------------
 Custom Scan (LionCount)
   Lion Indexes: lion_kt_s (s), lion_kt_c ((c ~ '^c[12]$'::text))
   Group Key: s
(3 rows)

CREATE FUNCTION lion_kt_explain(q text) RETURNS SETOF text
LANGUAGE plpgsql AS $$
DECLARE
	l text;
BEGIN
	FOR l IN EXECUTE 'EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF) ' || q LOOP
		-- 18 prints rows=N.00 where 16 and 17 print rows=N
		RETURN NEXT regexp_replace(l, 'rows=(\d+)\.00 ', 'rows=\1 ', 'g');
	END LOOP;
END $$;
SELECT lion_kt_explain('SELECT count(*) FROM lion_kt WHERE c ILIKE ''C1%''');
                 lion_kt_explain                 
-------------------------------------------------
 Custom Scan (LionCount) (actual rows=1 loops=1)
   Lion Indexes: lion_kt_c ((c ~~* 'C1%'::text))
   Heap Blocks Skipped via VM: 0
   Heap TIDs Rechecked: 4998
   Heap Blocks Rechecked: 69
   Containers Visited: 34
   Probes Avoided: 0
   Heap Blocks From Cache: 425
   Heap Blocks Past Cache Budget: 0
   Posting Sets Summed: 12
   Directory Pages Read: 3
   Keys Tested: 21
   Keys Passed: 12
(13 rows)

RESET enable_seqscan;
RESET enable_bitmapscan;
RESET pg_lion.enable_plain_scan;
RESET pg_lion.enable_ordered_scan;
DROP TABLE lion_kt, lion_ktp, lion_ktl;
DROP FUNCTION lion_kt(text), lion_kt_prep(text, text), lion_kt_explain(text);
