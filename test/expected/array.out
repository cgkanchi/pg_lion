-- `<@` needs every row rechecked, so it is never pushed down
SELECT rbi_arrplan($$SELECT count(*) FROM rbi_arr WHERE tags <@ '{t5,t7}'$$);
                      rbi_arrplan                      
-------------------------------------------------------
 Aggregate
   ->  Bitmap Heap Scan on rbi_arr
         Recheck Cond: (tags <@ '{t5,t7}'::text[])
         ->  Bitmap Index Scan on rbi_arr_tags
               Index Cond: (tags <@ '{t5,t7}'::text[])
(5 rows)

