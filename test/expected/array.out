-- `<@` needs every row rechecked, so it is never pushed down
SELECT lion_arrplan($$SELECT count(*) FROM lion_arr WHERE tags <@ '{t5,t7}'$$);
                     lion_arrplan                      
-------------------------------------------------------
 Aggregate
   ->  Bitmap Heap Scan on lion_arr
         Recheck Cond: (tags <@ '{t5,t7}'::text[])
         ->  Bitmap Index Scan on lion_arr_tags
               Index Cond: (tags <@ '{t5,t7}'::text[])
(5 rows)

