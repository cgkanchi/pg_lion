-----------
 ok 1 rows
(1 row)

DROP TABLE rbi_ins, rbi_spill, rbi_dense, rbi_mid, rbi_inlmid, rbi_slack,
		   rbi_grow, rbi_relt;
DROP FUNCTION rbi_ins_check(text);
