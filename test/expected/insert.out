-- An explicit bucket count is never warned about: it is what its owner asked
-- for (rbi_spill_k above has buckets = 1 and 97 keys and says nothing).
CREATE INDEX rbi_grow_x ON rbi_grow USING roaring (k) WITH (buckets = 4);
INSERT INTO rbi_grow VALUES (80001, 80001);
SELECT nbuckets, max_bucket_pages > 4 AS outgrown
  FROM roaring_index_stats('rbi_grow_x');
 nbuckets | outgrown 
----------+----------
        4 | t
(1 row)

DROP INDEX rbi_grow_x;
/*
 * ambuild sizes the directory for the heap it is told about: when
 * pg_class.reltuples says the table holds more rows than the build put in the
 * index, the estimate is scaled up by that ratio (DESIGN.md section 5), and a
 * partial index is sized for the rows its predicate selects instead.
 */
CREATE TABLE rbi_relt (i int4, k int4);
INSERT INTO rbi_relt SELECT i, i FROM generate_series(1, 40000) i;
ANALYZE rbi_relt;
DELETE FROM rbi_relt WHERE i > 4000;
CREATE INDEX rbi_relt_k ON rbi_relt USING roaring (k);
CREATE INDEX rbi_relt_p ON rbi_relt USING roaring (k) WHERE i <= 2000;
SELECT (SELECT nbuckets FROM roaring_index_stats('rbi_relt_k')) >
	   (SELECT nbuckets FROM roaring_index_stats('rbi_relt_p'))
	   AS whole_table_sized_larger;
 whole_table_sized_larger 
--------------------------
 t
(1 row)

CREATE TEMP TABLE rbi_relt_before AS
	SELECT nbuckets FROM roaring_index_stats('rbi_relt_k');
-- once the statistics tell the truth, the same data wants a smaller directory
VACUUM (ANALYZE) rbi_relt;
REINDEX INDEX rbi_relt_k;
SELECT (SELECT nbuckets FROM roaring_index_stats('rbi_relt_k')) <
	   (SELECT nbuckets FROM rbi_relt_before) AS directory_shrank;
 directory_shrank 
------------------
 t
(1 row)

SELECT roaring_index_verify('rbi_relt_k', true);
 roaring_index_verify 
----------------------
 
(1 row)

SELECT roaring_index_verify('rbi_relt_p', true);
 roaring_index_verify 
----------------------
 
(1 row)

SELECT rbi_cmp('rbi_relt', 'k = 1234');
