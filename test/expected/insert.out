	SELECT container_bytes, container_pages FROM roaring_index_stats('rbi_slack_k');
INSERT INTO rbi_slack SELECT i, i % 20 FROM generate_series(20001, 22000) i;
SELECT ntids, slack_bytes > 0 AS has_slack,
	   slack_bytes <= 72 * (containers + sparse_segments) AS slack_within_bound
  FROM roaring_index_stats('rbi_slack_k');
 ntids | has_slack | slack_within_bound 
-------+-----------+--------------------
