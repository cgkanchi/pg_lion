(1 row)

SELECT lion_wj('SELECT d.grp, count(DISTINCT d.attr) FROM lion_kod d WHERE EXISTS (SELECT 1 FROM lion_kof f WHERE f.fk = d.pk AND f.t = ''t2'') GROUP BY d.grp');
              lion_wj              
-----------------------------------
