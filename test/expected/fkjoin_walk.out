-- ---- 3. what the walk read -------------------------------------------------------
-- every dimension key is looked up; 260 of them find no entry, the ten past
-- the fact's range among them
SELECT lion_wj_counter('SELECT count(*) FROM lion_kof f JOIN lion_kod d ON f.fk = d.pk', 'Join Keys Looked Up') AS looked_up,
	   lion_wj_counter('SELECT count(*) FROM lion_kof f JOIN lion_kod d ON f.fk = d.pk', 'Join Keys Without Entry') AS without_entry,
	   lion_wj_counter('SELECT count(*) FROM lion_kof f JOIN lion_kod d ON f.fk = d.pk', 'Join Key Batches') AS batches;
 looked_up | without_entry | batches 
-----------+---------------+---------
      4000 |           260 |       1
(1 row)

-- 5850 rows with a key, 2925 distinct: a duplicated key is looked up once
SELECT lion_wj_counter('SELECT count(*) FROM lion_kodn d WHERE NOT EXISTS (SELECT 1 FROM lion_kof f WHERE f.fk = d.k)', 'Join Keys Looked Up') AS looked_up,
	   lion_wj_counter('SELECT count(*) FROM lion_kof f WHERE EXISTS (SELECT 1 FROM lion_kodn d WHERE d.k = f.fk)', 'Join Keys Looked Up') AS distinct_keys;
 looked_up | distinct_keys 
-----------+---------------
      5850 |          2925
(1 row)

-- few of the keys have a row the filter leaves: the walk stays on each leaf
-- from one key to the next and reads fewer directory pages than there are
-- keys, where a descent per key reads three a key
SELECT lion_wj_counter('SELECT count(*) FROM lion_kod d WHERE EXISTS (SELECT 1 FROM lion_kof f WHERE f.fk = d.pk AND f.x = 3 AND f.t = ''t3'')', 'Directory Pages Read')
	< lion_wj_counter('SELECT count(*) FROM lion_kod d WHERE EXISTS (SELECT 1 FROM lion_kof f WHERE f.fk = d.pk AND f.x = 3 AND f.t = ''t3'')', 'Join Keys Looked Up') AS fewer_pages_than_keys;
 fewer_pages_than_keys 
-----------------------
 t
(1 row)

SELECT lion_wj_counter('SELECT count(*) FROM lion_kof f JOIN lion_kod d ON f.fk = d.pk WHERE d.region = ''eu'' AND d.grp = ''g1'' AND d.attr = 2', 'Directory Pages Read')
	>= 3 * lion_wj_counter('SELECT count(*) FROM lion_kof f JOIN lion_kod d ON f.fk = d.pk WHERE d.region = ''eu'' AND d.grp = ''g1'' AND d.attr = 2', 'Join Keys Looked Up') AS a_descent_a_key;
 a_descent_a_key 
-----------------
 t
(1 row)

-- a fact filter that is one range, collected into memory on its own (§32),
-- is what the join copies as its fact filters: one source of one set, which
-- the collection used to refuse as a collected set counted on its own.  The
-- copy is forced: a count that probes a set in memory is priced below one
-- against the copy (DESIGN.md §27, "The per-key terms, refitted").
SET pg_lion.fkjoin_count_cost = 1e6;
SELECT lion_wj_counter('SELECT count(*) FROM lion_kod d WHERE EXISTS (SELECT 1 FROM lion_kof f WHERE f.fk = d.pk AND f.x < 5)', 'Range Sources Collected') AS range_collected,
	   lion_wj_counter('SELECT count(*) FROM lion_kod d WHERE EXISTS (SELECT 1 FROM lion_kof f WHERE f.fk = d.pk AND f.x < 5)', 'Fact Filter Rows Collected') AS rows_copied,
	   lion_wj_counter('SELECT count(*) FROM lion_kod d WHERE EXISTS (SELECT 1 FROM lion_kof f WHERE f.fk = d.pk AND f.x < 5)', 'Join Keys Without Entry') AS without_entry;
 range_collected | rows_copied | without_entry 
-----------------+-------------+---------------
               1 |       12000 |           260
(1 row)

RESET pg_lion.fkjoin_count_cost;
-- a batch is what work_mem holds: at 256 kB the keys come in more than one
SET work_mem = '256kB';
SELECT lion_wj('SELECT d.attr, count(*) FROM lion_kof f JOIN lion_kod d ON f.fk = d.pk WHERE f.x < 8 GROUP BY d.attr');
              lion_wj              
-----------------------------------
 pushed down, in key order, 8 rows
(1 row)

SELECT lion_wj('SELECT count(*) FROM lion_kod d WHERE NOT EXISTS (SELECT 1 FROM lion_kof f WHERE f.fk = d.pk AND f.t = ''t6'')');
              lion_wj              
-----------------------------------
 pushed down, in key order, 1 rows
(1 row)

SELECT lion_wj_counter('SELECT d.attr, count(*) FROM lion_kof f JOIN lion_kod d ON f.fk = d.pk WHERE f.x < 8 GROUP BY d.attr', 'Join Key Batches') > 1 AS several_batches;
 several_batches 
-----------------
 t
(1 row)

RESET work_mem;
-- ---- 4. rescans and generic plans ---------------------------------------------------
-- a correlated subquery rescans the node - its batches and its walk - with a
-- new fact filter per outer row
SELECT lion_wj('SELECT g, (SELECT count(*) FROM lion_kof f JOIN lion_kod d ON f.fk = d.pk WHERE f.x = g.g) FROM generate_series(0, 4) g');
              lion_wj              
-----------------------------------
 pushed down, in key order, 5 rows
(1 row)

SELECT lion_wj('SELECT g, (SELECT count(*) FROM lion_kod d WHERE EXISTS (SELECT 1 FROM lion_kof f WHERE f.fk = d.pk AND f.x = g.g)) FROM generate_series(0, 10) g');
              lion_wj               
------------------------------------
 pushed down, in key order, 11 rows
(1 row)

SELECT lion_wj_prep('SELECT d.attr, count(*) FROM lion_kof f JOIN lion_kod d ON f.fk = d.pk WHERE f.x = $1 GROUP BY d.attr', '5');
           lion_wj_prep            
-----------------------------------
 pushed down, in key order, 8 rows
(1 row)

SELECT lion_wj_prep('SELECT count(*) FROM lion_kof f WHERE f.t = $1 AND EXISTS (SELECT 1 FROM lion_kodn d WHERE d.k = f.fk)', '''t5''');
           lion_wj_prep            
-----------------------------------
 pushed down, in key order, 1 rows
(1 row)

SELECT lion_wj_prep('SELECT count(*) FROM lion_kod d WHERE EXISTS (SELECT 1 FROM lion_kof f WHERE f.fk = d.pk AND f.x = $1)', 'NULL');
           lion_wj_prep            
-----------------------------------
 pushed down, in key order, 1 rows
(1 row)

-- ---- 5. parallel plans -------------------------------------------------------------
-- each participant sorts and walks the share of the keys it gets
SET parallel_setup_cost = 0;
SET parallel_tuple_cost = 0;
SET min_parallel_table_scan_size = 0;
SET min_parallel_index_scan_size = 0;
SET parallel_leader_participation = off;
ALTER TABLE lion_kod SET (parallel_workers = 2);
ALTER TABLE lion_kodn SET (parallel_workers = 2);
SELECT lion_wj_par('SELECT d.attr, count(*) FROM lion_kof f JOIN lion_kod d ON f.fk = d.pk GROUP BY d.attr');
          lion_wj_par           
--------------------------------
 parallel, in key order, 8 rows
(1 row)

SELECT lion_wj_par('SELECT count(*) FROM lion_kod d WHERE EXISTS (SELECT 1 FROM lion_kof f WHERE f.fk = d.pk AND f.x = 3)');
          lion_wj_par           
--------------------------------
 parallel, in key order, 1 rows
(1 row)

SELECT lion_wj_par('SELECT d.region, count(*) FROM lion_kod d WHERE NOT EXISTS (SELECT 1 FROM lion_kof f WHERE f.fk = d.pk AND f.t = ''t2'') GROUP BY d.region');
          lion_wj_par           
--------------------------------
 parallel, in key order, 3 rows
(1 row)

SELECT lion_wj_par('SELECT count(DISTINCT f.fk) FROM lion_kof f JOIN lion_kod d ON f.fk = d.pk WHERE f.x IN (2, 4)');
          lion_wj_par           
--------------------------------
 parallel, in key order, 1 rows
(1 row)

SELECT lion_wj_par('SELECT count(*) FROM lion_kof f WHERE f.x = 6 AND EXISTS (SELECT 1 FROM lion_kodn d WHERE d.k = f.fk)');
          lion_wj_par           
--------------------------------
 parallel, in key order, 1 rows
(1 row)

SELECT lion_wj_par('SELECT d.attr, count(*) FROM lion_kodn d WHERE EXISTS (SELECT 1 FROM lion_kof f WHERE f.fk = d.k) GROUP BY d.attr');
          lion_wj_par           
--------------------------------
 parallel, in key order, 4 rows
(1 row)

RESET parallel_setup_cost;
RESET parallel_tuple_cost;
RESET min_parallel_table_scan_size;
RESET min_parallel_index_scan_size;
RESET parallel_leader_participation;
-- ---- 6. a dirty heap: deletes and updates on both sides, not yet vacuumed ----------
DELETE FROM lion_kof WHERE fk % 11 = 0;
UPDATE lion_kof SET fk = fk + 3 WHERE fk % 13 = 1 AND x < 5;
UPDATE lion_kof SET x = 3 WHERE id % 97 = 0;
INSERT INTO lion_kof SELECT 24000 + i, i * 3, 3, 't3' FROM generate_series(1, 40) i;
DELETE FROM lion_kod WHERE pk % 39 = 0;
UPDATE lion_kod SET attr = 6 WHERE pk % 17 = 0;
DELETE FROM lion_kodn WHERE k % 19 = 0;
SELECT lion_wj('SELECT d.attr, count(*) FROM lion_kof f JOIN lion_kod d ON f.fk = d.pk GROUP BY d.attr');
              lion_wj              
-----------------------------------
 pushed down, in key order, 7 rows
(1 row)

