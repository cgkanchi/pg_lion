(1 row)

-- the forward EXISTS over the unique key is the inner join
SELECT lion_wj('SELECT count(*) FROM lion_kof f WHERE f.x = 4 AND EXISTS (SELECT 1 FROM lion_kod d WHERE d.pk = f.fk)');
              lion_wj              
-----------------------------------
