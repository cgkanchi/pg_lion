-- FK-side join pushdown, part six (DESIGN.md §27, "Lookups in key order"):
-- the dimension's keys looked up a batch at a time, sorted into the fk
-- index's order, by one walk of its directory leaves instead of a descent
-- per key.
--
-- The cost model takes the walk where a descent crosses two internal levels
-- or more and a batch holds more keys than there are leaves between them.
-- So the fk index here is built with a low fillfactor: some eleven thousand
-- keys over some five hundred leaves, under a directory of height 2, which
-- a dimension of a few thousand keys covers densely.  Every answer is
-- checked against the same query with the pushdown off, as a multiset in
-- both directions, and the helpers say whether the node walked.
\set VERBOSITY terse
SET client_min_messages = warning;
LOAD 'pg_lion';
CREATE EXTENSION IF NOT EXISTS pg_lion;
-- VACUUM can only set all-visible once the commit record is on disk
SET synchronous_commit = on;
-- The FK-side joins below pin the upper node's plans (DESIGN.md §27).  The semi
-- and anti join path answers the same joins as a join rel's rows, below core's
-- own Agg, and no enable_*join setting disables it: it is off here, and tested
-- - the upper node over it included - in fkjoin_semipath.sql.
SET pg_lion.enable_semijoin = off;
SET default_statistics_target = 1000;
SET max_parallel_workers_per_gather = 0;
/*
 * lion_wj() runs a query through the pushdown with every join method
 * disabled, so that the node is EXERCISED, and again with the pushdown off
 * and sequential scans only, so that the reference reads no lion posting
 * set, and compares the two.  It reports whether the node was used, and
 * whether it looked its keys up in key order or a row at a time.
 */
CREATE FUNCTION lion_wj(q text) RETURNS text
LANGUAGE plpgsql AS $$
DECLARE
	ln text;
	pushed boolean := false;
	walked boolean := false;
	nrows bigint;
	ndiff bigint;
BEGIN
	PERFORM set_config('enable_hashjoin', 'off', true);
	PERFORM set_config('enable_mergejoin', 'off', true);
	PERFORM set_config('enable_nestloop', 'off', true);
	PERFORM set_config('pg_lion.enable_count_pushdown', 'on', true);
	FOR ln IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP
		IF ln LIKE '%Custom Scan (LionCount)%' THEN
			pushed := true;
		ELSIF ln LIKE '%Join Key Lookups: in index order%' THEN
			walked := true;
		END IF;
	END LOOP;
	EXECUTE format('CREATE TEMP TABLE lion_wj_on AS SELECT s::text AS r FROM (%s) s', q);

	/*
	 * The reference: the pushdown off, and sequential scans only - no bitmap,
	 * index or index-only scan, which could read the very lion posting sets
	 * the node reads and agree with it about a wrong answer.
	 */
	PERFORM set_config('pg_lion.enable_count_pushdown', 'off', true);
	PERFORM set_config('enable_hashjoin', 'on', true);
	PERFORM set_config('enable_mergejoin', 'on', true);
	PERFORM set_config('enable_nestloop', 'on', true);
	PERFORM set_config('enable_seqscan', 'on', true);
	PERFORM set_config('enable_bitmapscan', 'off', true);
	PERFORM set_config('enable_indexscan', 'off', true);
	PERFORM set_config('enable_indexonlyscan', 'off', true);
	EXECUTE format('CREATE TEMP TABLE lion_wj_off AS SELECT s::text AS r FROM (%s) s', q);
	PERFORM set_config('enable_bitmapscan', 'on', true);
	PERFORM set_config('enable_indexscan', 'on', true);
	PERFORM set_config('enable_indexonlyscan', 'on', true);
	PERFORM set_config('pg_lion.enable_count_pushdown', 'on', true);

	EXECUTE 'SELECT count(*) FROM lion_wj_on' INTO nrows;
	EXECUTE 'SELECT (SELECT count(*) FROM (SELECT * FROM lion_wj_on EXCEPT ALL SELECT * FROM lion_wj_off) a)'
			' + (SELECT count(*) FROM (SELECT * FROM lion_wj_off EXCEPT ALL SELECT * FROM lion_wj_on) b)'
		INTO ndiff;
	EXECUTE 'DROP TABLE lion_wj_on, lion_wj_off';

	IF ndiff <> 0 THEN
		RETURN format('MISMATCH: %s rows differ', ndiff);
	END IF;
	RETURN format('%s, %s, %s rows',
				  CASE WHEN pushed THEN 'pushed down' ELSE 'not pushed down' END,
				  CASE WHEN walked THEN 'in key order' ELSE 'a row at a time' END,
				  nrows);
END $$;
/*
 * The same with a generic prepared plan, which keeps $n a Param: the fact
 * filter's value is known only when the node starts.
 */
CREATE FUNCTION lion_wj_prep(q text, args text) RETURNS text
LANGUAGE plpgsql AS $$
DECLARE
	ln text;
	pushed boolean := false;
	walked boolean := false;
	nrows bigint;
	ndiff bigint;
BEGIN
	PERFORM set_config('plan_cache_mode', 'force_generic_plan', true);
	PERFORM set_config('enable_hashjoin', 'off', true);
	PERFORM set_config('enable_mergejoin', 'off', true);
	PERFORM set_config('enable_nestloop', 'off', true);
	PERFORM set_config('pg_lion.enable_count_pushdown', 'on', true);
	EXECUTE 'PREPARE lion_wjp_on AS ' || q;
	FOR ln IN EXECUTE 'EXPLAIN (COSTS OFF) EXECUTE lion_wjp_on(' || args || ')' LOOP
		IF ln LIKE '%Custom Scan (LionCount)%' THEN
			pushed := true;
		ELSIF ln LIKE '%Join Key Lookups: in index order%' THEN
			walked := true;
		END IF;
	END LOOP;
	EXECUTE format('CREATE TEMP TABLE lion_wj_on AS EXECUTE lion_wjp_on(%s)', args);

	PERFORM set_config('enable_hashjoin', 'on', true);
	PERFORM set_config('enable_mergejoin', 'on', true);
	PERFORM set_config('enable_nestloop', 'on', true);
	PERFORM set_config('pg_lion.enable_count_pushdown', 'off', true);
	PERFORM set_config('enable_seqscan', 'on', true);
	PERFORM set_config('enable_bitmapscan', 'off', true);
	PERFORM set_config('enable_indexscan', 'off', true);
	PERFORM set_config('enable_indexonlyscan', 'off', true);
	EXECUTE 'PREPARE lion_wjp_off AS ' || q;
	EXECUTE format('CREATE TEMP TABLE lion_wj_off AS EXECUTE lion_wjp_off(%s)', args);
	PERFORM set_config('enable_bitmapscan', 'on', true);
	PERFORM set_config('enable_indexscan', 'on', true);
	PERFORM set_config('enable_indexonlyscan', 'on', true);
	PERFORM set_config('pg_lion.enable_count_pushdown', 'on', true);
	EXECUTE 'DEALLOCATE lion_wjp_on';
	EXECUTE 'DEALLOCATE lion_wjp_off';

	EXECUTE 'SELECT count(*) FROM lion_wj_on' INTO nrows;
	EXECUTE 'SELECT (SELECT count(*) FROM (SELECT * FROM lion_wj_on EXCEPT ALL SELECT * FROM lion_wj_off) a)'
			' + (SELECT count(*) FROM (SELECT * FROM lion_wj_off EXCEPT ALL SELECT * FROM lion_wj_on) b)'
		INTO ndiff;
	EXECUTE 'DROP TABLE lion_wj_on, lion_wj_off';
	IF ndiff <> 0 THEN
		RETURN format('MISMATCH: %s rows differ', ndiff);
	END IF;
	RETURN format('%s, %s, %s rows',
				  CASE WHEN pushed THEN 'pushed down' ELSE 'not pushed down' END,
				  CASE WHEN walked THEN 'in key order' ELSE 'a row at a time' END,
				  nrows);
END $$;
/*
 * lion_wj_par() runs a query through the pushdown with every join method
 * disabled three ways - as planned with parallel plans allowed, serially,
 * and with the pushdown off - and compares both of the first two with the
 * third.  It says which plan the first one had.
 */
CREATE FUNCTION lion_wj_par(q text) RETURNS text
LANGUAGE plpgsql AS $$
DECLARE
	ln text;
	how text := 'not pushed down';
	walked boolean := false;
	nrows bigint;
	ndiff bigint;
	sdiff bigint;
BEGIN
	PERFORM set_config('enable_hashjoin', 'off', true);
	PERFORM set_config('enable_mergejoin', 'off', true);
	PERFORM set_config('enable_nestloop', 'off', true);
	PERFORM set_config('pg_lion.enable_count_pushdown', 'on', true);
	PERFORM set_config('max_parallel_workers_per_gather', '2', true);
	FOR ln IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP
		IF ln LIKE '%Parallel Custom Scan (LionCount)%' THEN
			how := 'parallel';
		ELSIF ln LIKE '%Custom Scan (LionCount)%' AND how <> 'parallel' THEN
			how := 'serial';
		ELSIF ln LIKE '%Join Key Lookups: in index order%' THEN
			walked := true;
		END IF;
	END LOOP;
	EXECUTE format('CREATE TEMP TABLE lion_wj_par AS SELECT s::text AS r FROM (%s) s', q);

	PERFORM set_config('max_parallel_workers_per_gather', '0', true);
	EXECUTE format('CREATE TEMP TABLE lion_wj_ser AS SELECT s::text AS r FROM (%s) s', q);

	PERFORM set_config('pg_lion.enable_count_pushdown', 'off', true);
	PERFORM set_config('enable_hashjoin', 'on', true);
	PERFORM set_config('enable_mergejoin', 'on', true);
	PERFORM set_config('enable_nestloop', 'on', true);
	PERFORM set_config('enable_seqscan', 'on', true);
	PERFORM set_config('enable_bitmapscan', 'off', true);
	PERFORM set_config('enable_indexscan', 'off', true);
	PERFORM set_config('enable_indexonlyscan', 'off', true);
	EXECUTE format('CREATE TEMP TABLE lion_wj_off AS SELECT s::text AS r FROM (%s) s', q);
	PERFORM set_config('enable_bitmapscan', 'on', true);
	PERFORM set_config('enable_indexscan', 'on', true);
	PERFORM set_config('enable_indexonlyscan', 'on', true);
	PERFORM set_config('pg_lion.enable_count_pushdown', 'on', true);

	EXECUTE 'SELECT count(*) FROM lion_wj_par' INTO nrows;
	EXECUTE 'SELECT (SELECT count(*) FROM (SELECT * FROM lion_wj_par EXCEPT ALL SELECT * FROM lion_wj_off) a)'
			' + (SELECT count(*) FROM (SELECT * FROM lion_wj_off EXCEPT ALL SELECT * FROM lion_wj_par) b)'
		INTO ndiff;
	EXECUTE 'SELECT (SELECT count(*) FROM (SELECT * FROM lion_wj_ser EXCEPT ALL SELECT * FROM lion_wj_off) a)'
			' + (SELECT count(*) FROM (SELECT * FROM lion_wj_off EXCEPT ALL SELECT * FROM lion_wj_ser) b)'
		INTO sdiff;
	EXECUTE 'DROP TABLE lion_wj_par, lion_wj_ser, lion_wj_off';

	IF ndiff <> 0 OR sdiff <> 0 THEN
		RETURN format('MISMATCH: %s rows differ in parallel, %s serially', ndiff, sdiff);
	END IF;
	RETURN format('%s, %s, %s rows', how,
				  CASE WHEN walked THEN 'in key order' ELSE 'a row at a time' END,
				  nrows);
END $$;
/* One counter of the node's EXPLAIN ANALYZE output, joins disabled. */
CREATE FUNCTION lion_wj_counter(q text, counter text) RETURNS bigint
LANGUAGE plpgsql AS $$
DECLARE
	ln text;
	val bigint;
BEGIN
	PERFORM set_config('enable_hashjoin', 'off', true);
	PERFORM set_config('enable_mergejoin', 'off', true);
	PERFORM set_config('enable_nestloop', 'off', true);
	FOR ln IN EXECUTE 'EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF) ' || q LOOP
		IF btrim(split_part(ln, ':', 1)) = counter THEN
			val := btrim(split_part(ln, ':', 2))::bigint;
		END IF;
	END LOOP;
	RETURN val;
END $$;
/*
 * EXPLAIN of the node and what is above it, joins disabled.  The dimension's
 * own plan is printed as one line: it is whatever each major makes of it.
 */
CREATE FUNCTION lion_wj_explain(q text) RETURNS SETOF text
LANGUAGE plpgsql AS $$
DECLARE
	ln text;
	seen boolean := false;
BEGIN
	PERFORM set_config('enable_hashjoin', 'off', true);
	PERFORM set_config('enable_mergejoin', 'off', true);
	PERFORM set_config('enable_nestloop', 'off', true);
	FOR ln IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP
		CONTINUE WHEN ln ~ '^\s*Disabled: true$';
		IF seen AND ln ~ '^\s*->' THEN
			RETURN NEXT regexp_replace(ln, '->.*$', '->  (the dimension''s plan)');
			RETURN;
		END IF;
		IF ln LIKE '%Custom Scan (LionCount)%' THEN
			seen := true;
		END IF;
		RETURN NEXT ln;
	END LOOP;
END $$;
/*
 * The fact: 24000 rows whose int8 fk runs over 1..12000, every key twice and
 * in an order unrelated to the key's.  NULL on every 50th row - both rows of
 * the 240 keys those are, which therefore have none - and no row for the
 * keys that are multiples of 23.  x has 10 values, t 7.  The fk index is
 * built at fillfactor 20, some 23 entries a leaf.
 */
CREATE TABLE lion_kof (id int NOT NULL, fk int8, x int NOT NULL, t text NOT NULL);
INSERT INTO lion_kof
SELECT i, CASE WHEN i % 50 = 0 THEN NULL WHEN k % 23 = 0 THEN NULL ELSE k END,
	   i % 10, 't' || (i % 7)
FROM (SELECT i, (i * 7919) % 12000 + 1 AS k FROM generate_series(1, 24000) i) s;
CREATE INDEX lion_kof_fk ON lion_kof USING lion (fk) WITH (fillfactor = 20);
CREATE INDEX lion_kof_x ON lion_kof USING lion (x);
CREATE INDEX lion_kof_t ON lion_kof USING lion (t);
/*
 * The dimension: 4000 rows, an int8 primary key over every third key of the
 * fact's range - 260 of them have no fact row, ten of those past its end -
 * attr 0..6 with NULL on every 13th, a region and a group.
 */
CREATE TABLE lion_kod (
	pk		int8	PRIMARY KEY,
	attr	int,
	region	text	NOT NULL,
	grp		text	NOT NULL
);
INSERT INTO lion_kod
SELECT CASE WHEN i <= 3990 THEN i * 3 ELSE 12000 + (i - 3990) * 5 END,
	   CASE WHEN i % 13 = 0 THEN NULL ELSE i % 7 END,
	   CASE i % 3 WHEN 0 THEN 'eu' WHEN 1 THEN 'us' ELSE 'ap' END,
	   'g' || (i % 5)
FROM generate_series(1, 4000) i;
/*
 * A dimension whose key nothing proves unique: 6000 rows over 3000 keys
 * spread over the fact's range, every key twice but where a row's key is
 * NULL (every 40th row).
 */
CREATE TABLE lion_kodn (k int8, attr int NOT NULL);
INSERT INTO lion_kodn
SELECT CASE WHEN i % 40 = 0 THEN NULL ELSE ((i * 13) % 3000) * 4 + 1 END, i % 4
FROM generate_series(1, 6000) i;
VACUUM (FREEZE, ANALYZE) lion_kof;
VACUUM (FREEZE, ANALYZE) lion_kod;
VACUUM (FREEZE, ANALYZE) lion_kodn;
-- ---- 1. the directory and the plans -------------------------------------------
SELECT directory_height, leaf_pages < 4000 AS fewer_leaves_than_keys
FROM lion_index_stats('lion_kof_fk');
 directory_height | fewer_leaves_than_keys 
------------------+------------------------
                2 | t
(1 row)

-- the dimension's keys are looked up in key order
SELECT * FROM lion_wj_explain('SELECT d.attr, count(*) FROM lion_kof f JOIN lion_kod d ON f.fk = d.pk GROUP BY d.attr');
                lion_wj_explain                
-----------------------------------------------
 Finalize HashAggregate
   Group Key: d.attr
   ->  Custom Scan (LionCount)
         Lion Indexes: lion_kof_fk (fk = d.pk)
         Join Key Lookups: in index order
         ->  (the dimension's plan)
(6 rows)

-- ... and the distinct keys of a forward semi join over a non-unique key
SELECT * FROM lion_wj_explain('SELECT count(*) FROM lion_kof f WHERE EXISTS (SELECT 1 FROM lion_kodn d WHERE d.k = f.fk)');
               lion_wj_explain                
----------------------------------------------
 Finalize Aggregate
   ->  Custom Scan (LionCount)
         Lion Indexes: lion_kof_fk (fk = d.k)
         Join Type: Semi
         Join Keys: distinct, sorted
         Join Key Lookups: in index order
         ->  (the dimension's plan)
(7 rows)

-- a few dozen keys over five hundred leaves: a descent each, as before
SELECT * FROM lion_wj_explain('SELECT count(*) FROM lion_kof f JOIN lion_kod d ON f.fk = d.pk WHERE d.region = ''eu'' AND d.grp = ''g1'' AND d.attr = 2');
                lion_wj_explain                
-----------------------------------------------
 Finalize Aggregate
   ->  Custom Scan (LionCount)
         Lion Indexes: lion_kof_fk (fk = d.pk)
         ->  (the dimension's plan)
(4 rows)

-- ---- 2. the answers ------------------------------------------------------------
-- inner joins, grouped and not, with fact filters and dimension filters
SELECT lion_wj('SELECT d.attr, count(*) FROM lion_kof f JOIN lion_kod d ON f.fk = d.pk GROUP BY d.attr');
              lion_wj              
-----------------------------------
