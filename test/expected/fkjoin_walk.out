(1 row)

SELECT lion_wj('SELECT d.attr, count(*) FROM lion_kof f JOIN lion_kod d ON f.fk = d.pk GROUP BY d.attr HAVING count(*) > 900 ORDER BY d.attr NULLS FIRST');
              lion_wj              
-----------------------------------
