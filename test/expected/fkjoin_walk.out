(1 row)

SELECT lion_wj('SELECT d.attr, count(*) FROM lion_kof f JOIN lion_kod d ON f.fk = d.pk WHERE f.x = 3 GROUP BY d.attr');
              lion_wj              
-----------------------------------
 pushed down, in key order, 8 rows
(1 row)

SELECT lion_wj('SELECT d.grp, count(*) FROM lion_kof f JOIN lion_kod d ON f.fk = d.pk WHERE f.x IN (1, 2) AND d.region = ''eu'' GROUP BY d.grp');
              lion_wj              
-----------------------------------
 pushed down, in key order, 2 rows
(1 row)

SELECT lion_wj('SELECT d.region, d.grp, count(*) FROM lion_kof f JOIN lion_kod d ON f.fk = d.pk WHERE f.t = ''t4'' GROUP BY d.region, d.grp');
              lion_wj               
------------------------------------
 pushed down, in key order, 15 rows
(1 row)

SELECT lion_wj('SELECT count(*) FROM lion_kof f JOIN lion_kod d ON f.fk = d.pk');
              lion_wj              
-----------------------------------
