CREATE TEMP TABLE lion_revx_vals AS
	SELECT ((i * 37) % 5000)::int8 AS v FROM generate_series(1, 400) i;
INSERT INTO lion_revx_vals VALUES (4999), (0), (2500), (7), (7);
SET pg_lion.enable_count_pushdown = off;
