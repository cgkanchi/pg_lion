-- ---- 4. EXPLAIN ----------------------------------------------------------
SET enable_seqscan = off;
SELECT * FROM lion_explain_norm('SELECT count(DISTINCT k) FROM lion_dt WHERE a = 3') AS p("QUERY PLAN");
