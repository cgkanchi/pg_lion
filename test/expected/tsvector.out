-- Multi-key operator classes: tsvector (DESIGN.md section 17).
--
-- `tsvector_ops` indexes one row under every lexeme of its tsvector, with
-- text keys.  A tsquery of AND and OR over plain lexemes becomes a boolean
-- tree over those keys and is answered exactly; NOT, phrase search, prefixes
-- and weights need positions or ranges the index does not have, and fall back
-- to scanning every indexed row with a recheck.
--
-- Every query is run through the index and through a forced sequential scan
-- and the two results compared as multisets.
\set VERBOSITY terse
SET client_min_messages = warning;
LOAD 'pg_lion';
/* VACUUM can only set all-visible for commits that reached disk (citext.sql). */
SET synchronous_commit = on;
SET default_statistics_target = 1000;
CREATE EXTENSION IF NOT EXISTS pg_lion;
CREATE FUNCTION lion_tscmp(q text) RETURNS text
LANGUAGE plpgsql AS $$
DECLARE
	ln text;
	node text := 'seq scan';
	nrows bigint;
	ndiff bigint;
BEGIN
	PERFORM set_config('pg_lion.enable_count_pushdown', 'on', true);
	PERFORM set_config('enable_seqscan', 'off', true);
	PERFORM set_config('enable_indexscan', 'off', true);	-- the bitmap path (§29)
	FOR ln IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP
		IF ln LIKE '%Custom Scan (LionCount)%' THEN
			node := 'pushed down';
		ELSIF ln LIKE '%Bitmap Index Scan%' THEN
			node := 'index scan';
		END IF;
	END LOOP;
	EXECUTE format('CREATE TEMP TABLE lion_t_idx AS %s', q);

	PERFORM set_config('pg_lion.enable_count_pushdown', 'off', true);
	PERFORM set_config('enable_seqscan', 'on', true);
	PERFORM set_config('enable_bitmapscan', 'off', true);
	PERFORM set_config('enable_indexscan', 'off', true);
	EXECUTE format('CREATE TEMP TABLE lion_t_seq AS %s', q);
	PERFORM set_config('enable_bitmapscan', 'on', true);
	PERFORM set_config('enable_indexscan', 'on', true);

	EXECUTE 'SELECT count(*) FROM lion_t_idx' INTO nrows;
	EXECUTE 'SELECT (SELECT count(*) FROM (SELECT * FROM lion_t_idx EXCEPT ALL SELECT * FROM lion_t_seq) a)'
			' + (SELECT count(*) FROM (SELECT * FROM lion_t_seq EXCEPT ALL SELECT * FROM lion_t_idx) b)'
		INTO ndiff;
	EXECUTE 'DROP TABLE lion_t_idx, lion_t_seq';

	IF ndiff <> 0 THEN
		RETURN format('MISMATCH: %s rows differ', ndiff);
	END IF;
	RETURN format('%s, %s rows', node, nrows);
END $$;
CREATE FUNCTION lion_tsplan(q text) RETURNS SETOF text
LANGUAGE plpgsql AS $$
DECLARE
	ln text;
BEGIN
	PERFORM set_config('enable_seqscan', 'off', true);
	PERFORM set_config('enable_indexscan', 'off', true);	-- the bitmap path (§29)
	FOR ln IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP
		RETURN NEXT ln;
	END LOOP;
	PERFORM set_config('enable_seqscan', 'on', true);
	PERFORM set_config('enable_indexscan', 'on', true);
END $$;
-- ---- the table ---------------------------------------------------------
--
-- A few hundred generated sentences over a vocabulary of ~60 words, so that
-- the posting sets are big enough to be interesting and the answers small
-- enough to compare.  Row 0's text is empty, so its tsvector has no lexeme at
-- all and the row lands in the reserved EMPTY entry; row -1's is NULL.
CREATE TABLE lion_ts (
	id		int		NOT NULL,
	grp		int		NOT NULL,	-- 6 groups, scalar lion index
	body	text,
	tsv		tsvector
);
INSERT INTO lion_ts (id, grp, body)
SELECT i, i % 6,
	   'alpha w' || (i % 17) || ' w' || (i % 23) || ' w' || (i % 29) ||
	   ' bravo charlie delta w' || (i % 31)
  FROM generate_series(1, 600) i;
INSERT INTO lion_ts (id, grp, body) VALUES (0, 0, '');
INSERT INTO lion_ts (id, grp, body) VALUES (-1, 1, NULL);
UPDATE lion_ts SET tsv = to_tsvector('english', coalesce(body, ''))
 WHERE body IS NOT NULL;
CREATE INDEX lion_ts_tsv ON lion_ts USING lion (tsv);
CREATE INDEX lion_ts_grp ON lion_ts USING lion (grp);
VACUUM ANALYZE lion_ts;
-- The key column of a tsvector_ops index is text: the lexeme.
SELECT a.attname, a.atttypid::regtype
  FROM pg_attribute a
 WHERE a.attrelid = 'lion_ts_tsv'::regclass AND a.attnum > 0;
 attname | atttypid 
---------+----------
 tsv     | text
(1 row)

SELECT lion_index_verify('lion_ts_tsv', true);
 lion_index_verify 
-------------------
 
(1 row)

SELECT entries, null_tids, empty_tids FROM lion_index_stats('lion_ts_tsv');
 entries | null_tids | empty_tids 
---------+-----------+------------
      37 |         1 |          1
(1 row)

-- ---- plans -------------------------------------------------------------
SELECT lion_tsplan($$SELECT id FROM lion_ts
					WHERE tsv @@ to_tsquery('english', 'w1 & w2')$$);
                       lion_tsplan                       
---------------------------------------------------------
 Bitmap Heap Scan on lion_ts
   Recheck Cond: (tsv @@ '''w1'' & ''w2'''::tsquery)
   ->  Bitmap Index Scan on lion_ts_tsv
         Index Cond: (tsv @@ '''w1'' & ''w2'''::tsquery)
(4 rows)

SELECT lion_tsplan($$SELECT count(*) FROM lion_ts
					WHERE tsv @@ to_tsquery('english', 'w1 & w2')$$);
                   lion_tsplan                    
--------------------------------------------------
 Custom Scan (LionCount)
   Lion Indexes: lion_ts_tsv (tsv @@ 'w1' & 'w2')
(2 rows)

SELECT lion_tsplan($$SELECT count(*) FROM lion_ts
					WHERE tsv @@ to_tsquery('english', 'w1 | w2')$$);
                   lion_tsplan                    
--------------------------------------------------
 Custom Scan (LionCount)
   Lion Indexes: lion_ts_tsv (tsv @@ 'w1' | 'w2')
(2 rows)

-- NOT, prefix, phrase and weights are never pushed down
SELECT lion_tsplan($$SELECT count(*) FROM lion_ts
					WHERE tsv @@ to_tsquery('english', 'alpha & !w1')$$);
                            lion_tsplan                            
-------------------------------------------------------------------
 Aggregate
   ->  Bitmap Heap Scan on lion_ts
         Recheck Cond: (tsv @@ '''alpha'' & !''w1'''::tsquery)
         ->  Bitmap Index Scan on lion_ts_tsv
               Index Cond: (tsv @@ '''alpha'' & !''w1'''::tsquery)
(5 rows)

SELECT lion_tsplan($$SELECT count(*) FROM lion_ts
					WHERE tsv @@ to_tsquery('english', 'w1:*')$$);
                      lion_tsplan                       
--------------------------------------------------------
 Aggregate
   ->  Bitmap Heap Scan on lion_ts
         Recheck Cond: (tsv @@ '''w1'':*'::tsquery)
         ->  Bitmap Index Scan on lion_ts_tsv
               Index Cond: (tsv @@ '''w1'':*'::tsquery)
(5 rows)

SELECT lion_tsplan($$SELECT count(*) FROM lion_ts
					WHERE tsv @@ phraseto_tsquery('english', 'bravo charlie')$$);
                              lion_tsplan                               
------------------------------------------------------------------------
 Aggregate
   ->  Bitmap Heap Scan on lion_ts
         Recheck Cond: (tsv @@ '''bravo'' <-> ''charli'''::tsquery)
         ->  Bitmap Index Scan on lion_ts_tsv
               Index Cond: (tsv @@ '''bravo'' <-> ''charli'''::tsquery)
(5 rows)

SELECT lion_tsplan($$SELECT count(*) FROM lion_ts
					WHERE tsv @@ to_tsquery('english', 'alpha:A')$$);
                        lion_tsplan                        
-----------------------------------------------------------
 Aggregate
   ->  Bitmap Heap Scan on lion_ts
         Recheck Cond: (tsv @@ '''alpha'':A'::tsquery)
         ->  Bitmap Index Scan on lion_ts_tsv
               Index Cond: (tsv @@ '''alpha'':A'::tsquery)
(5 rows)

SELECT lion_tsplan($$SELECT grp, count(*) FROM lion_ts
					WHERE tsv @@ to_tsquery('english', 'w1 & w2') GROUP BY grp$$);
                             lion_tsplan                             
---------------------------------------------------------------------
 Custom Scan (LionCount)
   Lion Indexes: lion_ts_grp (grp), lion_ts_tsv (tsv @@ 'w1' & 'w2')
   Group Key: grp
(3 rows)

