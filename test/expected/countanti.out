-- ---------- 5. a dirty heap: deletes and updates, before and after VACUUM ----------
DELETE FROM lca_rows WHERE k = 1 AND x < 3;
UPDATE lca_rows SET k = 2 WHERE k = 3 AND x = 3;
UPDATE lca_rows SET x = 3 WHERE k = 5 AND x = 4;
UPDATE lca_rows SET k = NULL WHERE k = 6 AND x = 1;
UPDATE lca_rows SET pad = repeat('q', 60) WHERE k = 2 AND x = 2;
INSERT INTO lca_rows (id, k, kn, kd, g, y, z, x, pad)
SELECT 20000 + i, 1, 1, 1, 1, 1, 1, 3, 'n' FROM generate_series(1, 7) i;
UPDATE lca_skip SET a = 3 WHERE a = 6;
SELECT lca('SELECT count(*) FROM lca_rows r WHERE r.x < 5 AND NOT EXISTS (SELECT 1 FROM lca_skip s WHERE s.a = r.k)');
         lca         
