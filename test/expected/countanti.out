-- row-level security on the table counted
CREATE ROLE lca_reader;
GRANT SELECT ON lca_rows, lca_skip TO lca_reader;
ALTER TABLE lca_rows ENABLE ROW LEVEL SECURITY;
CREATE POLICY lca_rows_some ON lca_rows FOR SELECT TO lca_reader USING (g = 1);
SET ROLE lca_reader;
SELECT lca('SELECT count(*) FROM lca_rows r WHERE r.x < 5 AND NOT EXISTS (SELECT 1 FROM lca_skip s WHERE s.a = r.k)');
           lca           
-------------------------
 not pushed down, 1 rows
(1 row)

RESET ROLE;
ALTER TABLE lca_rows DISABLE ROW LEVEL SECURITY;
DROP POLICY lca_rows_some ON lca_rows;
REVOKE ALL ON lca_rows, lca_skip FROM lca_reader;
DROP ROLE lca_reader;
-- a partitioned table counted
CREATE TABLE lca_parts (id int NOT NULL, k int, x int NOT NULL) PARTITION BY RANGE (id);
CREATE TABLE lca_parts_1 PARTITION OF lca_parts FOR VALUES FROM (0) TO (5000);
CREATE TABLE lca_parts_2 PARTITION OF lca_parts FOR VALUES FROM (5000) TO (10000);
INSERT INTO lca_parts SELECT i, i % 100, i % 10 FROM generate_series(0, 9999) i;
CREATE INDEX lca_parts_k ON lca_parts (k);
CREATE INDEX lca_parts_x ON lca_parts USING lion (x);
VACUUM (ANALYZE) lca_parts;
SELECT lca('SELECT count(*) FROM lca_parts p WHERE p.x = 3 AND NOT EXISTS (SELECT 1 FROM lca_skip s WHERE s.a = p.k)');
           lca           
-------------------------
 not pushed down, 1 rows
(1 row)

DROP TABLE lca_parts;
DROP TABLE lca_rows, lca_skip, lca_num, lca_tag;
