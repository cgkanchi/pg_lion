-- The anti join over a small inner side (DESIGN.md §27, "The anti join over
-- a small inner side"):
--
--   SELECT count(*) FROM rows r WHERE <r's clauses>
--     AND NOT EXISTS (SELECT 1 FROM skip s WHERE s.a = r.k ... <s's filters>)
--
-- is the count of r's WHERE less the rows of it some row of s matches.  The
-- node runs s as its child, looks each distinct key of its rows up in a
-- B-tree on r.k under the query's snapshot, tests every row found on r's own
-- clauses and then on the join clauses, and subtracts the ones that pass -
-- from the one row of a count, from each group of a GROUP BY, or from each
-- cell of a count by cells.  Every answer is checked against the same query
-- with the pushdown off, as a multiset in both directions.
\set VERBOSITY terse
SET client_min_messages = warning;
LOAD 'pg_lion';
CREATE EXTENSION IF NOT EXISTS pg_lion;
RESET client_min_messages;
-- VACUUM can only set all-visible once the commit record is on disk
SET synchronous_commit = on;
SET default_statistics_target = 1000;
/*
 * lca() runs a query through the pushdown - every join method disabled, so
 * that core has no plan the node must beat on price - and again with the
 * pushdown off and sequential scans only, so that the reference reads no
 * lion posting set and no B-tree, and compares the two.  It says whether the
 * node was used.
 */
CREATE FUNCTION lca(q text) RETURNS text
LANGUAGE plpgsql AS $$
DECLARE
	ln text;
	how text := 'not pushed down';
	nrows bigint;
	ndiff bigint;
BEGIN
	PERFORM set_config('enable_hashjoin', 'off', true);
	PERFORM set_config('enable_mergejoin', 'off', true);
	PERFORM set_config('enable_nestloop', 'off', true);
	FOR ln IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP
		IF ln LIKE '%Parallel Custom Scan (LionCount)%' THEN
			how := 'pushed down, parallel';
		ELSIF ln LIKE '%Custom Scan (LionCount)%' AND how = 'not pushed down' THEN
			how := 'pushed down';
		END IF;
	END LOOP;
	EXECUTE format('CREATE TEMP TABLE lca_on AS SELECT s::text AS r FROM (%s) s', q);

	PERFORM set_config('pg_lion.enable_count_pushdown', 'off', true);
	PERFORM set_config('enable_hashjoin', 'on', true);
	PERFORM set_config('enable_mergejoin', 'on', true);
	PERFORM set_config('enable_nestloop', 'on', true);
	PERFORM set_config('enable_bitmapscan', 'off', true);
	PERFORM set_config('enable_indexscan', 'off', true);
	PERFORM set_config('enable_indexonlyscan', 'off', true);
	EXECUTE format('CREATE TEMP TABLE lca_off AS SELECT s::text AS r FROM (%s) s', q);
	PERFORM set_config('enable_bitmapscan', 'on', true);
	PERFORM set_config('enable_indexscan', 'on', true);
	PERFORM set_config('enable_indexonlyscan', 'on', true);
	PERFORM set_config('pg_lion.enable_count_pushdown', 'on', true);

	EXECUTE 'SELECT count(*) FROM lca_off' INTO nrows;
	EXECUTE 'SELECT (SELECT count(*) FROM (TABLE lca_on EXCEPT ALL TABLE lca_off) a)'
			' + (SELECT count(*) FROM (TABLE lca_off EXCEPT ALL TABLE lca_on) b)'
		INTO ndiff;
	EXECUTE 'DROP TABLE lca_on, lca_off';
	IF ndiff <> 0 THEN
		RETURN format('MISMATCH: %s rows differ', ndiff);
	END IF;
	RETURN format('%s, %s rows', how, nrows);
END $$;
/* The answer itself, through the pushdown, joins disabled. */
CREATE FUNCTION lca_val(q text) RETURNS SETOF text
LANGUAGE plpgsql AS $$
BEGIN
	PERFORM set_config('enable_hashjoin', 'off', true);
	PERFORM set_config('enable_mergejoin', 'off', true);
	PERFORM set_config('enable_nestloop', 'off', true);
	RETURN QUERY EXECUTE format('SELECT s::text FROM (%s) s', q);
END $$;
/* Which plan the cost model picks, with nothing disabled. */
CREATE FUNCTION lca_pick(q text) RETURNS text
LANGUAGE plpgsql AS $$
DECLARE
	ln text;
BEGIN
	FOR ln IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP
		IF ln LIKE '%Custom Scan (LionCount)%' THEN
			RETURN 'pushed down';
		END IF;
	END LOOP;
	RETURN 'not pushed down';
END $$;
/*
 * A generic prepared plan, which keeps $n a Param, against the same with the
 * pushdown off.
 */
CREATE FUNCTION lca_prep(q text, args text) RETURNS text
LANGUAGE plpgsql AS $$
DECLARE
	ln text;
	pushed boolean := false;
	nrows bigint;
	ndiff bigint;
BEGIN
	PERFORM set_config('plan_cache_mode', 'force_generic_plan', true);
	PERFORM set_config('enable_hashjoin', 'off', true);
	PERFORM set_config('enable_mergejoin', 'off', true);
	PERFORM set_config('enable_nestloop', 'off', true);
	EXECUTE 'PREPARE lca_p_on AS ' || q;
	FOR ln IN EXECUTE 'EXPLAIN (COSTS OFF) EXECUTE lca_p_on(' || args || ')' LOOP
		IF ln LIKE '%Custom Scan (LionCount)%' THEN
			pushed := true;
		END IF;
	END LOOP;
	EXECUTE format('CREATE TEMP TABLE lca_on AS EXECUTE lca_p_on(%s)', args);

	PERFORM set_config('enable_hashjoin', 'on', true);
	PERFORM set_config('enable_mergejoin', 'on', true);
	PERFORM set_config('enable_nestloop', 'on', true);
	PERFORM set_config('pg_lion.enable_count_pushdown', 'off', true);
	PERFORM set_config('enable_bitmapscan', 'off', true);
	PERFORM set_config('enable_indexscan', 'off', true);
	PERFORM set_config('enable_indexonlyscan', 'off', true);
	EXECUTE 'PREPARE lca_p_off AS ' || q;
	EXECUTE format('CREATE TEMP TABLE lca_off AS EXECUTE lca_p_off(%s)', args);
	PERFORM set_config('enable_bitmapscan', 'on', true);
	PERFORM set_config('enable_indexscan', 'on', true);
	PERFORM set_config('enable_indexonlyscan', 'on', true);
	PERFORM set_config('pg_lion.enable_count_pushdown', 'on', true);
	EXECUTE 'DEALLOCATE lca_p_on';
	EXECUTE 'DEALLOCATE lca_p_off';

	EXECUTE 'SELECT count(*) FROM lca_off' INTO nrows;
	EXECUTE 'SELECT (SELECT count(*) FROM (TABLE lca_on EXCEPT ALL TABLE lca_off) a)'
			' + (SELECT count(*) FROM (TABLE lca_off EXCEPT ALL TABLE lca_on) b)'
		INTO ndiff;
	EXECUTE 'DROP TABLE lca_on, lca_off';
	IF ndiff <> 0 THEN
		RETURN format('MISMATCH: %s rows differ', ndiff);
	END IF;
	RETURN format('%s, %s rows',
				  CASE WHEN pushed THEN 'pushed down' ELSE 'not pushed down' END,
				  nrows);
END $$;
/* The anti join's counters in EXPLAIN ANALYZE, joins disabled. */
CREATE FUNCTION lca_counters(q text) RETURNS text
LANGUAGE plpgsql AS $$
DECLARE
	ln text;
	out text := '';
BEGIN
	PERFORM set_config('enable_hashjoin', 'off', true);
	PERFORM set_config('enable_mergejoin', 'off', true);
	PERFORM set_config('enable_nestloop', 'off', true);
	FOR ln IN EXECUTE 'EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF) ' || q LOOP
		IF btrim(split_part(ln, ':', 1)) IN ('Join Child Rows', 'Join Keys Looked Up',
											 'Join Rows Fetched', 'Join Rows Subtracted') THEN
			out := out || CASE WHEN out = '' THEN '' ELSE ', ' END ||
				regexp_replace(btrim(ln), '^Join ', '');
		END IF;
	END LOOP;
	RETURN out;
END $$;
/*
 * EXPLAIN, joins disabled, in a form every supported release prints the same
 * way: no "Disabled: true" lines, and no ".00" on a row count.
 */
CREATE FUNCTION lca_explain(q text, opts text DEFAULT 'COSTS OFF') RETURNS SETOF text
LANGUAGE plpgsql AS $$
DECLARE
	l text;
BEGIN
	PERFORM set_config('enable_hashjoin', 'off', true);
	PERFORM set_config('enable_mergejoin', 'off', true);
	PERFORM set_config('enable_nestloop', 'off', true);
	FOR l IN EXECUTE 'EXPLAIN (' || opts || ') ' || q LOOP
		CONTINUE WHEN l ~ '^\s*Disabled: true$';
		RETURN NEXT regexp_replace(l, 'rows=(\d+)\.00 ', 'rows=\1 ', 'g');
	END LOOP;
END $$;
/*
 * The table counted: 20000 rows.  k has 400 values, some 50 rows each, and
 * NULL on every 37th row; kn is k without the NULLs, declared NOT NULL, and
 * kd the same as a numeric of two decimals; g has
 * 6 values and NULLs, y 7 and NULLs; z is 99 on exactly the rows of k = 5,
 * and 0..2 elsewhere; x has 10 values, for a WHERE of a tenth or a half.  pad
 * makes the rows a few to a page.  k, kn and kd have B-trees; x, g, z and (g, y)
 * lion indexes, and k one too, for count(k).
 */
CREATE TABLE lca_rows (
	id		int		PRIMARY KEY,
	k		int,
	kn		int		NOT NULL,
	kd		numeric,
	g		int,
	y		int,
	z		int		NOT NULL,
	x		int		NOT NULL,
	pad		text	NOT NULL
) WITH (autovacuum_enabled = off);
INSERT INTO lca_rows
SELECT i,
	   CASE WHEN i % 37 = 0 THEN NULL ELSE i % 400 END,
	   i % 400,
	   (i % 400)::numeric(6, 2),
	   CASE WHEN i % 11 = 0 THEN NULL ELSE i % 6 END,
	   CASE WHEN i % 13 = 0 THEN NULL ELSE i % 7 END,
	   CASE WHEN i % 400 = 5 AND i % 37 <> 0 THEN 99 ELSE i % 3 END,
	   (i / 400) % 10,
	   repeat('p', 60)
FROM generate_series(1, 20000) i;
CREATE INDEX lca_rows_k ON lca_rows (k);
CREATE INDEX lca_rows_kn ON lca_rows (kn);
CREATE INDEX lca_rows_kd ON lca_rows (kd);
CREATE INDEX lca_rows_x ON lca_rows USING lion (x);
CREATE INDEX lca_rows_g ON lca_rows USING lion (g);
CREATE INDEX lca_rows_z ON lca_rows USING lion (z);
CREATE INDEX lca_rows_gy ON lca_rows USING lion (g, y);
CREATE INDEX lca_rows_kl ON lca_rows USING lion (k);
/*
 * The inner side: a few keys - two rows of key 2, a pair whose a and b
 * differ, NULL in a and in b, the key of the rows of z = 99, keys of no row
 * of lca_rows, and two rows of another f.  c is a as int8.
 */
CREATE TABLE lca_skip (a int, b int, c int8, f int NOT NULL);
INSERT INTO lca_skip VALUES
	(1, 1, 1, 0), (2, 2, 2, 0), (2, 2, 2, 0), (3, 4, 3, 0),
	(NULL, 6, NULL, 0), (6, NULL, 6, 0), (5, 5, 5, 0),
	(450, 450, 450, 0), (-1, -1, -1, 0),
	(7, 7, 7, 1), (8, 8, 8, 1);
-- numeric keys, equal ones among them in other spellings
CREATE TABLE lca_num (d numeric);
INSERT INTO lca_num VALUES (1.0), (1.00), (1), (2.000), (2.5), (NULL);
-- a second inner table, joined to the first inside the NOT EXISTS
CREATE TABLE lca_tag (a int, tag text);
INSERT INTO lca_tag VALUES (1, 'on'), (2, 'off'), (5, 'on'), (7, 'on'), (450, 'on');
VACUUM (FREEZE, ANALYZE) lca_rows, lca_skip, lca_num, lca_tag;
-- ---------- 1. the plans ----------
SELECT * FROM lca_explain('SELECT count(*) FROM lca_rows r WHERE r.x = 3 AND NOT EXISTS (SELECT 1 FROM lca_skip s WHERE s.a = r.k AND s.f = 0)');
                      lca_explain                       
--------------------------------------------------------
 Custom Scan (LionCount)
   Lion Indexes: lca_rows_x (x = 3)
   Join Type: Anti
   Join Rows: the rows counted, less those with a match
   Join Lookup Index: lca_rows_k
   Join Cond: (s.a = k)
   ->  Seq Scan on lca_skip s
         Filter: (f = 0)
(8 rows)

-- a GROUP BY, the two-clause form over one column, and an inner side that is a join
SELECT * FROM lca_explain('SELECT r.g, count(*) FROM lca_rows r WHERE r.x < 5 AND NOT EXISTS (SELECT 1 FROM lca_skip s WHERE s.a = r.k AND s.b = r.k) GROUP BY r.g');
                      lca_explain                       
--------------------------------------------------------
 Custom Scan (LionCount)
   Lion Indexes: lca_rows_gy.g (g), lca_rows_x (x < 5)
   Join Type: Anti
   Join Rows: the rows counted, less those with a match
   Join Lookup Index: lca_rows_k
   Join Cond: ((s.a = k) AND (s.b = k))
   Group Key: g
   ->  Seq Scan on lca_skip s
(8 rows)

-- (the child's own plan, a join of two tables with every join method
-- disabled, is whichever the release makes: only its top is shown)
SELECT regexp_replace(ln, '(Nested Loop|Hash Join|Merge Join)', 'a join') AS ln
  FROM lca_explain('SELECT count(*) FROM lca_rows r WHERE r.x = 3 AND NOT EXISTS (SELECT 1 FROM lca_skip s JOIN lca_tag t ON t.a = s.a WHERE s.a = r.k AND t.tag = ''on'')') AS ln
 WHERE ln !~ '^\s{8}';
                           ln                           
--------------------------------------------------------
 Custom Scan (LionCount)
   Lion Indexes: lca_rows_x (x = 3)
   Join Type: Anti
   Join Rows: the rows counted, less those with a match
   Join Lookup Index: lca_rows_k
   Join Cond: (s.a = k)
   ->  a join
(7 rows)

-- the counters: the child's rows, the distinct keys, the rows found, and those subtracted
SELECT * FROM lca_explain('SELECT count(*) FROM lca_rows r WHERE r.x = 3 AND NOT EXISTS (SELECT 1 FROM lca_skip s WHERE s.a = r.k AND s.f = 0)',
						  'ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF') AS ln
	WHERE ln ~ '(Custom Scan|Join|Seq Scan|Filter)';
                           ln                           
--------------------------------------------------------
 Custom Scan (LionCount) (actual rows=1 loops=1)
   Join Type: Anti
   Join Rows: the rows counted, less those with a match
   Join Lookup Index: lca_rows_k
   Join Cond: (s.a = k)
   Join Child Rows: 9
   Join Keys Looked Up: 7
   Join Rows Fetched: 243
   Join Rows Subtracted: 24
   ->  Seq Scan on lca_skip s (actual rows=9 loops=1)
         Filter: (f = 0)
         Rows Removed by Filter: 2
(12 rows)

-- a GUC turns it off
SET pg_lion.enable_count_anti = off;
SELECT lca('SELECT count(*) FROM lca_rows r WHERE r.x = 3 AND NOT EXISTS (SELECT 1 FROM lca_skip s WHERE s.a = r.k AND s.f = 0)');
           lca           
-------------------------
 not pushed down, 1 rows
(1 row)

RESET pg_lion.enable_count_anti;
