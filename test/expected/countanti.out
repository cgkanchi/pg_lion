-- rows deleted and updated in this very transaction
BEGIN;
DELETE FROM lca_rows WHERE k = 2 AND x = 0;
UPDATE lca_rows SET k = 1 WHERE k = 7 AND x = 3;
SELECT lca('SELECT count(*) FROM lca_rows r WHERE r.x < 5 AND NOT EXISTS (SELECT 1 FROM lca_skip s WHERE s.a = r.k)');
         lca         
---------------------
 pushed down, 1 rows
(1 row)

SELECT lca('SELECT r.g, count(*) FROM lca_rows r WHERE r.x < 5 AND NOT EXISTS (SELECT 1 FROM lca_skip s WHERE s.a = r.k) GROUP BY r.g');
         lca         
---------------------
 pushed down, 7 rows
(1 row)

ROLLBACK;
VACUUM (FREEZE, ANALYZE) lca_rows, lca_skip;
SELECT lca('SELECT count(*) FROM lca_rows r WHERE r.x < 5 AND NOT EXISTS (SELECT 1 FROM lca_skip s WHERE s.a = r.k)');
