SELECT lion_xj('SELECT count(*) FROM lion_xf f WHERE f.kind = ''b'' AND f.x IN (1, 2) AND f.fk IN (SELECT n.k FROM lion_xdn n WHERE n.region = ''eu'')');
     lion_xj      
