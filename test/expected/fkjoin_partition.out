-- no fact filter left in any partition, and one that selects nothing in some
SELECT lion_xj('SELECT count(*) FROM lion_xf f JOIN lion_xd d ON f.fk = d.pk WHERE d.grp = ''g3'' AND f.kind = ''b''');
