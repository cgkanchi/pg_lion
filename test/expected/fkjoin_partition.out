------------------
 parallel, 3 rows
(1 row)

SELECT lion_xj('SELECT d.grp, count(*) FROM lion_xf f JOIN lion_xd d ON f.fk = d.pk WHERE f.kind IN (''a'', ''b'', ''c'', ''d'') AND f.x = 5 GROUP BY d.grp HAVING count(*) > 100 ORDER BY 2 DESC LIMIT 2');
