SELECT lion_xj('SELECT d.region, count(DISTINCT d.attr), count(*), count(d.attr), sum(d.small), max(d.grp), min(d.attr) FROM lion_xf f JOIN lion_xd d ON d.pk = f.fk WHERE f.kind IN (''b'', ''c'', ''d'') AND f.x > 6 GROUP BY d.region');
