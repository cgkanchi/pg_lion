SELECT lion_xj('SELECT count(*) FROM lion_xd d WHERE NOT EXISTS (SELECT 1 FROM lion_xf f WHERE f.fk = d.pk AND f.kind IN (''a'', ''c'') AND f.ts >= ''2026-03-01'' AND f.ts < ''2026-03-02'')');
