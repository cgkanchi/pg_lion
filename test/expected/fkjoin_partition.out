(1 row)

-- count(DISTINCT), and every aggregate over the counted rows
SELECT lion_xj('SELECT count(DISTINCT d.attr) FROM lion_xd d WHERE EXISTS (SELECT 1 FROM lion_xf f WHERE f.fk = d.pk AND f.kind = ''b'' AND f.x = 3)');
