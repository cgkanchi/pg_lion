       lion_gj       
---------------------
 pushed down, 3 rows
(1 row)

SELECT lion_gj('SELECT v.r, (SELECT count(*) FROM lion_gj_f2 f2 WHERE f2.y < 7 AND f2.fk IN (SELECT d.pk FROM lion_gj_d d WHERE d.region = v.r AND EXISTS (SELECT 1 FROM lion_gj_f1 f1 WHERE f1.fk = d.pk AND f1.kind = ''b''))) FROM (VALUES (''eu''), (''ap'')) v(r)');
       lion_gj       
---------------------
