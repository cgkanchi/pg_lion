SELECT lion_gj('SELECT count(*) FROM lion_gj_d d WHERE EXISTS (SELECT 1 FROM lion_gj_f1 f1 WHERE f1.fk = d.pk AND f1.id % 3 = 0 AND EXISTS (SELECT 1 FROM lion_gj_f2 f2 WHERE f2.fk = f1.fk AND f2.y = 5))');
         lion_gj         
