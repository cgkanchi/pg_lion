SELECT lion_gj('SELECT count(*) FROM lion_gj_d d WHERE NOT EXISTS (SELECT 1 FROM lion_gj_f3 f3 WHERE f3.fk = d.pk AND f3.z = 1) AND EXISTS (SELECT 1 FROM lion_gj_f1 f1 WHERE f1.fk = d.pk AND f1.kind IN (''a'', ''b'') AND f1.tags && ''{u2}'')', 'plan');
