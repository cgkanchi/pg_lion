-- ---- 4. the counters ------------------------------------------------------------
/*
 * The child's rows are the joined dimension's: the dimension rows with an f1
 * row of kind 'b', each once, whatever f1 holds of them - and every one of
 * them is looked up in f2.  Serially, where the counters are one process's.
 */
SET max_parallel_workers_per_gather = 0;
SELECT lion_gj_counter('SELECT count(*) FROM lion_gj_d d WHERE EXISTS (SELECT 1 FROM lion_gj_f1 f1 WHERE f1.fk = d.pk AND f1.kind = ''b'' AND f1.id % 1 = 0) AND EXISTS (SELECT 1 FROM lion_gj_f2 f2 WHERE f2.fk = d.pk AND f2.y = 5)', 'Join Child Rows') =
	   (SELECT count(*) FROM lion_gj_d d WHERE EXISTS (SELECT 1 FROM lion_gj_f1 f1 WHERE f1.fk = d.pk AND f1.kind = 'b')) AS child_rows,
	   lion_gj_counter('SELECT count(*) FROM lion_gj_d d WHERE EXISTS (SELECT 1 FROM lion_gj_f1 f1 WHERE f1.fk = d.pk AND f1.kind = ''b'' AND f1.id % 1 = 0) AND EXISTS (SELECT 1 FROM lion_gj_f2 f2 WHERE f2.fk = d.pk AND f2.y = 5)', 'Join Keys Looked Up') =
	   (SELECT count(*) FROM lion_gj_d d WHERE EXISTS (SELECT 1 FROM lion_gj_f1 f1 WHERE f1.fk = d.pk AND f1.kind = 'b')) AS keys_looked_up,
	   (SELECT count(*) FROM lion_gj_d d WHERE EXISTS (SELECT 1 FROM lion_gj_f1 f1 WHERE f1.fk = d.pk AND f1.kind = 'b')) AS dimension_rows_joined;
 child_rows | keys_looked_up | dimension_rows_joined 
------------+----------------+-----------------------
 t          | t              |                  2692
(1 row)

/*
 * The forward semi join over the non-unique dimension looks each distinct
 * key of its joined rows up once.
 */
SELECT lion_gj_counter('SELECT count(*) FROM lion_gj_f2 f2 WHERE f2.y = 5 AND f2.fk IN (SELECT n.k FROM lion_gj_n n WHERE n.attr < 3 AND EXISTS (SELECT 1 FROM lion_gj_f1 f1 WHERE f1.fk = n.k AND f1.kind = ''b''))', 'Join Keys Looked Up') =
	   (SELECT count(DISTINCT n.k) FROM lion_gj_n n WHERE n.attr < 3 AND EXISTS (SELECT 1 FROM lion_gj_f1 f1 WHERE f1.fk = n.k AND f1.kind = 'b')) AS distinct_keys;
 distinct_keys 
---------------
 t
(1 row)

SET max_parallel_workers_per_gather = 2;
-- ---- 5. parallel plans ---------------------------------------------------------
/*
 * The node over the joined dimension's partial path below a Gather: each
 * participant counts the rows its share of that join returns.  Hash joins
 * stay allowed here (lion.gj_hash), nested loops and merge joins do not: the
 * child of each is a hash join, and so is any plan it competes with.  With
 * every join method disabled, PostgreSQL 16 and 17 add disable_cost to both
 * the serial node's price and the parallel one's, through their children, and
 * at that size add_path() takes the two for the same price and keeps the
 * serial path, which is parallel-safe; from 18 disabled nodes are counted
 * apart from the cost.
 */
SET lion.gj_hash = on;
SELECT * FROM lion_gj_explain('SELECT d.grp, count(*) FROM lion_gj_d d WHERE EXISTS (SELECT 1 FROM lion_gj_f1 f1 WHERE f1.fk = d.pk AND f1.kind IN (''a'', ''b'') AND f1.tags && ''{u2}'') AND EXISTS (SELECT 1 FROM lion_gj_f2 f2 WHERE f2.fk = d.pk AND f2.id % 3 = 0) GROUP BY d.grp');
                              lion_gj_explain                               
----------------------------------------------------------------------------
