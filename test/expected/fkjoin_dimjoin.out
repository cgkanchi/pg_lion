-- ---- 8. the cost model -----------------------------------------------------------
/*
 * Nothing disabled.  A fact counted against a few rows of the joined
 * dimension is the node's: f2 against sixty dimension rows semi-joined to
 * f1.  The whole dimension against both facts unfiltered, where every
 * dimension row would be looked up, is an ordinary join's: two hashed semi
 * joins.
 */
RESET enable_hashjoin;
RESET enable_mergejoin;
RESET enable_nestloop;
SET max_parallel_workers_per_gather = 0;
SELECT lion_gj_pick('SELECT count(*) FROM lion_gj_f2 f2 WHERE f2.y < 12 AND f2.fk IN (SELECT d.pk FROM lion_gj_d d WHERE d.pk < 60 AND EXISTS (SELECT 1 FROM lion_gj_f1 f1 WHERE f1.fk = d.pk AND f1.kind = ''b''))') AS few_rows;
     few_rows      
-------------------
 the node, fact f2
(1 row)

SELECT lion_gj_pick('SELECT count(*) FROM lion_gj_d d WHERE EXISTS (SELECT 1 FROM lion_gj_f1 f1 WHERE f1.fk = d.pk) AND EXISTS (SELECT 1 FROM lion_gj_f2 f2 WHERE f2.fk = d.pk)') AS whole_dimension;
 whole_dimension 
-----------------
 ordinary plan
(1 row)

SET max_parallel_workers_per_gather = 2;
-- ---- 9. a dirty heap -----------------------------------------------------------
DELETE FROM lion_gj_f1 WHERE kind = 'a' AND id % 7 = 0;
UPDATE lion_gj_f1 SET x = 3 WHERE kind = 'b' AND id % 11 = 0;
UPDATE lion_gj_f1 SET fk = 1 + fk % 50 WHERE kind = 'c' AND id % 13 = 0;
DELETE FROM lion_gj_f2 WHERE id % 17 = 0;
UPDATE lion_gj_f2 SET fk = 1 + fk % 70 WHERE id % 19 = 0;
UPDATE lion_gj_f2 SET y = 5 WHERE id % 23 = 0;
DELETE FROM lion_gj_d WHERE pk % 97 = 0;
UPDATE lion_gj_n SET k = k + 1 WHERE k % 31 = 0;
SELECT lion_gj('SELECT count(*) FROM lion_gj_d d WHERE d.region = ''eu'' AND EXISTS (SELECT 1 FROM lion_gj_f1 f1 WHERE f1.fk = d.pk AND ((f1.kind = ''a'' AND f1.tags && ''{t1}'') OR (f1.kind = ''b'' AND f1.x = 3) OR f1.kind = ''c'') AND f1.ts >= now() - interval ''120 days'') AND EXISTS (SELECT 1 FROM lion_gj_f2 f2 WHERE f2.fk = d.pk AND f2.id % 3 = 0)', 'fact');
