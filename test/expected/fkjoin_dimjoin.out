-- FK-side join pushdown whose DIMENSION is a join (DESIGN.md §27, "A
-- dimension that is a join").
--
-- The dimension is one base table that carries the key, and other tables
-- joined to it only as the inner side of semi and anti joins (EXISTS, IN, NOT
-- EXISTS), which never repeat its rows.  The node's child is then core's plan
-- of that join, and the fact is any other table of the query that qualifies
-- as one: a dimension with an EXISTS on each of two facts is either fact
-- counted against the dimension semi-joined to the other.  Every answer is
-- checked against the same query run serially through the pushdown, and with
-- the pushdown off and sequential scans only.
\set VERBOSITY terse
SET client_min_messages = warning;
LOAD 'pg_lion';
CREATE EXTENSION IF NOT EXISTS pg_lion;
-- VACUUM can only set all-visible once the commit record is on disk
SET synchronous_commit = on;
SET default_statistics_target = 1000;
-- parallel plans at any size; the suite's own setting is 0, and lion_gj()
-- runs every query serially as well
SET max_parallel_workers_per_gather = 2;
SET parallel_setup_cost = 0;
SET parallel_tuple_cost = 0;
SET min_parallel_table_scan_size = 0;
SET min_parallel_index_scan_size = 0;
SET parallel_leader_participation = off;
/*
 * lion_gj() runs a query through the pushdown with every join method
 * disabled (but hash joins, when lion.gj_hash is on), so that the node is
 * exercised wherever it has a path: once as
 * planned - in parallel, when the plan says so - once with
 * max_parallel_workers_per_gather at 0, and once with the pushdown off and
 * sequential scans only.  It compares both of the first two with the third
 * and says whether the first was pushed down.  Which table was the fact, and
 * whether the plan was parallel, it says only when asked (`show` 'fact' or
 * 'plan'): with two facts that qualify, and between the serial node and the
 * parallel one, the choice follows core's price of the joined dimension's
 * own plan, which is not the same on every major (PostgreSQL 18 has right
 * semi joins, 16 does not), so it is asked where the query leaves no choice
 * or a setting makes it.
 */
CREATE FUNCTION lion_gj(q text, show text DEFAULT '') RETURNS text
LANGUAGE plpgsql AS $$
DECLARE
	ln text;
	how text := 'not pushed down';
	fact text := '';
	nrows bigint;
	ndiff bigint;
	sdiff bigint;
BEGIN
	IF coalesce(current_setting('lion.gj_hash', true), '') <> 'on' THEN
		PERFORM set_config('enable_hashjoin', 'off', true);
	END IF;
	PERFORM set_config('enable_mergejoin', 'off', true);
	PERFORM set_config('enable_nestloop', 'off', true);
	PERFORM set_config('pg_lion.enable_count_pushdown', 'on', true);
	FOR ln IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP
		IF ln LIKE '%Parallel Custom Scan (LionCount)%' THEN
			how := 'parallel';
		ELSIF ln LIKE '%Custom Scan (LionCount)%' AND how <> 'parallel' THEN
			how := 'serial';
		ELSIF ln LIKE '%Partitions: lion_gj_f1%' THEN
			fact := ', fact f1';
		ELSIF ln LIKE '%Lion Indexes: lion_gj_f2%' THEN
			fact := ', fact f2';
		ELSIF ln LIKE '%Lion Indexes: lion_gj_f3%' THEN
			fact := ', fact f3';
		END IF;
	END LOOP;
	EXECUTE format('CREATE TEMP TABLE lion_gj_par AS SELECT s::text AS r FROM (%s) s', q);

	PERFORM set_config('max_parallel_workers_per_gather', '0', true);
	EXECUTE format('CREATE TEMP TABLE lion_gj_ser AS SELECT s::text AS r FROM (%s) s', q);

	PERFORM set_config('pg_lion.enable_count_pushdown', 'off', true);
	PERFORM set_config('enable_hashjoin', 'on', true);
	PERFORM set_config('enable_mergejoin', 'on', true);
	PERFORM set_config('enable_nestloop', 'on', true);
	PERFORM set_config('enable_bitmapscan', 'off', true);
	PERFORM set_config('enable_indexscan', 'off', true);
	PERFORM set_config('enable_indexonlyscan', 'off', true);
	EXECUTE format('CREATE TEMP TABLE lion_gj_off AS SELECT s::text AS r FROM (%s) s', q);
	PERFORM set_config('enable_bitmapscan', 'on', true);
	PERFORM set_config('enable_indexscan', 'on', true);
	PERFORM set_config('enable_indexonlyscan', 'on', true);
	PERFORM set_config('pg_lion.enable_count_pushdown', 'on', true);
	PERFORM set_config('max_parallel_workers_per_gather', '2', true);

	EXECUTE 'SELECT count(*) FROM lion_gj_par' INTO nrows;
	EXECUTE 'SELECT (SELECT count(*) FROM (SELECT * FROM lion_gj_par EXCEPT ALL SELECT * FROM lion_gj_off) a)'
			' + (SELECT count(*) FROM (SELECT * FROM lion_gj_off EXCEPT ALL SELECT * FROM lion_gj_par) b)'
		INTO ndiff;
	EXECUTE 'SELECT (SELECT count(*) FROM (SELECT * FROM lion_gj_ser EXCEPT ALL SELECT * FROM lion_gj_off) a)'
			' + (SELECT count(*) FROM (SELECT * FROM lion_gj_off EXCEPT ALL SELECT * FROM lion_gj_ser) b)'
		INTO sdiff;
	EXECUTE 'DROP TABLE lion_gj_par, lion_gj_ser, lion_gj_off';

	IF ndiff <> 0 OR sdiff <> 0 THEN
		RETURN format('MISMATCH: %s rows differ in parallel, %s serially', ndiff, sdiff);
	END IF;
	IF how = 'not pushed down' OR show <> 'fact' THEN
		fact := '';
	END IF;
	IF how <> 'not pushed down' AND show <> 'plan' THEN
		how := 'pushed down';
	END IF;
	RETURN format('%s%s, %s rows', how, fact, nrows);
END $$;
/* The answer itself, joins disabled: to pin a value, not only an agreement. */
CREATE FUNCTION lion_gj_val(q text) RETURNS SETOF text
LANGUAGE plpgsql AS $$
BEGIN
	PERFORM set_config('enable_hashjoin', 'off', true);
	PERFORM set_config('enable_mergejoin', 'off', true);
	PERFORM set_config('enable_nestloop', 'off', true);
	RETURN QUERY EXECUTE format('SELECT s::text FROM (%s) s', q);
END $$;
/*
 * The node and what is above it, joins disabled, with the dimension's own plan
 * as one line: that plan is whatever each major makes of a small join, and
 * what matters is that it is one.
 */
CREATE FUNCTION lion_gj_explain(q text) RETURNS SETOF text
LANGUAGE plpgsql AS $$
DECLARE
	ln text;
	seen boolean := false;
	child text := NULL;
	isjoin boolean := false;
BEGIN
	IF coalesce(current_setting('lion.gj_hash', true), '') <> 'on' THEN
		PERFORM set_config('enable_hashjoin', 'off', true);
	END IF;
	PERFORM set_config('enable_mergejoin', 'off', true);
	PERFORM set_config('enable_nestloop', 'off', true);
	FOR ln IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP
		CONTINUE WHEN ln ~ '^\s*Disabled: true$';
		IF child IS NOT NULL THEN
			IF ln ~ '(Join|Nested Loop)' THEN
				isjoin := true;
			END IF;
			CONTINUE;
		END IF;
		IF seen AND ln ~ '^\s*->' THEN
			child := ln;
			isjoin := ln ~ '(Join|Nested Loop)';
			CONTINUE;
		END IF;
		IF ln LIKE '%Custom Scan (LionCount)%' THEN
			seen := true;
		END IF;
		RETURN NEXT ln;
	END LOOP;
	IF child IS NOT NULL THEN
		RETURN NEXT regexp_replace(child, '->.*$',
								   CASE WHEN isjoin THEN '->  (the dimension''s plan: a join)'
										ELSE '->  (the dimension''s plan: a scan)' END);
	END IF;
END $$;
/* Which plan the cost model picks with nothing disabled, and its fact. */
CREATE FUNCTION lion_gj_pick(q text) RETURNS text
LANGUAGE plpgsql AS $$
DECLARE
	ln text;
	how text := 'ordinary plan';
BEGIN
	FOR ln IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP
		IF ln LIKE '%Custom Scan (LionCount)%' THEN
			how := 'the node';
		ELSIF how = 'the node' AND ln LIKE '%Partitions: lion_gj_f1%' THEN
			how := 'the node, fact f1';
		ELSIF how = 'the node' AND ln LIKE '%Lion Indexes: lion_gj_f2%' THEN
			how := 'the node, fact f2';
		END IF;
	END LOOP;
	RETURN how;
END $$;
/* Whether the plan, every join disabled, is the parallel node. */
CREATE FUNCTION lion_gj_parallel(q text) RETURNS boolean
LANGUAGE plpgsql AS $$
DECLARE
	ln text;
BEGIN
	PERFORM set_config('enable_hashjoin', 'off', true);
	PERFORM set_config('enable_mergejoin', 'off', true);
	PERFORM set_config('enable_nestloop', 'off', true);
	FOR ln IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP
		IF ln LIKE '%Parallel Custom Scan (LionCount)%' THEN
			RETURN true;
		END IF;
	END LOOP;
	RETURN false;
END $$;
/* One counter of the node's EXPLAIN ANALYZE output, joins disabled. */
CREATE FUNCTION lion_gj_counter(q text, counter text) RETURNS bigint
LANGUAGE plpgsql AS $$
DECLARE
	ln text;
	val bigint;
BEGIN
	PERFORM set_config('enable_hashjoin', 'off', true);
	PERFORM set_config('enable_mergejoin', 'off', true);
	PERFORM set_config('enable_nestloop', 'off', true);
	FOR ln IN EXECUTE 'EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF) ' || q LOOP
		IF btrim(split_part(ln, ':', 1)) = counter THEN
			val := btrim(split_part(ln, ':', 2))::bigint;
		END IF;
	END LOOP;
	RETURN val;
END $$;
/*
 * Every column below is drawn from its own hash of the row number
 * (lion_gj_h()), so that no two of them - a filter of one fact, the key, a
 * dimension filter - line up by the arithmetic of the row numbers, and every
 * answer has rows to count.
 */
CREATE FUNCTION lion_gj_h(i int8, seed int8) RETURNS int8
LANGUAGE sql IMMUTABLE PARALLEL SAFE
AS 'SELECT hashint8extended(i, seed) & 9223372036854775807';
/*
 * The dimension: 3000 rows over some twenty pages, so that two workers both
 * have a share, int8 primary key 1..3000, attr 0..6 with NULL on every 13th,
 * a small int, a region and a group.
 */
CREATE TABLE lion_gj_d (
	pk		int8	PRIMARY KEY,
	attr	int,
	small	int2,
	region	text	NOT NULL,
	grp		text	NOT NULL
) WITH (parallel_workers = 2);
INSERT INTO lion_gj_d
SELECT i, CASE WHEN i % 13 = 0 THEN NULL ELSE lion_gj_h(i, 1) % 7 END,
	   (lion_gj_h(i, 2) % 5)::int2,
	   (ARRAY['eu', 'us', 'ap'])[1 + (lion_gj_h(i, 3) % 3)::int], 'g' || lion_gj_h(i, 4) % 4
  FROM generate_series(1, 3000) i;
CREATE INDEX lion_gj_d_rg ON lion_gj_d USING lion (region, grp);
/*
 * A second dimension over 1,500 keys, duplicated, with NULL keys and no
 * uniqueness.
 */
CREATE TABLE lion_gj_n (
	k		int8,
	attr	int,
	region	text	NOT NULL
) WITH (parallel_workers = 2);
INSERT INTO lion_gj_n
SELECT CASE WHEN i % 29 = 0 THEN NULL ELSE 1 + lion_gj_h(i, 11) % 1500 END,
	   lion_gj_h(i, 12) % 5,
	   (ARRAY['eu', 'us', 'ap'])[1 + (lion_gj_h(i, 13) % 3)::int]
  FROM generate_series(1, 3000) i;
/*
 * f1: 40000 rows LIST-partitioned by kind, which no lion index covers - 'a'
 * sub-partitioned by range on ts, 'b' alone, 'c' and 'd' together, and a
 * default partition for the rest, NULL kind included.  ts is a day in the
 * last sixty or between 180 and 780 days back, so that `ts >= now() -
 * interval '120 days'`, a stable range, keeps the recent third whatever the
 * day; the sub-partitions of 'a' are cut 150 days back.  fk runs over
 * 1..3600, a third of the rows on keys 1..60, NULL on every 40th row: keys
 * 3001..3600 join no dimension row.  One
 * partitioned lion index on (tags, ts, fk), x has one of its own, and the
 * partition of 'c' and 'd' one on kind, which its bounds do not decide.
 */
CREATE TABLE lion_gj_f1 (
	id		int		NOT NULL,
	kind	text,
	fk		int8,
	x		int		NOT NULL,
	tags	text[],
	ts		timestamptz NOT NULL
) PARTITION BY LIST (kind);
CREATE TABLE lion_gj_f1_a PARTITION OF lion_gj_f1 FOR VALUES IN ('a')
	PARTITION BY RANGE (ts);
DO $$
BEGIN
	EXECUTE format('CREATE TABLE lion_gj_f1_a_old PARTITION OF lion_gj_f1_a FOR VALUES FROM (%L) TO (%L)',
				   date_trunc('day', now()) - interval '3000 days',
				   date_trunc('day', now()) - interval '150 days');
	EXECUTE format('CREATE TABLE lion_gj_f1_a_new PARTITION OF lion_gj_f1_a FOR VALUES FROM (%L) TO (%L)',
				   date_trunc('day', now()) - interval '150 days',
				   date_trunc('day', now()) + interval '30 days');
END $$;
CREATE TABLE lion_gj_f1_b PARTITION OF lion_gj_f1 FOR VALUES IN ('b');
CREATE TABLE lion_gj_f1_cd PARTITION OF lion_gj_f1 FOR VALUES IN ('c', 'd');
CREATE TABLE lion_gj_f1_def PARTITION OF lion_gj_f1 DEFAULT;
INSERT INTO lion_gj_f1
SELECT i,
	   CASE lion_gj_h(i, 21) % 10 WHEN 0 THEN 'a' WHEN 1 THEN 'a' WHEN 2 THEN 'a'
				   WHEN 3 THEN 'b' WHEN 4 THEN 'b' WHEN 5 THEN 'c'
				   WHEN 6 THEN 'd' WHEN 7 THEN 'e' WHEN 8 THEN NULL ELSE 'b' END,
	   CASE WHEN i % 40 = 0 THEN NULL
			WHEN lion_gj_h(i, 22) % 3 = 0 THEN 1 + lion_gj_h(i, 23) % 60
			ELSE 1 + lion_gj_h(i, 23) % 3600 END,
	   lion_gj_h(i, 24) % 10,
	   ARRAY['t' || lion_gj_h(i, 25) % 11, 'u' || lion_gj_h(i, 26) % 7],
	   date_trunc('day', now()) -
	   (CASE WHEN lion_gj_h(i, 27) % 3 = 0 THEN lion_gj_h(i, 28) % 60
			 ELSE 180 + lion_gj_h(i, 28) % 600 END) * interval '1 day'
  FROM generate_series(1, 40000) i;
CREATE INDEX lion_gj_f1_tsf ON lion_gj_f1 USING lion (tags, ts, fk);
CREATE INDEX lion_gj_f1_x ON lion_gj_f1 USING lion (x);
CREATE INDEX lion_gj_f1_cd_kind ON lion_gj_f1_cd USING lion (kind);
/*
 * f2: 30000 rows of a plain table, fk over 1..3300, NULL on every 37th row
 * and no row for the keys that are multiples of 19, a tsvector of two lexemes
 * and y 0..12; lion indexes on (doc, fk) and on y.
 */
CREATE TABLE lion_gj_f2 (
	id		int		NOT NULL,
	fk		int8,
	doc		tsvector,
	y		int		NOT NULL
) WITH (parallel_workers = 2);
INSERT INTO lion_gj_f2
SELECT i,
	   CASE WHEN i % 37 = 0 THEN NULL
			WHEN (1 + lion_gj_h(i, 31) % 3300) % 19 = 0 THEN NULL
			ELSE 1 + lion_gj_h(i, 31) % 3300 END,
	   array_to_tsvector(ARRAY['w' || lion_gj_h(i, 32) % 17, 'v' || lion_gj_h(i, 33) % 5]),
	   lion_gj_h(i, 34) % 13
  FROM generate_series(1, 30000) i;
CREATE INDEX lion_gj_f2_df ON lion_gj_f2 USING lion (doc, fk);
CREATE INDEX lion_gj_f2_y ON lion_gj_f2 USING lion (y);
/* f3: a third fact, 20000 rows, fk over 1..3000, z 0..6 */
CREATE TABLE lion_gj_f3 (
	fk		int8,
	z		int		NOT NULL
);
INSERT INTO lion_gj_f3
SELECT 1 + lion_gj_h(i, 41) % 3000, lion_gj_h(i, 42) % 7 FROM generate_series(1, 20000) i;
CREATE INDEX lion_gj_f3_fk ON lion_gj_f3 USING lion (fk);
CREATE INDEX lion_gj_f3_z ON lion_gj_f3 USING lion (z);
VACUUM (FREEZE, ANALYZE) lion_gj_d;
VACUUM (FREEZE, ANALYZE) lion_gj_n;
VACUUM (FREEZE, ANALYZE) lion_gj_f1;
VACUUM (FREEZE, ANALYZE) lion_gj_f2;
VACUUM (FREEZE, ANALYZE) lion_gj_f3;
-- ---- 1. the plans --------------------------------------------------------------
-- serially: which is cheaper, the node or the parallel node, is section 5's
SET max_parallel_workers_per_gather = 0;
-- (A) a dimension semi-joined to two facts: f2 counted against the dimension
-- semi-joined to f1, which is the node's child; f1's filter is one no posting
-- set answers, so f2 is the only fact there can be
SELECT * FROM lion_gj_explain('SELECT count(*) FROM lion_gj_d d WHERE d.region = ''eu'' AND EXISTS (SELECT 1 FROM lion_gj_f1 f1 WHERE f1.fk = d.pk AND f1.id % 3 = 0) AND EXISTS (SELECT 1 FROM lion_gj_f2 f2 WHERE f2.fk = d.pk AND f2.doc @@ ''w3 | w5'')');
                                              lion_gj_explain                                              
-----------------------------------------------------------------------------------------------------------
 Finalize Aggregate
   ->  Custom Scan (LionCount)
         Lion Indexes: lion_gj_f2_df.fk (fk = d.pk), lion_gj_f2_df.doc (doc @@ '''w3'' | ''w5'''::tsquery)
         Join Type: Semi
         Join Key Lookups: in index order
         Fact Filters: collected once
         ->  (the dimension's plan: a join)
(7 rows)

-- ... and the other way round: f1 counted against the dimension semi-joined
-- to f2, partition by partition, with a filter per kind ORed and a stable
-- range
SELECT * FROM lion_gj_explain('SELECT count(*) FROM lion_gj_d d WHERE d.region = ''eu'' AND EXISTS (SELECT 1 FROM lion_gj_f1 f1 WHERE f1.fk = d.pk AND ((f1.kind = ''a'' AND f1.tags && ''{t1}'') OR (f1.kind = ''b'' AND f1.x = 3) OR f1.kind = ''c'') AND f1.ts >= now() - interval ''120 days'') AND EXISTS (SELECT 1 FROM lion_gj_f2 f2 WHERE f2.fk = d.pk AND f2.id % 3 = 0)');
                                                                                               lion_gj_explain                                                                                               
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Finalize Aggregate
   ->  Custom Scan (LionCount)
         Partitions: lion_gj_f1_a_old, lion_gj_f1_a_new, lion_gj_f1_b, lion_gj_f1_cd
         Lion Indexes: (fk = d.pk), (((kind = 'a'::text) AND (tags && '{t1}'::text[])) OR ((kind = 'b'::text) AND (x = 3)) OR (kind = 'c'::text)), (ts >= (now() - '@ 120 days'::interval))
         Implied by Partition Bounds: (kind = 'a'::text) in 2 of 4 partitions, (kind = 'b'::text) in 1 of 4 partitions
         Refuted by Partition Bounds: ((kind = 'a'::text) AND (tags && '{t1}'::text[])) in 2 of 4 partitions, ((kind = 'b'::text) AND (x = 3)) in 3 of 4 partitions, (kind = 'c'::text) in 3 of 4 partitions
         Join Type: Semi
         Join Key Lookups: in index order
         Fact Filters: collected once
         ->  (the dimension's plan: a join)
(10 rows)

-- (B) a fact counted against a dimension narrowed by a semi join to another
-- fact: the forward semi join over a key the primary key proves unique, which
-- is the inner join over the joined dimension
SELECT * FROM lion_gj_explain('SELECT count(*) FROM lion_gj_f2 f2 WHERE f2.doc @@ ''w3 | w5'' AND f2.fk IN (SELECT d.pk FROM lion_gj_d d WHERE d.region = ''eu'' AND EXISTS (SELECT 1 FROM lion_gj_f1 f1 WHERE f1.fk = d.pk AND f1.kind = ''a'' AND f1.ts >= now() - interval ''120 days''))');
                                              lion_gj_explain                                              
-----------------------------------------------------------------------------------------------------------
 Finalize Aggregate
   ->  Custom Scan (LionCount)
         Lion Indexes: lion_gj_f2_df.fk (fk = d.pk), lion_gj_f2_df.doc (doc @@ '''w3'' | ''w5'''::tsquery)
         Join Key Lookups: in index order
         Fact Filters: collected once
         ->  (the dimension's plan: a join)
(6 rows)

-- ... over the non-unique dimension, whose keys the node makes distinct
SELECT * FROM lion_gj_explain('SELECT count(*) FROM lion_gj_f2 f2 WHERE f2.y = 5 AND f2.fk IN (SELECT n.k FROM lion_gj_n n WHERE n.attr < 3 AND EXISTS (SELECT 1 FROM lion_gj_f1 f1 WHERE f1.fk = n.k AND f1.kind = ''b''))');
                             lion_gj_explain                             
-------------------------------------------------------------------------
 Finalize Aggregate
   ->  Custom Scan (LionCount)
         Lion Indexes: lion_gj_f2_df.fk (fk = n.k), lion_gj_f2_y (y = 5)
         Join Type: Semi
         Join Keys: distinct, sorted
         Join Key Lookups: in index order
         Fact Filters: collected once
         ->  (the dimension's plan: a join)
(8 rows)

-- an anti join inside the dimension
SELECT * FROM lion_gj_explain('SELECT count(*) FROM lion_gj_d d WHERE NOT EXISTS (SELECT 1 FROM lion_gj_f1 f1 WHERE f1.fk = d.pk AND f1.id % 3 = 0) AND EXISTS (SELECT 1 FROM lion_gj_f2 f2 WHERE f2.fk = d.pk AND f2.y = 5)');
                             lion_gj_explain                              
--------------------------------------------------------------------------
 Finalize Aggregate
   ->  Custom Scan (LionCount)
         Lion Indexes: lion_gj_f2_df.fk (fk = d.pk), lion_gj_f2_y (y = 5)
         Join Type: Semi
         Join Key Lookups: in index order
         Fact Filters: collected once
         ->  (the dimension's plan: a join)
(7 rows)

-- the anti join as the node's: the dimension semi-joined to f2 and anti-joined to f1
SELECT * FROM lion_gj_explain('SELECT count(*) FROM lion_gj_d d WHERE NOT EXISTS (SELECT 1 FROM lion_gj_f1 f1 WHERE f1.fk = d.pk AND f1.kind = ''b'' AND f1.x = 3) AND EXISTS (SELECT 1 FROM lion_gj_f2 f2 WHERE f2.fk = d.pk AND f2.id % 3 = 0)');
                     lion_gj_explain                     
---------------------------------------------------------
 Finalize Aggregate
   ->  Custom Scan (LionCount)
         Partitions: lion_gj_f1_b
         Lion Indexes: (fk = d.pk), (x = 3)
         Implied by Partition Bounds: (kind = 'b'::text)
         Join Type: Anti
         Join Key Lookups: in index order
         ->  (the dimension's plan: a join)
(8 rows)

-- an inner join over the joined dimension, grouped by a dimension column
SELECT * FROM lion_gj_explain('SELECT d.attr, count(*) FROM lion_gj_f2 f2 JOIN lion_gj_d d ON f2.fk = d.pk WHERE f2.y = 5 AND EXISTS (SELECT 1 FROM lion_gj_f1 f1 WHERE f1.fk = d.pk AND f1.id % 3 = 0) GROUP BY d.attr');
                             lion_gj_explain                              
--------------------------------------------------------------------------
 Finalize HashAggregate
   Group Key: d.attr
   ->  Custom Scan (LionCount)
         Lion Indexes: lion_gj_f2_df.fk (fk = d.pk), lion_gj_f2_y (y = 5)
         Join Key Lookups: in index order
         Fact Filters: collected once
         ->  (the dimension's plan: a join)
(7 rows)

-- grouped by the key: each row a group of its own, as over one table
SELECT * FROM lion_gj_explain('SELECT d.pk, count(*) FROM lion_gj_f2 f2 JOIN lion_gj_d d ON f2.fk = d.pk WHERE f2.y = 5 AND EXISTS (SELECT 1 FROM lion_gj_f1 f1 WHERE f1.fk = d.pk AND f1.id % 3 = 0) GROUP BY d.pk');
                             lion_gj_explain                              
--------------------------------------------------------------------------
 Finalize GroupAggregate
   Group Key: d.pk
   ->  Custom Scan (LionCount)
         Lion Indexes: lion_gj_f2_df.fk (fk = d.pk), lion_gj_f2_y (y = 5)
         Join Key Lookups: in index order
         Fact Filters: collected once
         ->  (the dimension's plan: a join)
(7 rows)

-- the rows with their counts, below a LionJoinAgg
SELECT * FROM lion_gj_explain('SELECT count(DISTINCT d.attr), count(*), max(d.grp) FROM lion_gj_f2 f2 JOIN lion_gj_d d ON f2.fk = d.pk WHERE f2.y = 5 AND EXISTS (SELECT 1 FROM lion_gj_f1 f1 WHERE f1.fk = d.pk AND f1.id % 3 = 0)');
                                   lion_gj_explain                                    
--------------------------------------------------------------------------------------
 Custom Scan (LionJoinAgg)
   ->  Aggregate
         ->  Sort
               Sort Key: d.attr
               ->  Custom Scan (LionCount)
                     Lion Indexes: lion_gj_f2_df.fk (fk = d.pk), lion_gj_f2_y (y = 5)
                     Join Key Lookups: in index order
                     Join Rows: the dimension rows with a match, each with its count
                     Fact Filters: collected once
                     ->  (the dimension's plan: a join)
(10 rows)

SET max_parallel_workers_per_gather = 2;
-- ---- 2. the answers ------------------------------------------------------------
-- (A), with each fact the only one there can be, and with both, the cheaper
-- taken
