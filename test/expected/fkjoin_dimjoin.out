/*
 * The Gather started again for every outer row, the node, its joined child
 * and the fact filters' copy with it; the answers do not change.
 */
SET enable_material = off;
SET enable_memoize = off;
SELECT lion_gj('SELECT g, s.c FROM generate_series(1, 3) g LEFT JOIN (SELECT count(*) AS c FROM lion_gj_d d WHERE EXISTS (SELECT 1 FROM lion_gj_f1 f1 WHERE f1.fk = d.pk AND f1.kind IN (''a'', ''b'') AND f1.tags && ''{t1,u1}'') AND EXISTS (SELECT 1 FROM lion_gj_f2 f2 WHERE f2.fk = d.pk AND f2.id % 3 = 0)) s ON s.c > g', 'plan');
     lion_gj      
------------------
 parallel, 3 rows
(1 row)

RESET enable_material;
RESET enable_memoize;
RESET lion.gj_hash;
/*
 * The forward semi join over the non-unique dimension runs the joined
 * dimension whole in every participant and divides its distinct keys.  It
 * competes with nothing but the serial node here, with every join disabled
 * and a count priced high enough to make dividing the keys worth it - which
 * before PostgreSQL 18 is the tie above, and serial; the answers are checked
 * either way.  A volatile qual inside the joined dimension - of the table
 * semi-joined to it, not of its own table - keeps it serial on every major:
 * every participant must see the same rows (an EXISTS with one is not made a
 * semi join at all; an IN is).
 */
SET pg_lion.fkjoin_count_cost = 1000;
SET pg_lion.fkjoin_copy_count_cost = 1000;
CREATE FUNCTION lion_gj_vol(int) RETURNS int LANGUAGE plpgsql VOLATILE PARALLEL SAFE
	AS 'BEGIN RETURN $1; END';
SELECT lion_gj('SELECT count(*) FROM lion_gj_f2 f2 WHERE f2.y < 12 AND f2.fk IN (SELECT n.k FROM lion_gj_n n WHERE n.attr < 1 AND n.k IN (SELECT f3.fk FROM lion_gj_f3 f3 WHERE f3.z = 1))');
       lion_gj       
---------------------
 pushed down, 1 rows
(1 row)

SELECT lion_gj_parallel('SELECT count(*) FROM lion_gj_f2 f2 WHERE f2.y < 12 AND f2.fk IN (SELECT n.k FROM lion_gj_n n WHERE n.attr < 1 AND n.k IN (SELECT f3.fk FROM lion_gj_f3 f3 WHERE f3.z = 1))')
	   OR current_setting('server_version_num')::int < 180000 AS parallel_from_18;
 parallel_from_18 
------------------
 t
(1 row)

SELECT lion_gj('SELECT count(*) FROM lion_gj_f2 f2 WHERE f2.y < 12 AND f2.fk IN (SELECT n.k FROM lion_gj_n n WHERE n.attr < 1 AND n.k IN (SELECT f3.fk FROM lion_gj_f3 f3 WHERE f3.z = lion_gj_vol(1)))', 'plan');
    lion_gj     
----------------
 serial, 1 rows
(1 row)

SET max_parallel_workers_per_gather = 0;
SELECT lion_gj_counter('SELECT count(*) FROM lion_gj_f2 f2 WHERE f2.y < 12 AND f2.fk IN (SELECT n.k FROM lion_gj_n n WHERE n.attr < 1 AND n.k IN (SELECT f3.fk FROM lion_gj_f3 f3 WHERE f3.z = 1))', 'Join Keys Looked Up') =
	   (SELECT count(DISTINCT n.k) FROM lion_gj_n n WHERE n.attr < 1 AND n.k IN (SELECT f3.fk FROM lion_gj_f3 f3 WHERE f3.z = 1)) AS distinct_keys;
 distinct_keys 
---------------
 t
(1 row)

SET max_parallel_workers_per_gather = 2;
RESET pg_lion.fkjoin_count_cost;
RESET pg_lion.fkjoin_copy_count_cost;
-- ---- 6. generic plans and rescans ------------------------------------------------
-- Params in the fact filters, the dimension's and the other fact's, a NULL one
-- too
PREPARE lion_gj_q(int, text, int) AS
	SELECT d.grp, count(*) FROM lion_gj_d d
	 WHERE d.region = $2
	   AND EXISTS (SELECT 1 FROM lion_gj_f1 f1 WHERE f1.fk = d.pk AND f1.x = $3 AND f1.id % 3 = 0)
	   AND EXISTS (SELECT 1 FROM lion_gj_f2 f2 WHERE f2.fk = d.pk AND f2.y = $1)
	 GROUP BY d.grp;
SET plan_cache_mode = force_generic_plan;
SET max_parallel_workers_per_gather = 0;
SELECT * FROM lion_gj_explain('EXECUTE lion_gj_q(5, ''eu'', 3)');
                              lion_gj_explain                              
---------------------------------------------------------------------------
 Finalize HashAggregate
   Group Key: d.grp
   ->  Custom Scan (LionCount)
         Lion Indexes: lion_gj_f2_df.fk (fk = d.pk), lion_gj_f2_y (y = $1)
         Join Type: Semi
         ->  (the dimension's plan: a join)
(6 rows)

CREATE TEMP TABLE lion_gj_g1 AS EXECUTE lion_gj_q(5, 'eu', 3);
CREATE TEMP TABLE lion_gj_g2 AS EXECUTE lion_gj_q(NULL, 'eu', 3);
CREATE TEMP TABLE lion_gj_g3 AS EXECUTE lion_gj_q(5, 'eu', NULL);
PREPARE lion_gj_r(int) AS
	SELECT count(*) FROM lion_gj_f2 f2 WHERE f2.y = $1
	   AND f2.fk IN (SELECT d.pk FROM lion_gj_d d WHERE EXISTS (SELECT 1 FROM lion_gj_f1 f1 WHERE f1.fk = d.pk AND f1.kind = 'b'));
SELECT * FROM lion_gj_explain('EXECUTE lion_gj_r(5)');
                              lion_gj_explain                              
---------------------------------------------------------------------------
 Finalize Aggregate
   ->  Custom Scan (LionCount)
         Lion Indexes: lion_gj_f2_df.fk (fk = d.pk), lion_gj_f2_y (y = $1)
         Join Key Lookups: in index order
         Fact Filters: collected once
         ->  (the dimension's plan: a join)
(6 rows)

CREATE TEMP TABLE lion_gj_g4 AS EXECUTE lion_gj_r(5);
CREATE TEMP TABLE lion_gj_g5 AS EXECUTE lion_gj_r(NULL);
RESET plan_cache_mode;
SET pg_lion.enable_count_pushdown = off;
SELECT (SELECT count(*) FROM (TABLE lion_gj_g1 EXCEPT ALL
		SELECT d.grp, count(*) FROM lion_gj_d d
		 WHERE d.region = 'eu'
		   AND EXISTS (SELECT 1 FROM lion_gj_f1 f1 WHERE f1.fk = d.pk AND f1.x = 3 AND f1.id % 3 = 0)
		   AND EXISTS (SELECT 1 FROM lion_gj_f2 f2 WHERE f2.fk = d.pk AND f2.y = 5)
		 GROUP BY d.grp) a) AS diff,
	   (SELECT count(*) FROM lion_gj_g1) AS groups,
	   (SELECT count(*) FROM lion_gj_g2) AS null_fact_param_groups,
	   (SELECT count(*) FROM lion_gj_g3) AS null_dim_param_groups,
	   (SELECT count FROM lion_gj_g4) =
	   (SELECT count(*) FROM lion_gj_f2 f2 WHERE f2.y = 5
		   AND f2.fk IN (SELECT d.pk FROM lion_gj_d d WHERE EXISTS (SELECT 1 FROM lion_gj_f1 f1 WHERE f1.fk = d.pk AND f1.kind = 'b'))) AS forward_same,
	   (SELECT count FROM lion_gj_g5) AS null_param_count;
 diff | groups | null_fact_param_groups | null_dim_param_groups | forward_same | null_param_count 
------+--------+------------------------+-----------------------+--------------+------------------
    0 |      4 |                      0 |                     0 | t            |                0
(1 row)

RESET pg_lion.enable_count_pushdown;
DEALLOCATE lion_gj_q;
DEALLOCATE lion_gj_r;
SET max_parallel_workers_per_gather = 2;
-- correlated subqueries that rescan the node with a new filter of the fact,
-- of the joined dimension's other fact, and of the dimension
SELECT lion_gj('SELECT v.x, (SELECT count(*) FROM lion_gj_d d WHERE EXISTS (SELECT 1 FROM lion_gj_f1 f1 WHERE f1.fk = d.pk AND f1.id % 3 = 0) AND EXISTS (SELECT 1 FROM lion_gj_f2 f2 WHERE f2.fk = d.pk AND f2.y = v.x)) FROM (VALUES (1), (4), (8)) v(x)');
       lion_gj       
---------------------
