-- the readers of either layout, through one index
SET enable_seqscan = off;
SET enable_bitmapscan = off;
SELECT sum(id), count(pay), sum(grp), md5(string_agg(pay, ',' ORDER BY pay))
  FROM lion_st_mix WHERE tags @> ARRAY[3];
