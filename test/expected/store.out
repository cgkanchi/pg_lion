(1 row)

-- the TIDs come back, with other values
INSERT INTO lion_st_vac SELECT g, g % 5, 'again ' || g FROM generate_series(20001, 30000) g;
SELECT lion_st_mismatch('lion_st_vac_i', 'lion_st_vac', 'ARRAY[id::text, t]');
