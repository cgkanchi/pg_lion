(1 row)

DELETE FROM lion_st_mid WHERE (ctid::text::point)[0] = 5;
VACUUM lion_st_mid;
INSERT INTO lion_st_mid SELECT g, NULL FROM generate_series(2001, 2200) g;
SELECT count(*) > 35 AS refilled FROM lion_st_mid WHERE (ctid::text::point)[0] = 5;
