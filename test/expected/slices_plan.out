DROP FUNCTION slp_groups(text);
-- ---------- 7. the index's pages ----------
-- A scan of a sliced index's keys reads none of its slices, and the planner
-- prices it by the index's pages less the slices', estimated from their
-- entries' headers: as it prices the same index without slices, about.
-- (Counting the slices' pages, the range's scan here was priced 1.4 times
-- the unsliced index's, and the AND's 1.3.)
REINDEX INDEX slp_v;
NOTICE:  lion index "slp_v": columns "b", "c", "d", "t", "ts", "tz" have about one row per key
CREATE INDEX slp_v2 ON slp USING lion (a, b, c, d, t, ts, tz);
NOTICE:  lion index "slp_v2": columns "b", "c", "d", "t", "ts", "tz" have about one row per key
VACUUM ANALYZE slp;
-- The price of the bitmap index scan alone, of q with no other scan:
CREATE FUNCTION slp_cost(q text) RETURNS numeric LANGUAGE plpgsql AS $$
DECLARE j json;
BEGIN
	EXECUTE 'EXPLAIN (FORMAT JSON) ' || q INTO j;
	RETURN (j -> 0 -> 'Plan' -> 'Plans' -> 0 ->> 'Total Cost')::numeric;
END $$;
SET enable_seqscan = off;
SET enable_indexscan = off;
SET pg_lion.enable_count_pushdown = off;
BEGIN;
DROP INDEX slp_v2;
SELECT slp_cost('SELECT id FROM slp WHERE b = 15827') AS sliced_eq,
	   slp_cost('SELECT id FROM slp WHERE c > 0') AS sliced_range,
	   slp_cost('SELECT id FROM slp WHERE a IN (1, 2, 3) AND d > ''2000-01-01''') AS sliced_and \gset
ROLLBACK;
BEGIN;
DROP INDEX slp_v;
SELECT slp_cost('SELECT id FROM slp WHERE b = 15827') AS plain_eq,
	   slp_cost('SELECT id FROM slp WHERE c > 0') AS plain_range,
	   slp_cost('SELECT id FROM slp WHERE a IN (1, 2, 3) AND d > ''2000-01-01''') AS plain_and \gset
ROLLBACK;
SELECT round(:sliced_eq / :plain_eq, 1) AS eq, round(:sliced_range / :plain_range, 1) AS range,
	   round(:sliced_and / :plain_and, 1) AS "and";
 eq  | range | and 
-----+-------+-----
 1.0 |   1.0 | 1.0
(1 row)

RESET enable_seqscan;
RESET enable_indexscan;
RESET pg_lion.enable_count_pushdown;
DROP INDEX slp_v2;
DROP FUNCTION slp_cost(text);
