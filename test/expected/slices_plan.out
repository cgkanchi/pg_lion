-- EXECUTE on what the node replaces (DESIGN.md §9, "Privileges"): an
-- aggregate revoked is refused as the ordinary plan refuses it
CREATE ROLE regress_slp_user;
GRANT SELECT ON slp TO regress_slp_user;
REVOKE EXECUTE ON FUNCTION max(int4) FROM PUBLIC;
SET ROLE regress_slp_user;
SET enable_seqscan = off;
SET enable_bitmapscan = off;
SET pg_lion.enable_plain_scan = off;
EXPLAIN (COSTS OFF) SELECT sum(b), min(b) FROM slp WHERE g = 3;
                             QUERY PLAN                              
---------------------------------------------------------------------
 Custom Scan (LionCount)
   Lion Indexes: slp_g (g = 3)
   Aggregates From Slices: slp_v (b: every bit counted, min descent)
(3 rows)

SELECT sum(b), min(b) FROM slp WHERE g = 3;
  sum   |     min     
--------+-------------
 -18608 | -2147483648
(1 row)

SELECT sum(b), max(b) FROM slp WHERE g = 3;
ERROR:  permission denied for aggregate max
RESET enable_seqscan;
RESET enable_bitmapscan;
RESET pg_lion.enable_plain_scan;
RESET ROLE;
GRANT EXECUTE ON FUNCTION max(int4) TO PUBLIC;
REVOKE SELECT ON slp FROM regress_slp_user;
DROP ROLE regress_slp_user;
DROP TABLE slp, slp_dim, slp_part;
DROP FUNCTION slp_lim();
DROP FUNCTION slp_plan(text, bool);
DROP FUNCTION slp_q(text);
