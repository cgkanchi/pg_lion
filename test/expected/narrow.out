-- ---------- 6. summaries ----------
-- A summary (DESIGN.md §32) is a posting set like a key's, and takes
-- NARROWs the same way.  67 rows to a page at fillfactor 50 and three
-- container keys; v is scattered over 100 values, each an ARRAY at each key,
-- and the buckets close at 3200 rows: four of 25 values, each a NARROW of
-- width 2 at each key, 12 of 1032 bytes.  An UPDATE of the rows at offsets
-- 1 .. 63 of the first 64 pages puts their new versions at 68 .. 130, and
-- the four summaries' containers there widen to 3; VACUUM, once the rows
-- past 127 are deleted, narrows them to 2 again.
CREATE TABLE lion_ns (i int NOT NULL, v int2 NOT NULL, pad text)
	WITH (fillfactor = 50, autovacuum_enabled = off);
INSERT INTO lion_ns
	SELECT i, (i * 37) % 100, repeat('x', 20) FROM generate_series(0, 67 * 192 - 1) i;
CREATE INDEX lion_ns_v ON lion_ns USING lion (v) WITH (summaries = on, summary_tids = 3200);
VACUUM (FREEZE, ANALYZE) lion_ns;
SELECT lion_nr_maxoff('lion_ns') AS maxoff, lion_nr_version('lion_ns_v') AS version;
 maxoff | version 
--------+---------
     67 |       8
(1 row)

