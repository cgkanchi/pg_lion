(3 rows)

SELECT lion_nr_version('lion_nw_k') AS k, lion_nr_version('lion_nw_g') AS g,
	   lion_nr_version('lion_nw_c') AS c, lion_nr_version('lion_nw_kgc') AS kgc;
 k | g | c | kgc 
---+---+---+-----
