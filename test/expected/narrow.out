(1 row)

SELECT lion_index_verify('lion_nw_k', true);
 lion_index_verify 
-------------------
 
(1 row)

SELECT lion_index_verify('lion_nw_kgc', true);
 lion_index_verify 
-------------------
 
(1 row)

VACUUM ANALYZE lion_nw;
-- The same two-valued column on rows that fill a page 226 deep: its
-- containers have members at offsets 128 and above, so BITSETs, version 6.
CREATE TABLE lion_nn (i int NOT NULL, k int NOT NULL);
INSERT INTO lion_nn SELECT i, i % 2 FROM generate_series(0, 39999) i;
SELECT lion_nr_maxoff('lion_nn') AS maxoff;
 maxoff 
--------
    226
(1 row)

CREATE INDEX lion_nn_k ON lion_nn USING lion (k);
SELECT * FROM lion_nr_mix('lion_nn_k');
