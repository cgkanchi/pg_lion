(6 rows)

-- The widest: one int column, NULL in three rows of every four, packs some
-- 272 rows to a page, past offset 255 - a NARROW of width 5, the last, which
-- holds the offsets below 320.  Three container keys, at each of which NULL,
-- 0 and 1 are all three NARROWs of width 5.
CREATE TABLE lion_n272 (i int) WITH (autovacuum_enabled = off);
INSERT INTO lion_n272
	SELECT CASE n % 8 WHEN 0 THEN 0 WHEN 4 THEN 1 END FROM generate_series(0, 272 * 192 - 1) n;
CREATE INDEX lion_n272_i ON lion_n272 USING lion (i);
VACUUM (FREEZE, ANALYZE) lion_n272;
SELECT lion_nr_maxoff('lion_n272') AS maxoff, lion_nr_version('lion_n272_i') AS version;
 maxoff | version 
--------+---------
    272 |       8
(1 row)

SELECT * FROM lion_nr_mix('lion_n272_i');
 attno | containers | arrays | bitsets | runs | narrows | container_bytes | width 
-------+------------+--------+---------+------+---------+-----------------+-------
     1 |          9 |      0 |       0 |    0 |       9 |           23112 |     5
(1 row)

SELECT null_tids FROM lion_index_stats('lion_n272_i');
 null_tids 
-----------
     39168
(1 row)

SELECT lion_nr_verify('lion_n272_i');
 lion_nr_verify 
----------------
 ok
(1 row)

-- ---------- 2. reads, at every width ----------
-- A NARROW against itself, an ARRAY, the union of two and the complement of
-- one; bitmap scans, plain scans, the count pushdown and lion_index_count().
CREATE TABLE lion_nr_preds (ord int, how text, pred text);
INSERT INTO lion_nr_preds VALUES
	(1, 'bitmap', 'k = 1'), (2, 'bitmap', 'k = 1 AND g = 3'),
	(3, 'bitmap', 'k = 0 OR g = 3'), (4, 'bitmap', 'k IN (0, 1)'),
	(5, 'bitmap', 'k <> 1'), (6, 'bitmap', 'g = 3 AND k <> 0'),
	(7, 'plain', 'k = 1 AND g = 3'), (8, 'plain', 'k = 0 AND g IN (2, 4)');
CREATE TABLE lion_nr_counts (ord int, q text);
INSERT INTO lion_nr_counts VALUES
	(1, 'SELECT count(*) FROM %s WHERE k = 1'),
	(2, 'SELECT count(*) FROM %s WHERE k = 0 AND g = 6'),
	(3, 'SELECT count(*) FROM %s WHERE k <> 1 AND g IN (1, 2)'),
	(4, 'SELECT k, count(*) FROM %s GROUP BY k'),
	(5, 'SELECT g, count(*) FROM %s WHERE k = 1 GROUP BY g'),
	(6, 'SELECT k, count(*) FROM %s WHERE g <> 3 GROUP BY k');
SELECT t, p.how, p.pred, lion_nr_cmp(t, p.pred, p.how)
