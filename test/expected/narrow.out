-- NARROW containers (DESIGN.md §38).
--
-- A NARROW is a bitset of 64 heap blocks x 128 offsets, 1032 bytes against a
-- BITSET's 4104, for a container whose members all lie at offsets below 128.
-- Only the build and VACUUM's re-optimize choose one, and VACUUM only in an
-- index of format version 8, which a build writes only when it has written a
-- NARROW; an insert never makes one, and a member at offset 128 or more turns
-- one into a BITSET.  This file checks the format end to end: what the build
-- writes and the version it records, the in-place insert below offset 128
-- and the conversion at it, what VACUUM makes of each kind of index, and that
-- bitmap scans, lion_index_count() and the count pushdown agree with a
-- sequential scan at every step.  The damaged-NARROW cases are in
-- corrupt_items.sql.
\set VERBOSITY terse
SET client_min_messages = warning;
LOAD 'pg_lion';
-- VACUUM sets a page all-visible only once the commit record is on disk.
SET synchronous_commit = on;
CREATE EXTENSION IF NOT EXISTS pg_lion;
CREATE EXTENSION IF NOT EXISTS pageinspect;
RESET client_min_messages;
-- Bitmap scan versus sequential scan, as in sparse.sql.
CREATE FUNCTION lion_nr_cmp(tbl text, pred text) RETURNS text
LANGUAGE plpgsql AS $$
DECLARE
	q text := format('SELECT count(*) AS c, coalesce(sum(i), 0) AS s FROM %s WHERE %s', tbl, pred);
	a record;
	b record;
	ln text;
	used boolean := false;
BEGIN
	PERFORM set_config('enable_seqscan', 'off', true);
	PERFORM set_config('enable_indexscan', 'off', true);
	PERFORM set_config('pg_lion.enable_count_pushdown', 'off', true);
	FOR ln IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP
		IF ln LIKE '%Bitmap Index Scan%' THEN
			used := true;
		END IF;
	END LOOP;
	EXECUTE q INTO a;
	PERFORM set_config('enable_seqscan', 'on', true);
	PERFORM set_config('enable_bitmapscan', 'off', true);
	EXECUTE q INTO b;
	PERFORM set_config('enable_bitmapscan', 'on', true);
	PERFORM set_config('enable_indexscan', 'on', true);
	PERFORM set_config('pg_lion.enable_count_pushdown', 'on', true);
	IF a IS DISTINCT FROM b THEN
		RETURN format('MISMATCH index=%s seqscan=%s', a::text, b::text);
	END IF;
	IF NOT used THEN
		RETURN format('NO BITMAP INDEX SCAN (%s rows)', a.c);
	END IF;
	RETURN format('ok %s rows', a.c);
END $$;
-- The count pushdown versus the plan without it, as in sparse.sql.
CREATE FUNCTION lion_nr_pd(q text) RETURNS text
LANGUAGE plpgsql AS $$
DECLARE
	ln text;
	pushed boolean := false;
	nrows bigint;
	ndiff bigint;
BEGIN
	PERFORM set_config('pg_lion.enable_count_pushdown', 'on', true);
	FOR ln IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP
		IF ln LIKE '%Custom Scan (LionCount)%' THEN
			pushed := true;
		END IF;
	END LOOP;
	EXECUTE format('CREATE TEMP TABLE lion_nr_on AS %s', q);
	PERFORM set_config('pg_lion.enable_count_pushdown', 'off', true);
	EXECUTE format('CREATE TEMP TABLE lion_nr_off AS %s', q);
	PERFORM set_config('pg_lion.enable_count_pushdown', 'on', true);
	EXECUTE 'SELECT count(*) FROM lion_nr_on' INTO nrows;
	EXECUTE 'SELECT (SELECT count(*) FROM (SELECT * FROM lion_nr_on EXCEPT ALL SELECT * FROM lion_nr_off) a)'
			' + (SELECT count(*) FROM (SELECT * FROM lion_nr_off EXCEPT ALL SELECT * FROM lion_nr_on) b)'
		INTO ndiff;
	EXECUTE 'DROP TABLE lion_nr_on, lion_nr_off';
	IF ndiff <> 0 THEN
		RETURN format('MISMATCH: %s rows differ', ndiff);
	END IF;
	RETURN format('%s, %s rows',
				  CASE WHEN pushed THEN 'pushed down' ELSE 'not pushed down' END,
				  nrows);
END $$;
-- An index's containers by kind, per key column.
CREATE FUNCTION lion_nr_mix(idx regclass)
RETURNS TABLE (attno int2, containers int8, arrays int8, bitsets int8,
			   runs int8, narrows int8, container_bytes int8)
LANGUAGE sql AS $$
	SELECT attno, containers, array_containers, bitset_containers,
		   run_containers, narrow_containers, container_bytes
	  FROM lion_index_stats(idx)
$$;
-- The format version, off the meta page: LionMetaPageData follows the
-- 24-byte page header, with its version at +4.
CREATE FUNCTION lion_nr_version(idx regclass) RETURNS int
LANGUAGE sql AS $$
	SELECT get_byte(p, 28) | (get_byte(p, 29) << 8) FROM get_raw_page(idx::text, 0) p
$$;
-- The highest heap offset a table's rows are at.
CREATE FUNCTION lion_nr_maxoff(tbl regclass) RETURNS int
LANGUAGE plpgsql AS $$
DECLARE
	r int;
BEGIN
	EXECUTE format('SELECT max((ctid::text::point)[1])::int FROM %s', tbl) INTO r;
	RETURN r;
END $$;
-- ---------- 1. the build ----------
-- 55 rows to a heap page.  k has two values, so each of its containers holds
-- some 1760 members: too many for an ARRAY under 1032 bytes, at offsets below
-- 128, so a NARROW.  g has twenty, 176 a container, an ARRAY of 360 bytes; c
-- is clustered, a RUN.  An index with a NARROW is version 8, and one without
-- stays version 6, which the builds before §38 read.
CREATE TABLE lion_nw (i int NOT NULL, k int NOT NULL, g int NOT NULL,
					  c int NOT NULL, pad text);
INSERT INTO lion_nw
	SELECT i, i % 2, i % 20, i / 1000, repeat('x', 100) FROM generate_series(0, 39999) i;
SELECT lion_nr_maxoff('lion_nw') AS maxoff;
 maxoff 
--------
     55
(1 row)

CREATE INDEX lion_nw_k ON lion_nw USING lion (k);
CREATE INDEX lion_nw_g ON lion_nw USING lion (g);
CREATE INDEX lion_nw_c ON lion_nw USING lion (c);
CREATE INDEX lion_nw_kgc ON lion_nw USING lion (k, g, c);
SELECT * FROM lion_nr_mix('lion_nw_k');
