     t     | attno | containers | arrays | bitsets | runs | narrows | container_bytes | width 
-----------+-------+------------+--------+---------+------+---------+-----------------+-------
 lion_n35  |     1 |          6 |      0 |       0 |    0 |       6 |            3120 |     1
 lion_n61  |     1 |          6 |      0 |       0 |    0 |       6 |            3120 |     1
 lion_n97  |     1 |          6 |      0 |       0 |    0 |       6 |            6192 |     2
 lion_n136 |     1 |          6 |      0 |       0 |    0 |       6 |            9264 |     3
 lion_n185 |     1 |          6 |      0 |       0 |    0 |       6 |            9264 |     3
 lion_n226 |     1 |          6 |      0 |       0 |    0 |       6 |           12336 |     4
(6 rows)

SELECT t, m.* FROM lion_nr_tabs, lion_nr_mix((t || '_g')::regclass) m ORDER BY ord;
     t     | attno | containers | arrays | bitsets | runs | narrows | container_bytes | width 
-----------+-------+------------+--------+---------+------+---------+-----------------+-------
 lion_n35  |     1 |         60 |     60 |       0 |    0 |       0 |           11680 |      
