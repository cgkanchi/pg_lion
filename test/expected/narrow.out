DROP TABLE lion_nw, lion_nn, lion_nb;
DROP FUNCTION lion_nr_cmp(text, text);
DROP FUNCTION lion_nr_pd(text);
DROP FUNCTION lion_nr_mix(regclass);
DROP FUNCTION lion_nr_version(regclass);
DROP FUNCTION lion_nr_maxoff(regclass);
