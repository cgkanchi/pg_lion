(36 rows)

DO $$
DECLARE
	r record;
	a bigint;
	b bigint;
BEGIN
	FOR r IN SELECT * FROM lion_nr_tabs ORDER BY ord LOOP
		a := lion_index_count((r.t || '_k')::regclass, 1::int2);
		EXECUTE format('SELECT count(*) FROM %I WHERE k = 1', r.t) INTO b;
		IF a <> b THEN
			RAISE EXCEPTION '%: lion_index_count() % against %', r.t, a, b;
		END IF;
		a := lion_index_count((r.t || '_k')::regclass, 0::int2, (r.t || '_g')::regclass, 4::int2);
		EXECUTE format('SELECT count(*) FROM %I WHERE k = 0 AND g = 4', r.t) INTO b;
		IF a <> b THEN
			RAISE EXCEPTION '%: lion_index_count() of two % against %', r.t, a, b;
		END IF;
	END LOOP;
END $$;
