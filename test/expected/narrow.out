-- Across a width.  At fillfactor 25 a page takes 56 rows, all at offsets
-- below 64: NARROWs of width 1.  An UPDATE that changes the key puts each
-- new version on its page, after the ones there: the first one moves the
-- rows of the first 70 pages to 57 .. 112, which widens the two containers
-- of each key there to width 2, the next one those of the first 40 to
-- 113 .. 168, width 3, and the last those of the first 20 to 169 .. 224,
-- width 4.  The other container keys stay at width 1.  Each widening is an
-- insert's that the item cannot take in place, written as a BITSET's was.
CREATE TABLE lion_nb (i int NOT NULL, k int2 NOT NULL)
	WITH (fillfactor = 25, autovacuum_enabled = off);
INSERT INTO lion_nb SELECT i, i % 2 FROM generate_series(0, 19999) i;
CREATE INDEX lion_nb_k ON lion_nb USING lion (k);
SELECT lion_nr_maxoff('lion_nb') AS maxoff;
 maxoff 
--------
     56
(1 row)

