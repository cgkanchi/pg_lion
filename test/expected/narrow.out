-- ---------- 4. inserts ----------
-- 64 pages more of lion_n61: the first 32 are in the last container key of
-- the build, whose NARROWs take them in place, and the rest in a new one,
-- for each key an ARRAY of some 976 members, which a NARROW would be
-- smaller than: an insert makes no NARROW of anything else.
INSERT INTO lion_n61
	SELECT i, i % 2, i % 20, repeat('x', 92) FROM generate_series(61 * 160, 61 * 224 - 1) i;
