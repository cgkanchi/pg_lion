-- ---------- 3. several widths in one query ----------
-- 226 rows to a page, and band the word of its block a row's offset is in,
-- for two rows in three: band 0 is offsets 1 .. 63, a NARROW of width 1,
-- band 1 64 .. 127, width 2, band 2 128 .. 191, width 3, and band 3
-- 192 .. 226, width 4, at each of three container keys.  The third row is
-- band 9, and k is every other row, NARROWs of width 4.  The set algebra
-- takes a pair at the narrower width for an AND, the wider for an OR, and
-- the first's for `<>`.
CREATE TABLE lion_nband (i int NOT NULL, k int2 NOT NULL, band int2 NOT NULL)
	WITH (autovacuum_enabled = off);
INSERT INTO lion_nband
	SELECT i, i % 2, CASE WHEN i % 3 = 0 THEN 9 ELSE ((i % 226) + 1) / 64 END
	  FROM generate_series(0, 226 * 192 - 1) i;
CREATE INDEX lion_nband_k ON lion_nband USING lion (k);
CREATE INDEX lion_nband_b ON lion_nband USING lion (band);
VACUUM (FREEZE, ANALYZE) lion_nband;
SELECT band, min((ctid::text::point)[1]) AS first_offset,
	   max((ctid::text::point)[1]) AS last_offset
  FROM lion_nband GROUP BY band ORDER BY band;
 band | first_offset | last_offset 
------+--------------+-------------
    0 |            1 |          63
    1 |           64 |         127
    2 |          128 |         191
    3 |          192 |         226
    9 |            1 |         226
(5 rows)

