-------+------------+--------+---------+------+---------+-----------------
     1 |          6 |      0 |       6 |    0 |       0 |           24624
(1 row)

SELECT lion_nr_version('lion_nn_k') AS version;
 version 
---------
       6
(1 row)

VACUUM ANALYZE lion_nn;
