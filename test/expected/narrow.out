-- NARROW containers (DESIGN.md §38).
--
-- A NARROW of width k is a bitmap of a container's 64 heap blocks, k words
-- of each, for the offsets below 64 * k: 8 + 512 * k bytes against a
-- BITSET's 4104, k being 1 .. 5 at 8K, where a heap page holds 291 tuples at
-- most.  The build and VACUUM's re-optimize choose the narrowest width that
-- holds a container's members, and the NARROW where it is smaller than an
-- ARRAY and a RUN - VACUUM only in an index of format version 8, which a
-- build writes only when it has written a NARROW.  An insert makes no NARROW
-- of anything else, and a member past a NARROW's width widens it, to the
-- narrowest width that holds the member.  This file checks the format end to
-- end, on tables of 35 to 272 rows a page: what the build writes and the
-- version it records, reads at every width and of several widths in one
-- query, inserts in place and across a width, what VACUUM makes of each
-- kind of index, summaries, and that bitmap and plain scans,
-- lion_index_count() and the count pushdown agree with a sequential scan at
-- every step.  The damaged NARROWs are in corrupt_items.sql.
\set VERBOSITY terse
SET client_min_messages = warning;
LOAD 'pg_lion';
-- VACUUM sets a page all-visible only once the commit record is on disk.
SET synchronous_commit = on;
SET max_parallel_workers_per_gather = 0;
CREATE EXTENSION IF NOT EXISTS pg_lion;
CREATE EXTENSION IF NOT EXISTS pageinspect;
RESET client_min_messages;
-- A scan of one kind - 'bitmap' or 'plain' - versus a sequential scan, as in
-- sparse.sql: the count and the sum of i of the rows pred selects.
CREATE FUNCTION lion_nr_cmp(tbl text, pred text, how text DEFAULT 'bitmap')
RETURNS text
LANGUAGE plpgsql AS $$
DECLARE
	q text := format('SELECT count(*) AS c, coalesce(sum(i), 0) AS s FROM %s WHERE %s', tbl, pred);
	a record;
	b record;
	ln text;
	used boolean := false;
BEGIN
	PERFORM set_config('enable_seqscan', 'off', true);
	PERFORM set_config('enable_bitmapscan', (how = 'bitmap')::text, true);
	PERFORM set_config('enable_indexscan', (how = 'plain')::text, true);
	PERFORM set_config('enable_indexonlyscan', (how = 'plain')::text, true);
	PERFORM set_config('pg_lion.enable_count_pushdown', 'off', true);
	FOR ln IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP
		IF (how = 'bitmap' AND ln LIKE '%Bitmap Index Scan%') OR
		   (how = 'plain' AND ln ~ 'Index (Only )?Scan using') THEN
			used := true;
		END IF;
	END LOOP;
	EXECUTE q INTO a;
	PERFORM set_config('enable_seqscan', 'on', true);
	PERFORM set_config('enable_bitmapscan', 'off', true);
	PERFORM set_config('enable_indexscan', 'off', true);
	PERFORM set_config('enable_indexonlyscan', 'off', true);
	EXECUTE q INTO b;
	PERFORM set_config('enable_bitmapscan', 'on', true);
	PERFORM set_config('enable_indexscan', 'on', true);
	PERFORM set_config('enable_indexonlyscan', 'on', true);
	PERFORM set_config('pg_lion.enable_count_pushdown', 'on', true);
	IF a IS DISTINCT FROM b THEN
		RETURN format('MISMATCH index=%s seqscan=%s', a::text, b::text);
	END IF;
	IF NOT used THEN
		RETURN format('NO %s SCAN (%s rows)', upper(how), a.c);
	END IF;
	RETURN format('ok %s rows', a.c);
END $$;
-- The count pushdown, every other scan disabled, versus a sequential scan:
-- the rows of each, as multisets.
CREATE FUNCTION lion_nr_pd(q text) RETURNS text
LANGUAGE plpgsql AS $$
DECLARE
	ln text;
	pushed boolean := false;
	nrows bigint;
	ndiff bigint;
BEGIN
	PERFORM set_config('enable_seqscan', 'off', true);
	PERFORM set_config('enable_bitmapscan', 'off', true);
	PERFORM set_config('enable_indexscan', 'off', true);
	PERFORM set_config('enable_indexonlyscan', 'off', true);
	PERFORM set_config('pg_lion.enable_count_pushdown', 'on', true);
	FOR ln IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP
		IF ln LIKE '%Custom Scan (LionCount)%' THEN
			pushed := true;
		END IF;
	END LOOP;
	EXECUTE format('CREATE TEMP TABLE lion_nr_on AS %s', q);
	PERFORM set_config('pg_lion.enable_count_pushdown', 'off', true);
	PERFORM set_config('enable_seqscan', 'on', true);
	EXECUTE format('CREATE TEMP TABLE lion_nr_off AS %s', q);
	PERFORM set_config('enable_bitmapscan', 'on', true);
	PERFORM set_config('enable_indexscan', 'on', true);
	PERFORM set_config('enable_indexonlyscan', 'on', true);
	PERFORM set_config('pg_lion.enable_count_pushdown', 'on', true);
	EXECUTE 'SELECT count(*) FROM lion_nr_on' INTO nrows;
	EXECUTE 'SELECT (SELECT count(*) FROM (SELECT * FROM lion_nr_on EXCEPT ALL SELECT * FROM lion_nr_off) a)'
			' + (SELECT count(*) FROM (SELECT * FROM lion_nr_off EXCEPT ALL SELECT * FROM lion_nr_on) b)'
		INTO ndiff;
	EXECUTE 'DROP TABLE lion_nr_on, lion_nr_off';
	IF ndiff <> 0 THEN
		RETURN format('MISMATCH: %s rows differ', ndiff);
	END IF;
	RETURN format('%s, %s rows',
				  CASE WHEN pushed THEN 'pushed down' ELSE 'not pushed down' END,
				  nrows);
END $$;
-- An index's containers by kind, per key column, and the width of its
-- NARROWs when every container is a NARROW of one width (8 + 512 * width
-- bytes each), else NULL.
CREATE FUNCTION lion_nr_mix(idx regclass)
RETURNS TABLE (attno int2, containers int8, arrays int8, bitsets int8,
			   runs int8, narrows int8, container_bytes int8, width int8)
LANGUAGE sql AS $$
	SELECT attno, containers, array_containers, bitset_containers,
		   run_containers, narrow_containers, container_bytes,
		   CASE WHEN narrow_containers = containers AND containers > 0 AND
					 container_bytes % containers = 0 AND
					 (container_bytes / containers - 8) % 512 = 0
				THEN (container_bytes / containers - 8) / 512 END
	  FROM lion_index_stats(idx)
$$;
-- The format version, off the meta page: LionMetaPageData follows the
-- 24-byte page header, with its version at +4.
CREATE FUNCTION lion_nr_version(idx regclass) RETURNS int
LANGUAGE sql AS $$
	SELECT get_byte(p, 28) | (get_byte(p, 29) << 8) FROM get_raw_page(idx::text, 0) p
$$;
-- The highest heap offset a table's rows are at.
CREATE FUNCTION lion_nr_maxoff(tbl regclass) RETURNS int
LANGUAGE plpgsql AS $$
DECLARE
	r int;
BEGIN
	EXECUTE format('SELECT max((ctid::text::point)[1])::int FROM %s', tbl) INTO r;
	RETURN r;
END $$;
-- lion_index_verify(), which raises what it finds, as a word.
CREATE FUNCTION lion_nr_verify(idx regclass) RETURNS text
LANGUAGE plpgsql AS $$
BEGIN
	PERFORM lion_index_verify(idx, true);
	RETURN 'ok';
END $$;
-- ---------- 1. the build, at every width ----------
-- Six tables of two and a half container keys - 160 heap pages - whose rows
-- are 35, 61, 97, 136, 185 and 226 to a page.  k has two values, some 32
-- members a container per row a page: a NARROW of the narrowest width that
-- holds the page's offsets, 1, 1, 2, 3, 3 and 4.  g has twenty, an ARRAY at
-- every width.  An index with a NARROW is version 8, and one without stays
-- version 6, which the builds before §38 read.
CREATE TABLE lion_nr_tabs (ord int, t text, pad text);
INSERT INTO lion_nr_tabs VALUES
	(1, 'lion_n35', repeat('x', 184)), (2, 'lion_n61', repeat('x', 92)),
	(3, 'lion_n97', repeat('x', 44)), (4, 'lion_n136', repeat('x', 20)),
	(5, 'lion_n185', ''), (6, 'lion_n226', NULL);
DO $$
DECLARE
	r record;
BEGIN
	FOR r IN SELECT * FROM lion_nr_tabs ORDER BY ord LOOP
		EXECUTE format('CREATE TABLE %I (i int NOT NULL, k int2 NOT NULL, g int2 NOT NULL, pad text)'
					   ' WITH (autovacuum_enabled = off)', r.t);
		EXECUTE format('INSERT INTO %I SELECT i, i %% 2, i %% 20, %L FROM generate_series(0, %s * 160 - 1) i',
					   r.t, r.pad, substr(r.t, 7)::int);
		EXECUTE format('CREATE INDEX %I ON %I USING lion (k)', r.t || '_k', r.t);
		EXECUTE format('CREATE INDEX %I ON %I USING lion (g)', r.t || '_g', r.t);
	END LOOP;
END $$;
VACUUM (FREEZE, ANALYZE) lion_n35, lion_n61, lion_n97, lion_n136, lion_n185, lion_n226;
SELECT t, lion_nr_maxoff(t::regclass) AS maxoff,
	   lion_nr_version((t || '_k')::regclass) AS version_k,
	   lion_nr_version((t || '_g')::regclass) AS version_g
  FROM lion_nr_tabs ORDER BY ord;
     t     | maxoff | version_k | version_g 
-----------+--------+-----------+-----------
 lion_n35  |     35 |         8 |         6
 lion_n61  |     61 |         8 |         6
 lion_n97  |     97 |         8 |         6
 lion_n136 |    136 |         8 |         6
 lion_n185 |    185 |         8 |         6
 lion_n226 |    226 |         8 |         6
(6 rows)

