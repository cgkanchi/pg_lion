-- ---------- 5. VACUUM ----------
-- In a version 8 index VACUUM's re-optimize of an item it changed picks a
-- NARROW where that is smallest: the BITSETs of section 4 are NARROWs again
-- once their rows at 128 and above are gone.
DELETE FROM lion_nb WHERE (ctid::text::point)[1] >= 128;
VACUUM lion_nb;
SELECT lion_nr_maxoff('lion_nb') AS maxoff;
 maxoff 
--------
    127
(1 row)

SELECT * FROM lion_nr_mix('lion_nb_k');
 attno | containers | arrays | bitsets | runs | narrows | container_bytes 
-------+------------+--------+---------+------+---------+-----------------
     1 |         10 |      0 |       0 |    0 |      10 |           10320
(1 row)

SELECT lion_index_verify('lion_nb_k', true);
 lion_index_verify 
-------------------
 
(1 row)

SELECT lion_nr_cmp('lion_nb', 'k = 1');
 lion_nr_cmp  
--------------
 ok 9354 rows
(1 row)

SELECT lion_nr_pd('SELECT k, count(*) FROM lion_nb GROUP BY k');
     lion_nr_pd      
---------------------
 pushed down, 2 rows
(1 row)

-- ... and a NARROW left with 512 members or fewer is an ARRAY: key 0 loses
-- seven rows in eight.  Key 1 loses two rows of the ARRAY section 3's
-- inserts made, which VACUUM's re-optimize makes a NARROW; its other
-- containers it does not change.
DELETE FROM lion_nw WHERE (k = 0 AND i % 8 <> 0) OR i IN (44001, 44003);
VACUUM lion_nw;
SELECT * FROM lion_nr_mix('lion_nw_k');
