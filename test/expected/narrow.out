(1 row)

-- A version 6 index never gets a NARROW from VACUUM, though its BITSETs
-- hold nothing at 128 or above any more: it stays readable by the builds
-- before §38.  REINDEX is what makes them NARROWs.
DELETE FROM lion_nn WHERE (ctid::text::point)[1] >= 128 OR i % 3 = 0;
VACUUM lion_nn;
SELECT * FROM lion_nr_mix('lion_nn_k');
 attno | containers | arrays | bitsets | runs | narrows | container_bytes 
-------+------------+--------+---------+------+---------+-----------------
