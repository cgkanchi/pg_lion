(1 row)

-- ---------- 4. offset 128 ----------
-- At fillfactor 40 a page takes 73 rows; an UPDATE that changes the key
-- puts the new version on the same page, past them.  The first one moves
-- the rows at offsets 1 .. 20 to 74 .. 93, below 128: every insert is a
-- NARROW's, in place.  The second moves the rows at 21 .. 73 of the first
-- 69 pages to 94 .. 146: those at 128 and above turn the two containers of
-- each key there into BITSETs.
CREATE TABLE lion_nb (i int NOT NULL, k int NOT NULL, v int NOT NULL)
	WITH (fillfactor = 40);
INSERT INTO lion_nb SELECT i, i % 2, 0 FROM generate_series(0, 19999) i;
SELECT lion_nr_maxoff('lion_nb') AS maxoff;
 maxoff 
--------
     73
(1 row)

CREATE INDEX lion_nb_k ON lion_nb USING lion (k);
SELECT * FROM lion_nr_mix('lion_nb_k');
 attno | containers | arrays | bitsets | runs | narrows | container_bytes 
-------+------------+--------+---------+------+---------+-----------------
     1 |         10 |      0 |       0 |    0 |      10 |           10320
(1 row)

SELECT lion_nr_version('lion_nb_k') AS version;
 version 
---------
       8
(1 row)

UPDATE lion_nb SET k = 1 - k WHERE (ctid::text::point)[1] <= 20;
SELECT lion_nr_maxoff('lion_nb') AS maxoff;
 maxoff 
--------
