-- ---------- 3. inserts never make a NARROW ----------
-- 5000 more rows, on 91 new heap pages: the first 40 are in the last
-- container of the build, whose NARROWs take them in place, and the rest in
-- a new container, for each key an ARRAY of some 1400 members, which a
-- NARROW would be smaller than.
INSERT INTO lion_nw
	SELECT i, i % 2, i % 20, i / 1000, repeat('x', 100) FROM generate_series(40000, 44999) i;
SELECT * FROM lion_nr_mix('lion_nw_k');
 attno | containers | arrays | bitsets | runs | narrows | container_bytes 
-------+------------+--------+---------+------+---------+-----------------
     1 |         26 |      2 |       0 |    0 |      24 |           30304
(1 row)

