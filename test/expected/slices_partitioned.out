-- a generic plan's bounds, a NULL among them
PREPARE spq_p(int, int) AS
	SELECT count(*), sum(w) FROM spq WHERE v BETWEEN $1 AND $2;
SET plan_cache_mode = force_generic_plan;
SET enable_seqscan = off;
SET enable_bitmapscan = off;
SET pg_lion.enable_plain_scan = off;
SET pg_lion.prefer_slice_ranges = on;
EXPLAIN (COSTS OFF) EXECUTE spq_p(0, 1);
                      QUERY PLAN                       
-------------------------------------------------------
 Custom Scan (LionCount)
   Partitions: spq_1, spq_2a, spq_2b, spq_empty, spq_4
   Lion Indexes: (v >= $1 AND v <= $2)
   Range From Slices: v >= $1 AND v <= $2 (32 slices)
   Aggregates From Slices: (w: every bit counted)
(5 rows)

EXECUTE spq_p(-1000, 40000);
 count |        sum        
-------+-------------------
  2275 | -2059803105409372
(1 row)

EXECUTE spq_p(NULL, 40000);
 count | sum 
-------+-----
     0 |    
(1 row)

RESET pg_lion.prefer_slice_ranges;
RESET pg_lion.enable_plain_scan;
RESET enable_bitmapscan;
RESET enable_seqscan;
RESET plan_cache_mode;
SELECT count(*), sum(w) FROM spq WHERE v BETWEEN -1000 AND 40000;
 count |        sum        
-------+-------------------
  2275 | -2059803105409372
(1 row)

DEALLOCATE spq_p;
-- a dirty heap - updates moving rows between partitions, deletes, inserts
-- at the extremes - and then VACUUM
UPDATE spq SET k = k + 100, v = -v WHERE k < 100 AND g = 2;
DELETE FROM spq WHERE g = 4 AND k >= 300;
INSERT INTO spq VALUES (150, 4, 2147483647, NULL, NULL, NULL),
	(390, 6, -2147483648, 1, '2010-01-01', '2020-01-01 00:00+00');
SELECT spt_r('SELECT count(*) FROM spq WHERE v > 1000');
           spt_r           
---------------------------
 range from slices, 1 rows
(1 row)

SELECT spt_r('SELECT count(*), sum(w) FROM spq WHERE g = 2 AND v < 0');
                       spt_r                       
---------------------------------------------------
 range from slices, aggregates from slices, 1 rows
(1 row)

SELECT spt_r('SELECT count(*) FROM spq WHERE k > 50 AND k < 350 AND v <> 17');
           spt_r           
---------------------------
 range from slices, 1 rows
(1 row)

VACUUM spq;
SELECT spt_r('SELECT count(*) FROM spq WHERE v > 1000');
           spt_r           
---------------------------
 range from slices, 1 rows
(1 row)

SELECT spt_r('SELECT count(*), sum(w) FROM spq WHERE g = 2 AND v < 0');
                       spt_r                       
---------------------------------------------------
 range from slices, aggregates from slices, 1 rows
(1 row)

-- declines: a partition whose index for the column does not slice it, until
-- pruning leaves it out; the switch
CREATE TABLE spqd (k int, g int, v int4) PARTITION BY RANGE (k);
CREATE TABLE spqd_1 PARTITION OF spqd FOR VALUES FROM (0) TO (100);
CREATE TABLE spqd_2 PARTITION OF spqd FOR VALUES FROM (100) TO (200);
INSERT INTO spqd SELECT i % 200, i % 5, i * 3 FROM generate_series(1, 2000) i;
CREATE INDEX ON spqd USING lion (g);
CREATE INDEX ON spqd_1 USING lion (v) WITH (slices = on);
CREATE INDEX ON spqd_2 USING lion (v);
VACUUM ANALYZE spqd;
SELECT spt_r('SELECT count(*) FROM spqd WHERE g = 1 AND v > 1000');
             spt_r             
-------------------------------
 range not from slices, 1 rows
(1 row)

SELECT spt_r('SELECT count(*) FROM spqd WHERE g = 1 AND v > 1000 AND k < 100');
           spt_r           
---------------------------
 range from slices, 1 rows
(1 row)

SET pg_lion.enable_slice_ranges = off;
SELECT spt_r('SELECT count(*) FROM spq WHERE g = 3 AND v > 1000');
             spt_r             
-------------------------------
 range not from slices, 1 rows
(1 row)

RESET pg_lion.enable_slice_ranges;
DROP TABLE spr, spl, spd, spq, spqd;
DROP FUNCTION spt_q(text), spt_r(text), spt_plan(text, bool);
