-- a LATERAL value: the node rescanned, every partition again
SELECT spt_q('SELECT v.g, s.* FROM (VALUES (1), (3), (99)) v(g),
			  LATERAL (SELECT sum(b), min(c), max(tz) FROM spr WHERE spr.g = v.g) s');
