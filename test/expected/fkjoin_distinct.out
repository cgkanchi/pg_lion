SELECT lion_dj('SELECT count(DISTINCT d.attr) FILTER (WHERE d.grp = ''g1'') FROM lion_dd d WHERE EXISTS (SELECT 1 FROM lion_df f WHERE f.fk = d.pk AND f.x = 3)');
