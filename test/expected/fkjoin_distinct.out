-- FK-side join pushdown, part three (DESIGN.md §27, "count(DISTINCT)"):
-- count(DISTINCT x) over the join, where x is the fact's join column or a
-- column of the dimension.
--
-- A DISTINCT count has no partial form, so the node emits the dimension rows
-- that join - one each, however many fact rows each joins, or for an anti
-- join the ones that join none - and core's own Agg, over a Sort by the
-- query's group pathkeys, computes the aggregates.  Every answer is checked
-- against the same query with the pushdown off, as a multiset in both
-- directions.
\set VERBOSITY terse
SET client_min_messages = warning;
LOAD 'pg_lion';
CREATE EXTENSION IF NOT EXISTS pg_lion;
-- VACUUM can only set all-visible once the commit record is on disk
SET synchronous_commit = on;
-- The FK-side joins below pin the upper node's plans (DESIGN.md §27).  The semi
-- and anti join path answers the same joins as a join rel's rows, below core's
-- own Agg, and no enable_*join setting disables it: it is off here, and tested
-- - the upper node over it included - in fkjoin_semipath.sql.
SET pg_lion.enable_semijoin = off;
SET default_statistics_target = 1000;
/*
 * lion_dj() runs a query through the pushdown - with every join method
 * disabled when force is set, so that a shape the cost model would not pick
 * is still EXERCISED - and again with the pushdown off and sequential scans
 * only, so that the reference reads no lion posting set, and compares the
 * two.  It reports whether the node was used.
 */
CREATE FUNCTION lion_dj(q text, force boolean DEFAULT true) RETURNS text
LANGUAGE plpgsql AS $$
DECLARE
	ln text;
	pushed boolean := false;
	nrows bigint;
	ndiff bigint;
BEGIN
	IF force THEN
		PERFORM set_config('enable_hashjoin', 'off', true);
		PERFORM set_config('enable_mergejoin', 'off', true);
		PERFORM set_config('enable_nestloop', 'off', true);
	END IF;
	PERFORM set_config('pg_lion.enable_count_pushdown', 'on', true);
	FOR ln IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP
		IF ln LIKE '%Custom Scan (LionCount)%' THEN
			pushed := true;
		END IF;
	END LOOP;
	EXECUTE format('CREATE TEMP TABLE lion_dj_on AS SELECT s::text AS r FROM (%s) s', q);

	/*
	 * The reference: the pushdown off, and sequential scans only - no bitmap,
	 * index or index-only scan, which could read the very lion posting sets
	 * the node reads and agree with it about a wrong answer.
	 */
	PERFORM set_config('pg_lion.enable_count_pushdown', 'off', true);
	PERFORM set_config('enable_hashjoin', 'on', true);
	PERFORM set_config('enable_mergejoin', 'on', true);
	PERFORM set_config('enable_nestloop', 'on', true);
	PERFORM set_config('enable_seqscan', 'on', true);
	PERFORM set_config('enable_bitmapscan', 'off', true);
	PERFORM set_config('enable_indexscan', 'off', true);
	PERFORM set_config('enable_indexonlyscan', 'off', true);
	EXECUTE format('CREATE TEMP TABLE lion_dj_off AS SELECT s::text AS r FROM (%s) s', q);
	PERFORM set_config('enable_bitmapscan', 'on', true);
	PERFORM set_config('enable_indexscan', 'on', true);
	PERFORM set_config('enable_indexonlyscan', 'on', true);
	PERFORM set_config('pg_lion.enable_count_pushdown', 'on', true);

	EXECUTE 'SELECT count(*) FROM lion_dj_on' INTO nrows;
	EXECUTE 'SELECT (SELECT count(*) FROM (SELECT * FROM lion_dj_on EXCEPT ALL SELECT * FROM lion_dj_off) a)'
			' + (SELECT count(*) FROM (SELECT * FROM lion_dj_off EXCEPT ALL SELECT * FROM lion_dj_on) b)'
		INTO ndiff;
	EXECUTE 'DROP TABLE lion_dj_on, lion_dj_off';

	IF ndiff <> 0 THEN
		RETURN format('MISMATCH: %s rows differ', ndiff);
	END IF;
	RETURN format('%s, %s rows',
				  CASE WHEN pushed THEN 'pushed down' ELSE 'not pushed down' END,
				  nrows);
END $$;
/* The answer itself, through the pushdown, joins disabled. */
CREATE FUNCTION lion_dj_val(q text) RETURNS SETOF text
LANGUAGE plpgsql AS $$
BEGIN
	PERFORM set_config('enable_hashjoin', 'off', true);
	PERFORM set_config('enable_mergejoin', 'off', true);
	PERFORM set_config('enable_nestloop', 'off', true);
	RETURN QUERY EXECUTE format('SELECT s::text FROM (%s) s', q);
END $$;
/* Which plan the cost model picks, with nothing disabled. */
CREATE FUNCTION lion_dj_pick(q text) RETURNS text
LANGUAGE plpgsql AS $$
DECLARE
	ln text;
BEGIN
	FOR ln IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP
		IF ln LIKE '%Custom Scan (LionCount)%' THEN
			RETURN 'pushed down';
		END IF;
	END LOOP;
	RETURN 'not pushed down';
END $$;
/* A generic prepared plan, which keeps $n a Param, against the same with the pushdown off. */
CREATE FUNCTION lion_dj_prep(q text, args text) RETURNS text
LANGUAGE plpgsql AS $$
DECLARE
	ln text;
	pushed boolean := false;
	nrows bigint;
	ndiff bigint;
BEGIN
	PERFORM set_config('plan_cache_mode', 'force_generic_plan', true);
	PERFORM set_config('enable_hashjoin', 'off', true);
	PERFORM set_config('enable_mergejoin', 'off', true);
	PERFORM set_config('enable_nestloop', 'off', true);
	PERFORM set_config('pg_lion.enable_count_pushdown', 'on', true);
	EXECUTE 'PREPARE lion_djp_on AS ' || q;
	FOR ln IN EXECUTE 'EXPLAIN (COSTS OFF) EXECUTE lion_djp_on(' || args || ')' LOOP
		IF ln LIKE '%Custom Scan (LionCount)%' THEN
			pushed := true;
		END IF;
	END LOOP;
	EXECUTE format('CREATE TEMP TABLE lion_dj_on AS EXECUTE lion_djp_on(%s)', args);

	/*
	 * The reference: the pushdown off, and sequential scans only - no bitmap,
	 * index or index-only scan, which could read the very lion posting sets
	 * the node reads and agree with it about a wrong answer.
	 */
	PERFORM set_config('enable_hashjoin', 'on', true);
	PERFORM set_config('enable_mergejoin', 'on', true);
	PERFORM set_config('enable_nestloop', 'on', true);
	PERFORM set_config('pg_lion.enable_count_pushdown', 'off', true);
	PERFORM set_config('enable_seqscan', 'on', true);
	PERFORM set_config('enable_bitmapscan', 'off', true);
	PERFORM set_config('enable_indexscan', 'off', true);
	PERFORM set_config('enable_indexonlyscan', 'off', true);
	EXECUTE 'PREPARE lion_djp_off AS ' || q;
	EXECUTE format('CREATE TEMP TABLE lion_dj_off AS EXECUTE lion_djp_off(%s)', args);
	PERFORM set_config('enable_bitmapscan', 'on', true);
	PERFORM set_config('enable_indexscan', 'on', true);
	PERFORM set_config('enable_indexonlyscan', 'on', true);
	PERFORM set_config('pg_lion.enable_count_pushdown', 'on', true);
	EXECUTE 'DEALLOCATE lion_djp_on';
	EXECUTE 'DEALLOCATE lion_djp_off';

	EXECUTE 'SELECT count(*) FROM lion_dj_on' INTO nrows;
	EXECUTE 'SELECT (SELECT count(*) FROM (SELECT * FROM lion_dj_on EXCEPT ALL SELECT * FROM lion_dj_off) a)'
			' + (SELECT count(*) FROM (SELECT * FROM lion_dj_off EXCEPT ALL SELECT * FROM lion_dj_on) b)'
		INTO ndiff;
	EXECUTE 'DROP TABLE lion_dj_on, lion_dj_off';
	IF ndiff <> 0 THEN
		RETURN format('MISMATCH: %s rows differ', ndiff);
	END IF;
	RETURN format('%s, %s rows',
				  CASE WHEN pushed THEN 'pushed down' ELSE 'not pushed down' END,
				  nrows);
END $$;
/* One counter of the node's EXPLAIN ANALYZE output, joins disabled. */
CREATE FUNCTION lion_dj_counter(q text, counter text) RETURNS bigint
LANGUAGE plpgsql AS $$
DECLARE
	ln text;
	val bigint;
BEGIN
	PERFORM set_config('enable_hashjoin', 'off', true);
	PERFORM set_config('enable_mergejoin', 'off', true);
	PERFORM set_config('enable_nestloop', 'off', true);
	FOR ln IN EXECUTE 'EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF) ' || q LOOP
		IF btrim(split_part(ln, ':', 1)) = counter THEN
			val := btrim(split_part(ln, ':', 2))::bigint;
		END IF;
	END LOOP;
	RETURN val;
END $$;
/*
 * The dimension: 300 rows, int8 primary key 1..300, attr 0..6 with NULL on
 * every 13th, a region and a group, and a lion index on (region, grp).  The
 * fact: 30000 rows in random key order; fk over 1..360, so keys 301..360
 * join no dimension row, NULL on every 40th row, and no row at all for the
 * keys that are multiples of 17, so those dimension rows join no fact row.
 * fk4 is fk as int4; x has 10 values, y 5 and NULLs, t 20.
 */
CREATE TABLE lion_dd (
	pk		int8	PRIMARY KEY,
	attr	int,
	region	text	NOT NULL,
	grp		text	NOT NULL
);
INSERT INTO lion_dd
SELECT i, CASE WHEN i % 13 = 0 THEN NULL ELSE i % 7 END,
	   CASE i % 3 WHEN 0 THEN 'eu' WHEN 1 THEN 'us' ELSE 'ap' END,
	   'g' || (i % 5)
FROM generate_series(1, 300) i;
CREATE INDEX lion_dd_rg ON lion_dd USING lion (region, grp);
CREATE TABLE lion_df (
	id		int		NOT NULL,
	fk		int8,
	fk4		int4,
	x		int		NOT NULL,
	y		int,
	t		text	NOT NULL
);
INSERT INTO lion_df
SELECT i, k, k, h2 % 10, CASE WHEN h2 % 9 = 0 THEN NULL ELSE h2 / 10 % 5 END,
	   't' || (h3 % 20)
FROM (SELECT i,
			 CASE WHEN i % 40 = 0 THEN NULL
				  WHEN (abs(hashint4(i)) % 360 + 1) % 17 = 0 THEN NULL
				  ELSE abs(hashint4(i)) % 360 + 1 END AS k,
			 abs(hashint4(i + 1000000)) AS h2,
			 abs(hashint4(i + 2000000)) AS h3
	  FROM generate_series(1, 30000) i) s;
CREATE INDEX lion_df_fk ON lion_df USING lion (fk);
CREATE INDEX lion_df_fk4 ON lion_df USING lion (fk4);
CREATE INDEX lion_df_x ON lion_df USING lion (x);
CREATE INDEX lion_df_yt ON lion_df USING lion (y, t);
-- a dimension whose key is NOT unique: every key twice, and NULLs
CREATE TABLE lion_ddn (k int8, attr int NOT NULL);
INSERT INTO lion_ddn SELECT CASE WHEN i % 50 = 0 THEN NULL ELSE i % 150 + 1 END, i % 4
FROM generate_series(1, 300) i;
CREATE INDEX lion_ddn_k ON lion_ddn (k);
-- a text key: 200 codes, and facts over 240 of them
CREATE TABLE lion_dt (code text PRIMARY KEY, grp text NOT NULL);
INSERT INTO lion_dt SELECT 'c' || i, 'g' || (i % 4) FROM generate_series(1, 200) i;
CREATE TABLE lion_dtf (code text, x int NOT NULL);
INSERT INTO lion_dtf
SELECT CASE WHEN i % 50 = 0 THEN NULL ELSE 'c' || (abs(hashint4(i)) % 240 + 1) END,
	   abs(hashint4(i + 1000000)) % 10
FROM generate_series(1, 10000) i;
CREATE INDEX lion_dtf_code ON lion_dtf USING lion (code);
CREATE INDEX lion_dtf_x ON lion_dtf USING lion (x);
VACUUM (FREEZE, ANALYZE) lion_df;
VACUUM (FREEZE, ANALYZE) lion_dd;
VACUUM (FREEZE, ANALYZE) lion_ddn;
VACUUM (FREEZE, ANALYZE) lion_dt;
VACUUM (FREEZE, ANALYZE) lion_dtf;
-- ---- 1. count(DISTINCT fact.fk) over the inner join ----------------------------
-- the fact rows' keys that have a qualifying dimension row: the dimension rows
-- that join, one each
SELECT lion_dj('SELECT count(DISTINCT f.fk) FROM lion_df f JOIN lion_dd d ON d.pk = f.fk WHERE f.x = 3');
       lion_dj       
---------------------
 pushed down, 1 rows
(1 row)

SELECT lion_dj('SELECT count(DISTINCT f.fk) FROM lion_df f JOIN lion_dd d ON d.pk = f.fk WHERE f.x = 3 AND d.region = ''eu''');
       lion_dj       
---------------------
 pushed down, 1 rows
(1 row)

SELECT lion_dj('SELECT count(DISTINCT f.fk) FROM lion_df f JOIN lion_dd d ON d.pk = f.fk WHERE f.t IN (''t1'', ''t2'') AND f.y IS NOT NULL');
       lion_dj       
---------------------
 pushed down, 1 rows
(1 row)

SELECT lion_dj('SELECT count(DISTINCT f.fk) FROM lion_df f JOIN lion_dd d ON d.pk = f.fk WHERE (f.x = 1 OR f.t = ''t4'') AND d.grp <> ''g2''');
       lion_dj       
---------------------
 pushed down, 1 rows
(1 row)

SELECT lion_dj('SELECT count(DISTINCT f.fk) FROM lion_df f JOIN lion_dd d ON d.pk = f.fk');
       lion_dj       
---------------------
 pushed down, 1 rows
(1 row)

SELECT lion_dj_val('SELECT count(DISTINCT f.fk) FROM lion_df f JOIN lion_dd d ON d.pk = f.fk');
 lion_dj_val 
-------------
 (283)
(1 row)

-- the EXISTS and IN forms over the unique key are the same inner join
SELECT lion_dj('SELECT count(DISTINCT f.fk) FROM lion_df f WHERE f.x = 3 AND EXISTS (SELECT 1 FROM lion_dd d WHERE d.pk = f.fk AND d.region = ''eu'')');
       lion_dj       
---------------------
