-- ---- 6. a dirty heap: deletes and updates on both sides, not yet vacuumed -----
DELETE FROM lion_df WHERE fk = 7;
DELETE FROM lion_df WHERE fk = 8 AND x < 5;
UPDATE lion_df SET fk = 9, fk4 = 9 WHERE fk = 10 AND x = 1;
UPDATE lion_df SET x = 3 WHERE id % 97 = 0;
UPDATE lion_df SET fk = NULL, fk4 = NULL WHERE fk = 11;
INSERT INTO lion_df SELECT 30000 + i, 34, 34, 3, 1, 't5' FROM generate_series(1, 5) i;
DELETE FROM lion_dd WHERE pk = 12;
UPDATE lion_dd SET region = 'eu', attr = 6 WHERE pk IN (1, 2, 4);
UPDATE lion_dd SET attr = NULL WHERE pk = 5;
SELECT lion_dj('SELECT count(DISTINCT f.fk) FROM lion_df f JOIN lion_dd d ON d.pk = f.fk WHERE f.x = 3');
