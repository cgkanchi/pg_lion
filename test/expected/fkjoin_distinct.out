(1 row)

SELECT lion_dj('SELECT d.attr, count(DISTINCT f.fk) FROM lion_df f JOIN lion_dd d ON d.pk = f.fk WHERE f.t = ''t3'' GROUP BY d.attr HAVING count(DISTINCT f.fk) > 5');
