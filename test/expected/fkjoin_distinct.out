-------------------------
 not pushed down, 1 rows
(1 row)

-- ---- 4. the plan ----------------------------------------------------------------
SET enable_hashjoin = off;
SET enable_mergejoin = off;
SET enable_nestloop = off;
-- the rows are sorted by the DISTINCT argument, which core then presorts
EXPLAIN (COSTS OFF) SELECT count(DISTINCT f.fk) FROM lion_df f JOIN lion_dd d ON d.pk = f.fk WHERE f.x = 3 AND d.region = 'eu';
                              QUERY PLAN                               
-----------------------------------------------------------------------
 Aggregate
   ->  Sort
         Sort Key: fk
         ->  Custom Scan (LionCount)
               Lion Indexes: lion_df_fk (fk = d.pk), lion_df_x (x = 3)
               Join Rows: the dimension rows with a match
               ->  Seq Scan on lion_dd d
                     Filter: (region = 'eu'::text)
(8 rows)

EXPLAIN (COSTS OFF) SELECT d.grp, count(DISTINCT d.attr) FROM lion_dd d WHERE NOT EXISTS (SELECT 1 FROM lion_df f WHERE f.fk = d.pk AND f.x = 3) GROUP BY d.grp;
                              QUERY PLAN                               
-----------------------------------------------------------------------
 GroupAggregate
   Group Key: d.grp
   ->  Sort
         Sort Key: d.grp, d.attr
         ->  Custom Scan (LionCount)
               Lion Indexes: lion_df_fk (fk = d.pk), lion_df_x (x = 3)
               Join Type: Anti
               Join Rows: the dimension rows without a match
               ->  Seq Scan on lion_dd d
(9 rows)

RESET enable_hashjoin;
RESET enable_mergejoin;
RESET enable_nestloop;
-- an inner join's rows need a visible fact row, not a count of them: the
-- existence test stops early, as the semi join's does
SELECT lion_dj_counter('SELECT count(DISTINCT f.fk) FROM lion_df f JOIN lion_dd d ON d.pk = f.fk', 'Containers Visited')
	< lion_dj_counter('SELECT count(*) FROM lion_df f JOIN lion_dd d ON d.pk = f.fk', 'Containers Visited') AS rows_test_existence;
 rows_test_existence 
---------------------
 t
(1 row)

SELECT lion_dj_counter('SELECT count(DISTINCT f.fk) FROM lion_df f JOIN lion_dd d ON d.pk = f.fk WHERE f.x = 3', 'Join Keys Looked Up');
 lion_dj_counter 
-----------------
             300
(1 row)

-- the cost model's choice
SELECT lion_dj_pick('SELECT count(DISTINCT d.attr) FROM lion_dd d WHERE EXISTS (SELECT 1 FROM lion_df f WHERE f.fk = d.pk AND f.x = 3)');
  lion_dj_pick   
-----------------
 not pushed down
(1 row)

SELECT lion_dj_pick('SELECT d.region, count(DISTINCT f.fk) FROM lion_df f JOIN lion_dd d ON d.pk = f.fk WHERE f.x = 3 AND f.t = ''t4'' GROUP BY d.region');
  lion_dj_pick   
-----------------
 not pushed down
(1 row)

