SELECT lion_dj('SELECT upper(d.grp), count(DISTINCT f.fk) FROM lion_df f JOIN lion_dd d ON d.pk = f.fk WHERE f.x = 2 GROUP BY upper(d.grp) ORDER BY 2 DESC, 1 LIMIT 3');
       lion_dj       
---------------------
 pushed down, 3 rows
(1 row)

-- a GROUP BY the planner folds to a constant: an empty join has no group
SELECT lion_dj('SELECT d.region, count(DISTINCT f.fk) FROM lion_df f JOIN lion_dd d ON d.pk = f.fk WHERE f.x = 3 AND d.region = ''eu'' GROUP BY d.region');
       lion_dj       
---------------------
