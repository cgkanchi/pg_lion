(1 row)

SELECT lion_dj('SELECT d.region, d.grp, count(DISTINCT f.fk) FROM lion_df f JOIN lion_dd d ON d.pk = f.fk WHERE f.y = 1 GROUP BY d.region, d.grp');
       lion_dj        
----------------------
