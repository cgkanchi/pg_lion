-- duplicated and NULL dimension keys: each dimension row is tested on its own,
-- a NULL key has no match and is a row of the anti join
CREATE INDEX lion_ddn_kl ON lion_ddn USING lion (k);
ANALYZE lion_ddn;
SELECT lion_dj('SELECT count(DISTINCT d.attr) FROM lion_ddn d WHERE EXISTS (SELECT 1 FROM lion_df f WHERE f.fk = d.k AND f.x = 2 AND f.t = ''t1'')');
       lion_dj       
---------------------
