SELECT oj('SELECT f.id, f.score, d.pk FROM fact f JOIN dim d ON f.fk = d.pk
	WHERE f.grp = 2 AND f.ver = 1 AND f.tags @> ''{a1}'' AND d.lvl < 30
	ORDER BY f.score DESC NULLS LAST, f.id LIMIT 20');
             oj              
