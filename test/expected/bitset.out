 lion_bs4 | count: (8163)
 lion_bs6 | count: (4667)
(3 rows)

SELECT * FROM lbs_all('SELECT b, count(*) FROM %s WHERE a = 0 GROUP BY b', 'count');
   tbl    |                result                
----------+--------------------------------------
 lion_bs  | count: (0,11666) (1,11667) (2,11667)
 lion_bs4 | count: (0,11666) (1,11667) (2,11667)
 lion_bs6 | count: (0,6666) (1,6667) (2,6667)
(3 rows)

VACUUM (FREEZE, ANALYZE) lion_bs, lion_bs4, lion_bs6;
