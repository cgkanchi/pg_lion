-- Wide bitmaps: NARROWs of width 3 and 4, and BITSETs (DESIGN.md §3, §38).
--
-- A dense set of scattered rows is a bitmap: a NARROW of the narrowest width
-- that holds its blocks' offsets, k words of each block (k = 1 .. 5 at 8K),
-- or a BITSET, 8 words of each.  The set algebra, the readers, VACUUM and
-- the inserts take a bitmap's width as it comes, and have code compiled for
-- each width up to 4 and for a BITSET's.  narrow.sql has the format at every
-- width; this file has the paths of the set algebra, each section running
-- its queries on three tables of the same columns and values:
--
--	lion_bs		136 rows to a page: its dense sets are NARROWs of width 3
--	lion_bs4	226 rows to a page: NARROWs of width 4
--	lion_bs6	226 rows to a page, its indexes built before its rows: they
--				hold no NARROW and are format version 6, and an insert makes
--				an ARRAY it fills a BITSET - BITSETs, which a build no longer
--				makes of any heap's rows
--
-- lion_bs also has two columns, and a row number, the others do not have
-- room for.  lion_index_stats() shows each index's containers by kind.
-- Every answer is checked against a sequential scan, as a multiset in both
-- directions.  range_cost.sql §2 has the union of a range collected on such
-- rows, where a widening is refused.
\set VERBOSITY terse
SET client_min_messages = warning;
LOAD 'pg_lion';
CREATE EXTENSION IF NOT EXISTS pg_lion;
RESET client_min_messages;
-- VACUUM can only set all-visible once the commit record is on disk
SET synchronous_commit = on;
SET max_parallel_workers_per_gather = 0;
/*
 * lbs_check() runs q with one kind of scan - 'bitmap', 'plain' (an Index
 * Scan) or 'count' (the LionCount pushdown, every other scan disabled) - and
 * again as a sequential scan with the pushdown off, and compares the two as
 * multisets.  It says whether the scan asked for was really used, and the
 * answer: its rows when there are four or fewer, else how many.
 */
CREATE FUNCTION lbs_check(q text, how text) RETURNS text
LANGUAGE plpgsql AS $$
DECLARE
	ln text;
	used boolean := false;
	want text;
	nrows bigint;
	ndiff bigint;
	answer text;
BEGIN
	PERFORM set_config('enable_seqscan', 'off', true);
	PERFORM set_config('enable_bitmapscan', (how = 'bitmap')::text, true);
	PERFORM set_config('enable_indexscan', (how = 'plain')::text, true);
	PERFORM set_config('enable_indexonlyscan', (how = 'plain')::text, true);
	PERFORM set_config('pg_lion.enable_count_pushdown', (how = 'count')::text, true);
	want := CASE how WHEN 'bitmap' THEN 'Bitmap Index Scan'
					 WHEN 'plain' THEN 'Index (Only )?Scan using'
					 ELSE 'Custom Scan \(LionCount\)' END;
	FOR ln IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP
		IF ln ~ want THEN
			used := true;
		END IF;
	END LOOP;
	EXECUTE format('CREATE TEMP TABLE lbs_on AS SELECT s::text AS r FROM (%s) s', q);

	PERFORM set_config('enable_seqscan', 'on', true);
	PERFORM set_config('enable_bitmapscan', 'off', true);
	PERFORM set_config('enable_indexscan', 'off', true);
	PERFORM set_config('enable_indexonlyscan', 'off', true);
	PERFORM set_config('pg_lion.enable_count_pushdown', 'off', true);
	EXECUTE format('CREATE TEMP TABLE lbs_off AS SELECT s::text AS r FROM (%s) s', q);
	PERFORM set_config('enable_bitmapscan', 'on', true);
	PERFORM set_config('enable_indexscan', 'on', true);
	PERFORM set_config('enable_indexonlyscan', 'on', true);
	PERFORM set_config('pg_lion.enable_count_pushdown', 'on', true);

	EXECUTE 'SELECT count(*), string_agg(r, '' '' ORDER BY r) FROM lbs_on'
		INTO nrows, answer;
	EXECUTE 'SELECT (SELECT count(*) FROM (SELECT * FROM lbs_on EXCEPT ALL SELECT * FROM lbs_off) a)'
			' + (SELECT count(*) FROM (SELECT * FROM lbs_off EXCEPT ALL SELECT * FROM lbs_on) b)'
		INTO ndiff;
	EXECUTE 'DROP TABLE lbs_on, lbs_off';
	IF ndiff <> 0 THEN
		RETURN format('MISMATCH: %s rows differ', ndiff);
	END IF;
	RETURN format('%s%s: %s', CASE WHEN used THEN '' ELSE 'no ' END, how,
				  CASE WHEN nrows <= 4 THEN answer ELSE nrows || ' rows' END);
END $$;
-- lbs_check() of q on each of the three tables, its %s the table's name.
CREATE FUNCTION lbs_all(q text, how text)
RETURNS TABLE (tbl text, result text)
LANGUAGE sql AS $$
	SELECT t, lbs_check(format(q, t), how)
	  FROM unnest(ARRAY['lion_bs', 'lion_bs4', 'lion_bs6']) WITH ORDINALITY u(t, n)
	 ORDER BY n
$$;
-- An index's containers by kind, per key column.
CREATE FUNCTION lbs_mix(idx regclass)
RETURNS TABLE (attno int2, arrays int8, bitsets int8, runs int8, narrows int8)
LANGUAGE sql AS $$
	SELECT attno, array_containers, bitset_containers, run_containers,
		   narrow_containers
	  FROM lion_index_stats(idx)
$$;
-- The kinds of the containers of a column on each table, and the bytes they
-- take: NARROWs of width 3 are 1544 each and of width 4 2056, BITSETs 4104.
CREATE FUNCTION lbs_mix_all(col text)
RETURNS TABLE (tbl text, arrays int8, bitsets int8, runs int8, narrows int8,
			   container_bytes int8)
LANGUAGE sql AS $$
	SELECT t, array_containers, bitset_containers, run_containers,
		   narrow_containers, container_bytes
	  FROM unnest(ARRAY['lion_bs', 'lion_bs4', 'lion_bs6']) WITH ORDINALITY u(t, n),
		   lion_index_stats((t || '_' || col)::regclass)
	 ORDER BY n
$$;
-- ---------- 1. the tables ----------
/*
 * 60,000 rows (30,000 in lion_bs6) with the same values in each table: a is
 * every other row and b every third, bitmaps at every key.  r is runs of 40
 * rows, four values: RUNs.  z is 0 in 150 rows of every 160, in runs that
 * fill a block's offsets, and one of five other values in the rest: 0 a RUN,
 * the others ARRAYs.  lion_bs, of seven int columns, also has the row
 * number id, s with 23 values, some 440 members a key, ARRAYs, and u with
 * 5000 values of twelve rows, a member or two at a key: sparse segments,
 * whose members an AND looks up one at a time.  lion_bs has seven container
 * keys and lion_bs4 five; lion_bs6 has three, and its indexes, made before
 * its rows, have BITSETs where a build makes NARROWs: an insert makes an
 * ARRAY it fills a BITSET, whatever else would be smaller.
 */
CREATE TABLE lion_bs (id int NOT NULL, a int NOT NULL, b int NOT NULL,
					  r int NOT NULL, s int NOT NULL, u int NOT NULL,
					  z int NOT NULL)
	WITH (autovacuum_enabled = off);
INSERT INTO lion_bs
SELECT i, i % 2, i % 3, (i / 40) % 4, i % 23, i % 5000,
	   CASE WHEN i % 160 < 150 THEN 0 ELSE 1 + i % 5 END
  FROM generate_series(1, 60000) i;
CREATE INDEX lion_bs_a ON lion_bs USING lion (a);
CREATE INDEX lion_bs_b ON lion_bs USING lion (b);
CREATE INDEX lion_bs_r ON lion_bs USING lion (r);
CREATE INDEX lion_bs_s ON lion_bs USING lion (s);
CREATE INDEX lion_bs_u ON lion_bs USING lion (u);
CREATE INDEX lion_bs_z ON lion_bs USING lion (z);
CREATE TABLE lion_bs4 (a int2 NOT NULL, b int2 NOT NULL, r int2 NOT NULL,
					   z int2 NOT NULL)
	WITH (autovacuum_enabled = off);
INSERT INTO lion_bs4
SELECT i % 2, i % 3, (i / 40) % 4, CASE WHEN i % 160 < 150 THEN 0 ELSE 1 + i % 5 END
  FROM generate_series(1, 60000) i;
CREATE INDEX lion_bs4_a ON lion_bs4 USING lion (a);
CREATE INDEX lion_bs4_b ON lion_bs4 USING lion (b);
CREATE INDEX lion_bs4_r ON lion_bs4 USING lion (r);
CREATE INDEX lion_bs4_z ON lion_bs4 USING lion (z);
CREATE TABLE lion_bs6 (LIKE lion_bs4) WITH (autovacuum_enabled = off);
CREATE INDEX lion_bs6_a ON lion_bs6 USING lion (a);
CREATE INDEX lion_bs6_b ON lion_bs6 USING lion (b);
CREATE INDEX lion_bs6_r ON lion_bs6 USING lion (r);
CREATE INDEX lion_bs6_z ON lion_bs6 USING lion (z);
INSERT INTO lion_bs6
SELECT i % 2, i % 3, (i / 40) % 4, CASE WHEN i % 160 < 150 THEN 0 ELSE 1 + i % 5 END
  FROM generate_series(1, 30000) i;
VACUUM (FREEZE, ANALYZE) lion_bs, lion_bs4, lion_bs6;
SELECT t AS tbl, count(*) FILTER (WHERE (ctid::text::point)[0] = 0) AS rows_on_page_0,
	   max((ctid::text::point)[0]) + 1 AS pages
  FROM (SELECT 'lion_bs' AS t, ctid FROM lion_bs UNION ALL
		SELECT 'lion_bs4', ctid FROM lion_bs4 UNION ALL
		SELECT 'lion_bs6', ctid FROM lion_bs6) x
 GROUP BY t ORDER BY t;
   tbl    | rows_on_page_0 | pages 
----------+----------------+-------
 lion_bs  |            136 |   442
 lion_bs4 |            226 |   266
 lion_bs6 |            226 |   133
(3 rows)

SELECT 'a' AS col, * FROM lbs_mix_all('a') UNION ALL
SELECT 'b', * FROM lbs_mix_all('b') UNION ALL
SELECT 'r', * FROM lbs_mix_all('r') UNION ALL
SELECT 'z', * FROM lbs_mix_all('z');
 col |   tbl    | arrays | bitsets | runs | narrows | container_bytes 
-----+----------+--------+---------+------+---------+-----------------
 a   | lion_bs  |      0 |       0 |    0 |      14 |           21616
 a   | lion_bs4 |      0 |       0 |    0 |      10 |           20560
 a   | lion_bs6 |      2 |       4 |    0 |       0 |           18576
 b   | lion_bs  |      0 |       0 |    0 |      21 |           32424
 b   | lion_bs4 |      3 |       0 |    0 |      12 |           28984
 b   | lion_bs6 |      3 |       6 |    0 |       0 |           26792
 r   | lion_bs  |      0 |       0 |   28 |       0 |            8048
 r   | lion_bs4 |      0 |       0 |   20 |       0 |            7264
 r   | lion_bs6 |      0 |       0 |   12 |       0 |            3652
 z   | lion_bs  |     35 |       0 |    7 |       0 |           11030
 z   | lion_bs4 |     25 |       0 |    5 |       0 |           10250
 z   | lion_bs6 |     15 |       0 |    3 |       0 |            5138
(12 rows)

SELECT 's' AS col, * FROM lbs_mix('lion_bs_s') UNION ALL
SELECT 'u', * FROM lbs_mix('lion_bs_u');
 col | attno | arrays | bitsets | runs | narrows 
-----+-------+--------+---------+------+---------
 s   |     1 |    161 |       0 |    0 |       0
 u   |     1 |      0 |       0 |    0 |       0
(2 rows)

-- ---------- 2. the count: ANDs ----------
