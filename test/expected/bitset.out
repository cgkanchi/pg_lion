-- RUN's gaps cleared from the bitmap's image; an ARRAY tested against a
-- bitmap; a member or two looked up in one; and chains of them
SELECT * FROM lbs_all('SELECT count(*) FROM %s WHERE a = 1 AND b = 2', 'count');
