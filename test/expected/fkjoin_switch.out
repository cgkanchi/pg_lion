SELECT lion_sw($$
	SELECT d.region, count(*), count(DISTINCT d.pk) FROM lion_swf f
	JOIN lion_swd d ON d.pk = f.fk
	WHERE f.x = 1 AND f.kind = 'c' GROUP BY d.region$$, true);
                                  lion_sw                                   
----------------------------------------------------------------------------
