 LionCount, walked in one batch, probed: 3 rows, 3 distinct
(1 row)

SET pg_lion.enable_semijoin = on;
SELECT lion_sw($$
	SELECT o.k, o.tag FROM lion_swo o
	WHERE NOT EXISTS (SELECT 1 FROM lion_swf f WHERE f.fk = o.k
					  AND f.x = 1 AND f.kind = 'c')$$);
