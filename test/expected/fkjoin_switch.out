(1 row)

SELECT lion_sw($$
	SELECT d.region, count(*) FROM lion_swd d
	WHERE EXISTS (SELECT 1 FROM lion_swf f WHERE f.fk = d.pk
				  AND f.x = 1 AND f.kind = 'c')
	GROUP BY d.region$$, true);
                                  lion_sw                                   
----------------------------------------------------------------------------
