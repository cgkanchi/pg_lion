 doc @@ ANY (ARRAY['$.k0 == 2', '$.u == 3']::jsonpath[])                    | t
 doc @@ ANY (ARRAY['$.k0 == 2', '1 == 1']::jsonpath[])                      | t
 doc @@ '$.k0 == 2' OR doc ? 'k1'                                           | t
 doc @@ '$.k0 == 2' AND doc ? 'k1'                                          | t
