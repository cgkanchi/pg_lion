-- lionvec, the nearest-neighbour index of pgvector's `vector` (DESIGN.md §44).
--
-- Every ORDER BY below is run through the index (the sequential scan and
-- the sort disabled, so that nothing else can be chosen) and through a
-- sequential scan and sort (the index disabled), and the two answers are
-- compared: the distances in order, and the rows.  pg_lion.vector_epsilon
-- is raised for the comparisons, so that no bound failure can make a row
-- come back late (§44.4), and pg_lion.vector_margin, so that every
-- partition that could hold a nearer row is read, and pg_lion.vector_patience
-- is off, so that the scan never pauses before it has; the default epsilon's
-- own rate is the unit tests', and the default margin's and patience's
-- recall is measured at the end.
--
-- Every index spills by default (DESIGN.md §44.3): each row with a vector
-- is in two partitions, so the comparisons are also of a scan that must
-- return each row once.  vt_spill() reads the CODE items off the pages to
-- show where the copies are.
\set VERBOSITY terse
SET client_min_messages = warning;
CREATE EXTENSION IF NOT EXISTS pg_lion;
CREATE EXTENSION IF NOT EXISTS vector;
CREATE EXTENSION IF NOT EXISTS pg_lion_vector;
CREATE EXTENSION IF NOT EXISTS pageinspect;
RESET client_min_messages;
SET synchronous_commit = on;
SET max_parallel_workers_per_gather = 0;
-- every operator class validates
SELECT opcname, amvalidate(c.oid)
  FROM pg_opclass c JOIN pg_am a ON a.oid = c.opcmethod
 WHERE a.amname = 'lionvec' ORDER BY opcname;
      opcname      | amvalidate 
-------------------+------------
 vector_cosine_ops | t
 vector_ip_ops     | t
 vector_l2_ops     | t
(3 rows)

/*
 * vt_vec() is a pseudo-random vector of n coordinates in (-scale, scale),
 * the same on every platform: from hashint8extended(), not random().
 */
CREATE FUNCTION vt_vec(seed bigint, n int, scale float8 DEFAULT 1.0)
RETURNS vector LANGUAGE sql IMMUTABLE
-- an index expression below calls it, and CREATE INDEX runs it under a safe
-- search_path from PostgreSQL 17 on, where vector would not be found
SET search_path FROM CURRENT AS $$
	SELECT array_agg(((hashint8extended(seed * 1000 + j, 42) % 100000)::float8
					  / 100000.0 * scale)::real ORDER BY j)::vector
	  FROM generate_series(1, n) j
$$;
/*
 * vec_cmp() runs q - which returns columns id and d, ORDER BY d - through
 * the index and through a sequential scan and sort, and compares the
 * distances in order (to 4 places), then the rows with a distance, sorted
 * (rows of equal distance may come in either order), then the count of rows
 * without one (NULL vectors: any of them may come).  It says whether the
 * first plan really was an index scan.
 */
CREATE FUNCTION vec_cmp(q text) RETURNS text
LANGUAGE plpgsql AS $$
DECLARE
	ln text;
	r record;
	used boolean := false;
	ad text[] := '{}';
	bd text[] := '{}';
	ai int[] := '{}';
	bi int[] := '{}';
BEGIN
	PERFORM set_config('enable_seqscan', 'off', true);
	PERFORM set_config('enable_bitmapscan', 'off', true);
	PERFORM set_config('enable_sort', 'off', true);
	FOR ln IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP
		IF ln ~ 'Index Scan using' THEN
			used := true;
		END IF;
	END LOOP;
	FOR r IN EXECUTE q LOOP
		ad := ad || coalesce(round(r.d::numeric, 4)::text, 'NULL');
		IF r.d IS NOT NULL THEN
			ai := ai || r.id;
		END IF;
	END LOOP;
	PERFORM set_config('enable_seqscan', 'on', true);
	PERFORM set_config('enable_bitmapscan', 'on', true);
	PERFORM set_config('enable_sort', 'on', true);
	PERFORM set_config('enable_indexscan', 'off', true);
	FOR r IN EXECUTE q LOOP
		bd := bd || coalesce(round(r.d::numeric, 4)::text, 'NULL');
		IF r.d IS NOT NULL THEN
			bi := bi || r.id;
		END IF;
	END LOOP;
	PERFORM set_config('enable_indexscan', 'on', true);

	IF ad IS DISTINCT FROM bd THEN
		RETURN format('MISMATCH: %s rows through the index, %s by the sort; distances %s / %s',
					  coalesce(array_length(ad, 1), 0), coalesce(array_length(bd, 1), 0),
					  ad[1:3], bd[1:3]);
	END IF;
	IF (SELECT array_agg(x ORDER BY x) FROM unnest(ai) x) IS DISTINCT FROM
	   (SELECT array_agg(x ORDER BY x) FROM unnest(bi) x) THEN
		RETURN format('MISMATCH: other rows at the same distances');
	END IF;
	RETURN format('%s, %s rows',
				  CASE WHEN used THEN 'index' ELSE 'no index' END,
				  coalesce(array_length(ad, 1), 0));
END $$;
/*
 * vt_items() reads a lionvec index's CODE items off its pages (pageinspect):
 * each one's block, the chain the block is in - its partition's number,
 * from the PART chain's heads, or -1 for the rows in no partition, -2 for
 * the NULL rows - its row's TID, its flags - 1 a NULL row, 2 a cosine zero
 * vector, 4 a row's copy in its second partition (DESIGN.md §44.2) - and the
 * rest of its bytes.  vt_spill() sums them up with the meta page's format
 * version and flags (1: the index spills): the rows (the items that are not
 * copies), the copies, the NULL rows and zeros, and whether every row has
 * one item of its own, in a chain, and at most one copy, the same but for
 * the flag and in another partition's chain.  vt_strays() counts the items
 * of rows the table does not have.  vt_refines() reads the REFINE items:
 * the rows' and the centroids' (whose TIDs are (partition, 0)), and whether
 * the rows' are one for each CODE item of a row with a vector that is not a
 * copy, by TID.  The offsets assume a little-endian server.
 */
CREATE FUNCTION vt_u16(p bytea, o int) RETURNS int LANGUAGE sql IMMUTABLE AS
$$ SELECT get_byte(p, o) | (get_byte(p, o + 1) << 8) $$;
CREATE FUNCTION vt_u32(p bytea, o int) RETURNS bigint LANGUAGE sql IMMUTABLE AS
$$ SELECT vt_u16(p, o)::bigint | (vt_u16(p, o + 2)::bigint << 16) $$;
CREATE FUNCTION vt_items(idx regclass)
RETURNS TABLE (blk int, chain int, row_tid tid, flags int, rest bytea)
LANGUAGE plpgsql AS $$
DECLARE
	bs int := current_setting('block_size')::int;
	nb int := pg_relation_size(idx) / current_setting('block_size')::int;
	chains int[] := array_fill(NULL::int, ARRAY[nb]);
	m bytea := get_raw_page(idx::text, 0);
	p bytea;
	b int;
	pb bigint;
	h bigint;
	i int;
	lp bigint;
	o int;
BEGIN
	-- the chains' blocks: each partition's from the head in its PART item
	-- (the meta page's PART head at 52), then the REST and NULL chains' (60, 68)
	pb := vt_u32(m, 52);
	WHILE pb <> 4294967295 LOOP
		p := get_raw_page(idx::text, pb::int);
		FOR i IN 1 .. (vt_u16(p, 12) - 24) / 4 LOOP
			lp := vt_u16(p, 20 + 4 * i)::bigint | (vt_u16(p, 22 + 4 * i)::bigint << 16);
			CONTINUE WHEN (lp >> 15) & 3 <> 1;
			o := (lp & 32767)::int;
			h := vt_u32(p, o + 4);
			WHILE h <> 4294967295 LOOP
				chains[h + 1] := vt_u32(p, o)::int;
				h := vt_u32(get_raw_page(idx::text, h::int), bs - 16);
			END LOOP;
		END LOOP;
		pb := vt_u32(p, bs - 16);
	END LOOP;
	FOR i IN 1 .. 2 LOOP
		h := vt_u32(m, 52 + 8 * i);
		WHILE h <> 4294967295 LOOP
			chains[h + 1] := -i;
			h := vt_u32(get_raw_page(idx::text, h::int), bs - 16);
		END LOOP;
	END LOOP;

	FOR b IN 1 .. nb - 1 LOOP
		p := get_raw_page(idx::text, b);
		-- the special space's last two words: the page's type (2, CODE) and lionvec's id
		CONTINUE WHEN vt_u16(p, bs - 4) <> 2 OR vt_u16(p, bs - 2) <> 65420;
		FOR i IN 1 .. (vt_u16(p, 12) - 24) / 4 LOOP
			lp := vt_u16(p, 20 + 4 * i)::bigint | (vt_u16(p, 22 + 4 * i)::bigint << 16);
			CONTINUE WHEN (lp >> 15) & 3 <> 1;		-- not LP_NORMAL
			o := (lp & 32767)::int;
			blk := b;
			chain := chains[b + 1];
			row_tid := format('(%s,%s)', (vt_u16(p, o)::bigint << 16) | vt_u16(p, o + 2),
							  vt_u16(p, o + 4))::tid;
			flags := vt_u16(p, o + 6);
			rest := substr(p, o + 1, 6) || substr(p, o + 9, (lp >> 17)::int - 8);
			RETURN NEXT;
		END LOOP;
	END LOOP;
END $$;
CREATE FUNCTION vt_spill(idx regclass) RETURNS text
LANGUAGE sql AS $$
	WITH it AS (SELECT * FROM vt_items(idx)),
	r AS (SELECT row_tid, count(*) FILTER (WHERE flags & 4 = 0) AS own,
				 count(*) FILTER (WHERE flags & 4 <> 0) AS copies,
				 count(DISTINCT rest) AS bodies, count(DISTINCT chain) AS chains,
				 bool_and(chain IS NOT NULL) AS chained,
				 bool_and(flags & 4 = 0 OR chain >= 0) AS in_parts,
				 bool_and(flags & 3 = 0) AS vec
			FROM it GROUP BY row_tid)
	SELECT format('format %s, flags %s: %s rows, %s copies, %s NULL or zero; %s',
				  vt_u16(get_raw_page(idx::text, 0), 28),
				  vt_u16(get_raw_page(idx::text, 0), 34),
				  (SELECT count(*) FROM it WHERE flags & 4 = 0),
				  (SELECT count(*) FROM it WHERE flags & 4 <> 0),
				  (SELECT count(*) FROM it WHERE flags & 3 <> 0),
				  CASE WHEN (SELECT bool_and(own = 1 AND chained AND (copies = 0 OR
							(copies = 1 AND vec AND bodies = 1 AND chains = 2 AND in_parts))) FROM r)
					   THEN 'each row once, any copy the same in another partition'
					   ELSE 'MALFORMED' END)
$$;
CREATE FUNCTION vt_refines(idx regclass) RETURNS text
LANGUAGE plpgsql AS $$
DECLARE
	bs int := current_setting('block_size')::int;
	p bytea;
	b int;
	i int;
	lp bigint;
	o int;
	tids tid[] := '{}';
	ncent int := 0;
	same boolean;
BEGIN
	FOR b IN 1 .. pg_relation_size(idx) / bs - 1 LOOP
		p := get_raw_page(idx::text, b);
		CONTINUE WHEN vt_u16(p, bs - 4) <> 3 OR vt_u16(p, bs - 2) <> 65420;
		FOR i IN 1 .. (vt_u16(p, 12) - 24) / 4 LOOP
			lp := vt_u16(p, 20 + 4 * i)::bigint | (vt_u16(p, 22 + 4 * i)::bigint << 16);
			CONTINUE WHEN (lp >> 15) & 3 <> 1;
			o := (lp & 32767)::int;
			IF vt_u16(p, o + 4) = 0 THEN
				ncent := ncent + 1;
			ELSE
				tids := tids || format('(%s,%s)', (vt_u16(p, o)::bigint << 16) | vt_u16(p, o + 2),
									   vt_u16(p, o + 4))::tid;
			END IF;
		END LOOP;
	END LOOP;
	SELECT (SELECT array_agg(t ORDER BY t) FROM unnest(tids) t) IS NOT DISTINCT FROM
		   (SELECT array_agg(row_tid ORDER BY row_tid) FROM vt_items(idx) WHERE flags = 0)
	  INTO same;
	RETURN format('%s rows'' refine items, %s centroids''; %s', cardinality(tids), ncent,
				  CASE WHEN same THEN 'one a row with a vector' ELSE 'MALFORMED' END);
END $$;
CREATE FUNCTION vt_strays(idx regclass) RETURNS bigint
LANGUAGE plpgsql AS $$
DECLARE
	n bigint;
BEGIN
	EXECUTE format('SELECT count(*) FROM vt_items(%L) WHERE row_tid NOT IN (SELECT ctid FROM %s)',
				   idx, (SELECT indrelid::regclass FROM pg_index WHERE indexrelid = idx)) INTO n;
	RETURN n;
END $$;
-- vt_ids() runs q, which returns a column id, and returns the ids.
CREATE FUNCTION vt_ids(q text) RETURNS SETOF int
LANGUAGE plpgsql AS $$ BEGIN RETURN QUERY EXECUTE q; END $$;
-- 3000 rows in ten clusters, five NULL vectors and one of zeros; indexed in
-- 20 partitions, which a table this small would not be by itself
CREATE TABLE vt (id int PRIMARY KEY, cat int, v vector(40))
	WITH (autovacuum_enabled = off);
INSERT INTO vt
SELECT i, i % 10, vt_vec(-(i % 10) - 1, 40) + vt_vec(i, 40, 0.3)
  FROM generate_series(1, 3000) i;
INSERT INTO vt SELECT i, NULL, NULL FROM generate_series(3001, 3005) i;
INSERT INTO vt VALUES (3006, NULL, array_fill(0, ARRAY[40])::real[]::vector);
CREATE INDEX vt_l2 ON vt USING lionvec (v) WITH (partitions = 20);
CREATE INDEX vt_ip ON vt USING lionvec (v vector_ip_ops) WITH (partitions = 20);
CREATE INDEX vt_cos ON vt USING lionvec (v vector_cosine_ops) WITH (partitions = 20);
VACUUM (ANALYZE) vt;
-- each row with a vector in two partitions, its nearest and SOAR's second:
-- two CODE items naming one REFINE item; NULL rows, and a cosine index's zero
-- vector, once
SELECT i AS index, vt_spill(i) FROM unnest('{vt_l2,vt_ip,vt_cos}'::regclass[]) i;
 index  |                                                     vt_spill                                                     
--------+------------------------------------------------------------------------------------------------------------------
 vt_l2  | format 3, flags 1: 3006 rows, 3001 copies, 5 NULL or zero; each row once, any copy the same in another partition
 vt_ip  | format 3, flags 1: 3006 rows, 3001 copies, 5 NULL or zero; each row once, any copy the same in another partition
 vt_cos | format 3, flags 1: 3006 rows, 3000 copies, 6 NULL or zero; each row once, any copy the same in another partition
(3 rows)

SET pg_lion.vector_epsilon = 6;
SET pg_lion.vector_margin = 100;
SET pg_lion.vector_patience = 0;
-- every metric, a query vector in a cluster and between them, any LIMIT
CREATE TABLE vt_cases AS
SELECT op, q, k
  FROM (VALUES ('<->'), ('<#>'), ('<=>')) o(op),
	   (VALUES ('(SELECT v FROM vt WHERE id = 7)'),
			   ('(SELECT v FROM vt WHERE id = 2999)'),
			   ('vt_vec(77, 40, 0.5)')) q(q),
	   (VALUES (1), (10), (100), (3006)) k(k);
SELECT op, k, vec_cmp(format('SELECT id, v %s %s AS d FROM vt ORDER BY v %s %s LIMIT %s',
							 op, q, op, q, k)) AS result
  FROM vt_cases ORDER BY op, q, k;
 op  |  k   |      result      
-----+------+------------------
 <#> |    1 | index, 1 rows
 <#> |   10 | index, 10 rows
 <#> |  100 | index, 100 rows
 <#> | 3006 | index, 3006 rows
 <#> |    1 | index, 1 rows
 <#> |   10 | index, 10 rows
 <#> |  100 | index, 100 rows
 <#> | 3006 | index, 3006 rows
 <#> |    1 | index, 1 rows
 <#> |   10 | index, 10 rows
 <#> |  100 | index, 100 rows
 <#> | 3006 | index, 3006 rows
 <-> |    1 | index, 1 rows
 <-> |   10 | index, 10 rows
 <-> |  100 | index, 100 rows
 <-> | 3006 | index, 3006 rows
 <-> |    1 | index, 1 rows
 <-> |   10 | index, 10 rows
 <-> |  100 | index, 100 rows
 <-> | 3006 | index, 3006 rows
 <-> |    1 | index, 1 rows
 <-> |   10 | index, 10 rows
 <-> |  100 | index, 100 rows
 <-> | 3006 | index, 3006 rows
 <=> |    1 | index, 1 rows
 <=> |   10 | index, 10 rows
 <=> |  100 | index, 100 rows
 <=> | 3006 | index, 3006 rows
 <=> |    1 | index, 1 rows
 <=> |   10 | index, 10 rows
 <=> |  100 | index, 100 rows
 <=> | 3006 | index, 3006 rows
 <=> |    1 | index, 1 rows
 <=> |   10 | index, 10 rows
 <=> |  100 | index, 100 rows
 <=> | 3006 | index, 3006 rows
(36 rows)

-- no LIMIT: every row, the NULL vectors last
SELECT vec_cmp('SELECT id, v <-> vt_vec(5, 40) AS d FROM vt ORDER BY v <-> vt_vec(5, 40)');
     vec_cmp      
------------------
 index, 3006 rows
(1 row)

-- each row once, though it is in two partitions: past the table's rows, in
-- order and by a walk (a NULL query's, and a cosine zero query's)
SET enable_seqscan = off;
SET enable_bitmapscan = off;
SET enable_sort = off;
SELECT op, count(*), count(DISTINCT id)
  FROM (VALUES ('<->'), ('<#>'), ('<=>')) o(op),
	   LATERAL vt_ids(format('SELECT id FROM vt ORDER BY v %s vt_vec(77, 40, 0.5) LIMIT 5000', op)) id
 GROUP BY op ORDER BY op;
 op  | count | count 
-----+-------+-------
 <#> |  3006 |  3006
 <-> |  3006 |  3006
 <=> |  3006 |  3006
(3 rows)

SELECT count(*), count(DISTINCT id)
  FROM (SELECT id FROM vt ORDER BY v <-> (SELECT v FROM vt WHERE id = 3001)) s;
 count | count 
-------+-------
  3006 |  3006
(1 row)

SELECT count(*), count(DISTINCT id)
  FROM (SELECT id FROM vt ORDER BY v <=> array_fill(0, ARRAY[40])::real[]::vector) s;
 count | count 
-------+-------
  3006 |  3006
(1 row)

RESET enable_seqscan;
RESET enable_bitmapscan;
RESET enable_sort;
-- ties: 1,200 rows of 30 vectors, 40 rows each at every distance, in 12
-- partitions - each row once, at its distance, at LIMITs that end a tie
-- (within one, either plan may take any of its rows)
CREATE TABLE vtt (id int, v vector(40));
INSERT INTO vtt SELECT i, vt_vec(i % 30, 40) FROM generate_series(1, 1200) i;
CREATE INDEX vtt_l2 ON vtt USING lionvec (v) WITH (partitions = 12);
SELECT vt_spill('vtt_l2');
                                                     vt_spill                                                     
------------------------------------------------------------------------------------------------------------------
 format 3, flags 1: 1200 rows, 1200 copies, 0 NULL or zero; each row once, any copy the same in another partition
(1 row)

SELECT k, vec_cmp(format('SELECT id, v <-> vt_vec(3, 40) AS d FROM vtt ORDER BY v <-> vt_vec(3, 40) LIMIT %s', k))
  FROM (VALUES (40), (80), (600), (1200), (5000)) k(k) ORDER BY k;
  k   |     vec_cmp      
------+------------------
   40 | index, 40 rows
   80 | index, 80 rows
  600 | index, 600 rows
 1200 | index, 1200 rows
 5000 | index, 1200 rows
(5 rows)

SET enable_seqscan = off;
SET enable_sort = off;
SELECT count(*), count(DISTINCT id)
  FROM (SELECT id FROM vtt ORDER BY v <-> vt_vec(3, 40) LIMIT 5000) s;
 count | count 
-------+-------
  1200 |  1200
(1 row)

RESET enable_seqscan;
RESET enable_sort;
DROP TABLE vtt;
