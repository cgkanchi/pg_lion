/*
 * vec_recall() runs q - which returns a column id - through the index and
 * through a sequential scan and sort, and returns the share of the second's
 * rows the first has.
 */
CREATE FUNCTION vec_recall(q text) RETURNS float8
LANGUAGE plpgsql AS $$
DECLARE
	a int[];
	b int[];
BEGIN
	PERFORM set_config('enable_seqscan', 'off', true);
	PERFORM set_config('enable_bitmapscan', 'off', true);
	PERFORM set_config('enable_sort', 'off', true);
	EXECUTE 'SELECT array_agg(id) FROM (' || q || ') s' INTO a;
	PERFORM set_config('enable_seqscan', 'on', true);
	PERFORM set_config('enable_bitmapscan', 'on', true);
	PERFORM set_config('enable_sort', 'on', true);
	PERFORM set_config('enable_indexscan', 'off', true);
	EXECUTE 'SELECT array_agg(id) FROM (' || q || ') s' INTO b;
	PERFORM set_config('enable_indexscan', 'on', true);
	RETURN (SELECT count(*) FROM unnest(a) x WHERE x = ANY (b))::float8 /
		greatest(cardinality(b), 1);
END $$;
-- the default margin and patience read the partitions near the query only,
-- and miss few of its nearest rows; a margin below zero reads fewer, and
-- misses more
RESET pg_lion.vector_margin;
RESET pg_lion.vector_patience;
SELECT op, avg(vec_recall(format('SELECT id FROM vt ORDER BY v %s %s LIMIT 10',
								 op, q))) >= 0.9 AS "most of the nearest"
  FROM (VALUES ('<->'), ('<#>'), ('<=>')) o(op),
	   (SELECT format('(vt_vec(-%s, 40) + vt_vec(%s, 40, 0.3))', s % 10 + 1, s + 9000) AS q
		  FROM generate_series(1, 20) s) q
 GROUP BY op ORDER BY op;
 op  | most of the nearest 
-----+---------------------
 <#> | t
 <-> | t
 <=> | t
(3 rows)

SET pg_lion.vector_margin = -10;
SELECT vec_recall('SELECT id FROM vt ORDER BY v <-> vt_vec(77, 40, 0.5) LIMIT 100') < 1 AS "fewer";
 fewer 
-------
 t
(1 row)

RESET pg_lion.vector_margin;
-- spill against none, over two tables of the first 3,000 rows: run to the
-- margin it finds as many of the nearest, and at a margin below zero,
-- which leaves rows in partitions not probed, more - the rows near a
-- partition's edge are in the next one too.  The pause is off: 30 of its
-- units are 820 of these rows, five of the twenty partitions, and in so
-- few, each two thirds of a batch of 100, the spilling index's nearest
-- come early, enter its hundred least upper bounds early, and the pause
-- then stops it at four partitions on <#> where the other runs to seven
CREATE TABLE vs (id int, v vector(40));
INSERT INTO vs SELECT i, vt_vec(-(i % 10) - 1, 40) + vt_vec(i, 40, 0.3)
  FROM generate_series(1, 3000) i;
CREATE TABLE vn AS SELECT * FROM vs;
CREATE INDEX vs_l2 ON vs USING lionvec (v) WITH (partitions = 20);
CREATE INDEX vs_ip ON vs USING lionvec (v vector_ip_ops) WITH (partitions = 20);
CREATE INDEX vs_cos ON vs USING lionvec (v vector_cosine_ops) WITH (partitions = 20);
CREATE INDEX vn_l2 ON vn USING lionvec (v) WITH (partitions = 20, spill = off);
CREATE INDEX vn_ip ON vn USING lionvec (v vector_ip_ops) WITH (partitions = 20, spill = off);
CREATE INDEX vn_cos ON vn USING lionvec (v vector_cosine_ops) WITH (partitions = 20, spill = off);
VACUUM ANALYZE vs, vn;
SELECT vt_spill('vs_l2') AS spill, vt_spill('vn_l2') AS "no spill";
                                                      spill                                                       |                                                   no spill                                                    
------------------------------------------------------------------------------------------------------------------+---------------------------------------------------------------------------------------------------------------
 format 3, flags 1: 3000 rows, 3000 copies, 0 NULL or zero; each row once, any copy the same in another partition | format 3, flags 0: 3000 rows, 0 copies, 0 NULL or zero; each row once, any copy the same in another partition
(1 row)

CREATE FUNCTION vt_recall_of(tbl text, op text) RETURNS float8
LANGUAGE sql AS $$
	SELECT avg(vec_recall(format('SELECT id FROM %s ORDER BY v %s %s LIMIT 10', tbl, op, q)))
	  FROM (SELECT format('(vt_vec(-%s, 40) + vt_vec(%s, 40, 0.3))', s % 10 + 1, s + 9000) AS q
			  FROM generate_series(1, 20) s) q
$$;
SET pg_lion.vector_patience = 0;
SELECT op, vt_recall_of('vs', op) >= vt_recall_of('vn', op) AS "as many"
  FROM (VALUES ('<->'), ('<#>'), ('<=>')) o(op) ORDER BY op;
 op  | as many 
-----+---------
 <#> | t
 <-> | t
 <=> | t
(3 rows)

SET pg_lion.vector_margin = -2;
SELECT op, vt_recall_of('vs', op) > vt_recall_of('vn', op) AS "more"
  FROM (VALUES ('<->'), ('<#>'), ('<=>')) o(op) ORDER BY op;
 op  | more 
-----+------
 <#> | t
 <-> | t
 <=> | t
(3 rows)

RESET pg_lion.vector_margin;
RESET pg_lion.vector_patience;
DROP FUNCTION vt_recall_of(text, text);
DROP TABLE vs, vn;
-- a scan that pauses at once, every partition within its margin: it still
-- fills its LIMIT, in order, from the rows it holds and then the partitions
-- after the pause
SET pg_lion.vector_margin = 100;
SET pg_lion.vector_patience = 1;
SET enable_seqscan = off;
SET enable_sort = off;
SELECT cardinality(a) AS n, a = (SELECT array_agg(x ORDER BY x) FROM unnest(a) x) AS "in order"
  FROM (SELECT array_agg(d) AS a
		  FROM (SELECT v <-> vt_vec(77, 40, 0.5) AS d FROM vt
				 ORDER BY v <-> vt_vec(77, 40, 0.5) LIMIT 300) l) s;
  n  | in order 
-----+----------
 300 | t
(1 row)

RESET enable_seqscan;
RESET enable_sort;
RESET pg_lion.vector_patience;
RESET pg_lion.vector_margin;
-- what lionvec refuses
CREATE TABLE vbad (i int, v vector(9000), w vector(3)[]);
CREATE INDEX ON vbad USING lionvec (i);
ERROR:  data type integer has no default operator class for access method "lionvec"
CREATE INDEX ON vbad USING lionvec (v);
ERROR:  column cannot have more than 8128 dimensions for lionvec index
CREATE INDEX ON vbad USING lionvec (w);
ERROR:  data type vector[] has no default operator class for access method "lionvec"
CREATE INDEX ON vbad USING lionvec (v, v);
ERROR:  access method "lionvec" does not support multicolumn indexes
CREATE INDEX ON vt USING lionvec (v) WITH (partitions = -1);
ERROR:  value -1 out of bounds for option "partitions"
CREATE INDEX ON vt USING lionvec (v) WITH (partitions = 1000001);
ERROR:  value 1000001 out of bounds for option "partitions"
CREATE INDEX ON vt USING lionvec (v) WITH (spill = maybe);
ERROR:  invalid value for boolean option "spill": maybe
ALTER INDEX vt_l2 SET (spill = 2);
ERROR:  invalid value for boolean option "spill": 2
SET pg_lion.vector_epsilon = 0.5;
ERROR:  0.5 is outside the valid range for parameter "pg_lion.vector_epsilon" (1 .. 10)
SET pg_lion.vector_batch = 0;
ERROR:  0 is outside the valid range for parameter "pg_lion.vector_batch" (1 .. 100000)
SET pg_lion.vector_margin = 1001;
ERROR:  1001 is outside the valid range for parameter "pg_lion.vector_margin" (-10 .. 1000)
SET pg_lion.vector_patience = -1;
ERROR:  -1 is outside the valid range for parameter "pg_lion.vector_patience" (0 .. 1000000)
DROP TABLE vt, vt2, vt_cases, ve, vu, vbad;
