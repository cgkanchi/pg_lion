-- ---------- 4. updates and deletes, VACUUM, this transaction's rows ----------
UPDATE slc SET i4 = -i4, i8 = i8 / 3, tz = tz + interval '1 year'
 WHERE id % 11 = 0;
DELETE FROM slc WHERE id % 13 = 0;
INSERT INTO slc (id, g, i2, i4, i8, d, tm, ts, tz)
