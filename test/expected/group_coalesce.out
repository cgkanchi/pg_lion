-- GROUP BY coalesce(col, c) in the LionCount pushdown (DESIGN.md §10,
-- "coalesce").
--
-- The groups are col's, with the rows where col is NULL counted in the group
-- of c: a group of their own, printed as c, when no row has col = c, and
-- MERGED into that key's group when one does.  The node walks col's entries
-- as for a plain GROUP BY col and holds back two of them - the NULL entry and
-- the entry whose key equals c under the grouping equality - which it emits as
-- one group after the last entry.  Every answer is compared with a sequential
-- scan with the pushdown off, as a multiset in both directions; a few are
-- printed as well, so that the value of the relabelled group shows.
\set VERBOSITY terse
SET client_min_messages = warning;
LOAD 'pg_lion';
CREATE EXTENSION IF NOT EXISTS pg_lion;
-- VACUUM can only set all-visible once the commit record is on disk
SET synchronous_commit = on;
/*
 * lion_gc() runs a query with every other scan disabled, so that a LionCount
 * path that is built at all is the plan, and again as a sequential scan with
 * the pushdown off, and compares the two.  LionOrdered (DESIGN.md §30) is
 * switched off with the rest: the core switches do not reach it, and over the
 * btree on id it offers core a presorted aggregate for count(DISTINCT id).
 */
CREATE FUNCTION lion_gc(q text) RETURNS text
LANGUAGE plpgsql AS $$
DECLARE
	ln text;
	pushed boolean := false;
	nrows bigint;
	ndiff bigint;
BEGIN
	PERFORM set_config('enable_seqscan', 'off', true);
	PERFORM set_config('enable_bitmapscan', 'off', true);
	PERFORM set_config('enable_indexscan', 'off', true);
	PERFORM set_config('enable_indexonlyscan', 'off', true);
	PERFORM set_config('pg_lion.enable_ordered_scan', 'off', true);
	PERFORM set_config('pg_lion.enable_count_pushdown', 'on', true);
	FOR ln IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP
		IF ln LIKE '%Custom Scan (LionCount)%' THEN
			pushed := true;
		END IF;
	END LOOP;
	EXECUTE format('CREATE TEMP TABLE lion_gc_on AS SELECT s::text AS r FROM (%s) s', q);
	PERFORM set_config('pg_lion.enable_count_pushdown', 'off', true);
	PERFORM set_config('enable_seqscan', 'on', true);
	EXECUTE format('CREATE TEMP TABLE lion_gc_off AS SELECT s::text AS r FROM (%s) s', q);
	PERFORM set_config('enable_bitmapscan', 'on', true);
	PERFORM set_config('enable_indexscan', 'on', true);
	PERFORM set_config('enable_indexonlyscan', 'on', true);
	PERFORM set_config('pg_lion.enable_ordered_scan', 'on', true);
	PERFORM set_config('pg_lion.enable_count_pushdown', 'on', true);
	EXECUTE 'SELECT count(*) FROM lion_gc_on' INTO nrows;
	EXECUTE 'SELECT (SELECT count(*) FROM (SELECT * FROM lion_gc_on EXCEPT ALL SELECT * FROM lion_gc_off) a)'
			' + (SELECT count(*) FROM (SELECT * FROM lion_gc_off EXCEPT ALL SELECT * FROM lion_gc_on) b)'
		INTO ndiff;
	EXECUTE 'DROP TABLE lion_gc_on, lion_gc_off';
	IF ndiff <> 0 THEN
		RETURN format('MISMATCH: %s rows differ', ndiff);
	END IF;
	RETURN format('%s, %s rows',
				  CASE WHEN pushed THEN 'pushed down' ELSE 'not pushed down' END,
				  nrows);
END $$;
/* The same under a generic plan, which keeps $n a Param. */
CREATE FUNCTION lion_gc_prep(q text, args text) RETURNS text
LANGUAGE plpgsql AS $$
DECLARE
	ln text;
	pushed boolean := false;
	nrows bigint;
	ndiff bigint;
BEGIN
	PERFORM set_config('plan_cache_mode', 'force_generic_plan', true);
	PERFORM set_config('enable_seqscan', 'off', true);
	PERFORM set_config('enable_bitmapscan', 'off', true);
	PERFORM set_config('enable_indexscan', 'off', true);
	PERFORM set_config('enable_indexonlyscan', 'off', true);
	PERFORM set_config('pg_lion.enable_ordered_scan', 'off', true);
	PERFORM set_config('pg_lion.enable_count_pushdown', 'on', true);
	EXECUTE 'PREPARE lion_gcp_on AS ' || q;
	FOR ln IN EXECUTE 'EXPLAIN (COSTS OFF) EXECUTE lion_gcp_on(' || args || ')' LOOP
		IF ln LIKE '%Custom Scan (LionCount)%' THEN
			pushed := true;
		END IF;
	END LOOP;
	EXECUTE format('CREATE TEMP TABLE lion_gc_on AS EXECUTE lion_gcp_on(%s)', args);
	PERFORM set_config('enable_seqscan', 'on', true);
	PERFORM set_config('pg_lion.enable_count_pushdown', 'off', true);
	EXECUTE 'PREPARE lion_gcp_off AS ' || q;
	EXECUTE format('CREATE TEMP TABLE lion_gc_off AS EXECUTE lion_gcp_off(%s)', args);
	PERFORM set_config('enable_bitmapscan', 'on', true);
	PERFORM set_config('enable_indexscan', 'on', true);
	PERFORM set_config('enable_indexonlyscan', 'on', true);
	PERFORM set_config('pg_lion.enable_ordered_scan', 'on', true);
	PERFORM set_config('pg_lion.enable_count_pushdown', 'on', true);
	EXECUTE 'DEALLOCATE lion_gcp_on';
	EXECUTE 'DEALLOCATE lion_gcp_off';
	EXECUTE 'SELECT count(*) FROM lion_gc_on' INTO nrows;
	EXECUTE 'SELECT (SELECT count(*) FROM (SELECT * FROM lion_gc_on EXCEPT ALL SELECT * FROM lion_gc_off) a)'
			' + (SELECT count(*) FROM (SELECT * FROM lion_gc_off EXCEPT ALL SELECT * FROM lion_gc_on) b)'
		INTO ndiff;
	EXECUTE 'DROP TABLE lion_gc_on, lion_gc_off';
	IF ndiff <> 0 THEN
		RETURN format('MISMATCH: %s rows differ', ndiff);
	END IF;
	RETURN format('%s, %s rows',
				  CASE WHEN pushed THEN 'pushed down' ELSE 'not pushed down' END,
				  nrows);
END $$;
/*
 * 3000 rows.  g: 0 .. 7, NULL on every 9th row.  h: 1 .. 5, NULL on every 6th
 * row - 0 never occurs.  a: 10 values.  t: 'x0' .. 'x4', NULL on every 13th
 * row.  b: true and false, NULL on every 7th row.  n: 4 values, NOT NULL.
 */
CREATE TABLE lion_gc (
	id	int		NOT NULL,
	g	int,
	h	int,
	a	int		NOT NULL,
	t	text,
	b	boolean,
	n	int		NOT NULL
);
INSERT INTO lion_gc
SELECT i,
	   CASE WHEN i % 9 = 0 THEN NULL ELSE (i / 2) % 8 END,
	   CASE WHEN i % 6 = 0 THEN NULL ELSE 1 + (i / 5) % 5 END,
	   i % 10,
	   CASE WHEN i % 13 = 0 THEN NULL ELSE 'x' || ((i / 7) % 5) END,
	   CASE WHEN i % 7 = 0 THEN NULL ELSE (i / 3) % 3 = 0 END,
	   (i / 11) % 4
  FROM generate_series(1, 3000) i;
CREATE INDEX lion_gc_g ON lion_gc USING lion (g);
CREATE INDEX lion_gc_h ON lion_gc USING lion (h);
CREATE INDEX lion_gc_a ON lion_gc USING lion (a);
CREATE INDEX lion_gc_t ON lion_gc USING lion (t);
CREATE INDEX lion_gc_b ON lion_gc USING lion (b);
CREATE INDEX lion_gc_n ON lion_gc USING lion (n);
CREATE UNIQUE INDEX lion_gc_id ON lion_gc (id);
VACUUM (FREEZE, ANALYZE) lion_gc;
-- ---- 1. a constant that is a key: the NULL rows join its group ------------
SELECT coalesce(g, 0) AS k, count(*) FROM lion_gc GROUP BY 1 ORDER BY 1;
 k | count 
---+-------
 0 |   667
 1 |   334
 2 |   334
 3 |   335
 4 |   333
 5 |   332
 6 |   332
 7 |   333
(8 rows)

SELECT lion_gc('SELECT coalesce(g, 0), count(*) FROM lion_gc GROUP BY 1');
       lion_gc       
---------------------
 pushed down, 8 rows
(1 row)

SELECT lion_gc('SELECT coalesce(g, 5), count(*) FROM lion_gc WHERE a = 3 GROUP BY 1');
       lion_gc       
---------------------
 pushed down, 8 rows
(1 row)

SELECT lion_gc('SELECT coalesce(g, 7), count(*), count(a) FROM lion_gc WHERE a IN (1, 2) GROUP BY 1');
       lion_gc       
---------------------
 pushed down, 8 rows
(1 row)

SELECT lion_gc('SELECT coalesce(h, 3), count(*) FROM lion_gc GROUP BY 1');
       lion_gc       
---------------------
 pushed down, 5 rows
(1 row)

SELECT lion_gc('SELECT coalesce(g, 0), count(*) FROM lion_gc WHERE a = 3 OR h = 2 GROUP BY 1');
       lion_gc       
---------------------
 pushed down, 8 rows
(1 row)

