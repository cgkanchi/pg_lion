-- HAVING over the merged group: it alone passes, and it alone fails; and
-- over the relabelled one, among others
SELECT lion_gc('SELECT coalesce(g, 0), count(*) FROM lion_gc GROUP BY 1 HAVING count(*) > 500');
       lion_gc       
---------------------
 pushed down, 1 rows
(1 row)

SELECT lion_gc('SELECT coalesce(g, 0), count(*) FROM lion_gc GROUP BY 1 HAVING count(*) < 500');
       lion_gc       
---------------------
 pushed down, 7 rows
(1 row)

SELECT lion_gc('SELECT coalesce(g, 99) FROM lion_gc GROUP BY 1 HAVING count(*) = 333');
