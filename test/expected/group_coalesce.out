-- ---- 5. what else the target list and HAVING may say --------------------
-- count(g) counts g's own rows, not the NULL rows merged in: only where the
-- WHERE rules them out, or the column is NOT NULL
SELECT lion_gc('SELECT coalesce(g, 0), count(g) FROM lion_gc GROUP BY 1');
         lion_gc         
-------------------------
 not pushed down, 8 rows
(1 row)

SELECT lion_gc('SELECT coalesce(g, 0), count(*), count(g) FROM lion_gc WHERE g IS NOT NULL GROUP BY 1');
       lion_gc       
---------------------
 pushed down, 8 rows
(1 row)

