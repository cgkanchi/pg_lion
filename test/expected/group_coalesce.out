-- ---- 10. a partitioned table ---------------------------------------------
/*
 * The first partition has NULLs and no 0, the second 0 and no NULLs: each
 * partition's node emits its own partial group of c, and core's Finalize
 * Aggregate above adds the two (DESIGN.md §16).
 */
CREATE TABLE lion_gcp (id int NOT NULL, g int, a int NOT NULL) PARTITION BY RANGE (id);
CREATE TABLE lion_gcp1 PARTITION OF lion_gcp FOR VALUES FROM (0) TO (1000);
CREATE TABLE lion_gcp2 PARTITION OF lion_gcp FOR VALUES FROM (1000) TO (2000);
INSERT INTO lion_gcp
SELECT i,
	   CASE WHEN i >= 1000 THEN i % 4 WHEN i % 5 = 0 THEN NULL ELSE 1 + i % 4 END,
	   i % 3
  FROM generate_series(0, 1999) i;
CREATE INDEX lion_gcp_g ON lion_gcp USING lion (g);
CREATE INDEX lion_gcp_a ON lion_gcp USING lion (a);
VACUUM ANALYZE lion_gcp;
SELECT coalesce(g, 0) AS k, count(*) FROM lion_gcp GROUP BY 1 ORDER BY 1;
 k | count 
---+-------
 0 |   450
 1 |   450
 2 |   450
 3 |   450
 4 |   200
(5 rows)

SELECT lion_gc('SELECT coalesce(g, 0), count(*) FROM lion_gcp GROUP BY 1');
       lion_gc       
---------------------
 pushed down, 5 rows
(1 row)

SELECT lion_gc('SELECT coalesce(g, 9), count(*) FROM lion_gcp WHERE a = 1 GROUP BY 1');
       lion_gc       
---------------------
 pushed down, 6 rows
(1 row)

SELECT lion_gc('SELECT coalesce(g, 0), count(*) FROM lion_gcp GROUP BY 1 HAVING count(*) > 400');
       lion_gc       
---------------------
 pushed down, 4 rows
(1 row)

DROP TABLE lion_gcp;
DROP TABLE lion_gc;
DROP FUNCTION lion_gc(text);
DROP FUNCTION lion_gc_prep(text, text);
