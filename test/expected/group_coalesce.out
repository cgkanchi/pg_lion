(1 row)

-- the group key only in GROUP BY, printed twice, and a column a clause pins
SELECT lion_gc('SELECT count(*) FROM lion_gc GROUP BY coalesce(g, 0)');
       lion_gc       
---------------------
 pushed down, 8 rows
