SET enable_indexscan = off;
SELECT id FROM hv ORDER BY v <-> '[1,2,3]' LIMIT 1;
ERROR:  different halfvec dimensions 40 and 3
RESET enable_indexscan;
-- inserts after the build: a new cluster, far from the others, which goes
-- to the partitions nearest it; its rows are the nearest its centre has
INSERT INTO hv
SELECT i, 10, ((hashint8extended(i::bigint, 7) & 9223372036854775807) % 100)::int,
	   hv_vec(-11, 40, 4.0) + hv_vec(i, 40, 0.3)
  FROM generate_series(3007, 3600) i;
SELECT op, k, hv_cmp(format('SELECT id, v %s %s AS d FROM hv ORDER BY v %s %s LIMIT %s',
							op, q, op, q, k)) AS result
  FROM hv_cases WHERE k IN (10, 3006) ORDER BY op, q, k;
