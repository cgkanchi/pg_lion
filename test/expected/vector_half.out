-- lionvec over pgvector's halfvec (DESIGN.md §44.1): the same index on a
-- column whose elements are IEEE 754 binary16 halves, which lionvec reads
-- as floats; the index knows its column's type from its operator class's,
-- and the scan's query is of that type too.
--
-- As in vector.sql, every ORDER BY is run through the index (the
-- sequential scan and the sort disabled) and through a sequential scan and
-- sort (the index disabled), and the two answers are compared: the
-- distances in order, and the rows; and as in vector_filter.sql, a filtered
-- one through LionOrdered and through the ordinary plan.
-- pg_lion.vector_epsilon and pg_lion.vector_margin are raised, and
-- pg_lion.vector_patience is off, so that the index's answers are the exact
-- ones.  The distances are pgvector's own functions' of halfvec.
\set VERBOSITY terse
SET client_min_messages = warning;
CREATE EXTENSION IF NOT EXISTS pg_lion;
CREATE EXTENSION IF NOT EXISTS vector;
CREATE EXTENSION IF NOT EXISTS pg_lion_vector;
RESET client_min_messages;
SET synchronous_commit = on;
SET max_parallel_workers_per_gather = 0;
-- halfvec's operator classes: one a metric, L2 the default, each one ORDER
-- BY operator of halfvec's own, and each valid
SELECT c.opcname, c.opcdefault, o.amopstrategy, o.amopopr::regoperator,
	   amvalidate(c.oid)
  FROM pg_opclass c
  JOIN pg_am a ON a.oid = c.opcmethod
  JOIN pg_amop o ON o.amopfamily = c.opcfamily
 WHERE a.amname = 'lionvec' AND c.opcintype = 'halfvec'::regtype
 ORDER BY o.amopstrategy;
      opcname       | opcdefault | amopstrategy |       amopopr        | amvalidate 
--------------------+------------+--------------+----------------------+------------
 halfvec_l2_ops     | t          |            1 | <->(halfvec,halfvec) | t
 halfvec_ip_ops     | f          |            2 | <#>(halfvec,halfvec) | t
 halfvec_cosine_ops | f          |            3 | <=>(halfvec,halfvec) | t
(3 rows)

/*
 * hv_vec() is a pseudo-random halfvec of n coordinates in (-scale, scale),
 * the same on every platform (from hashint8extended(), as vector.sql's
 * vt_vec()), each coordinate rounded to a half.
 */
CREATE FUNCTION hv_vec(seed bigint, n int, scale float8 DEFAULT 1.0)
RETURNS halfvec LANGUAGE sql IMMUTABLE
-- an index expression below calls it, and CREATE INDEX runs it under a safe
-- search_path from PostgreSQL 17 on, where halfvec would not be found
SET search_path FROM CURRENT AS $$
	SELECT array_agg(((hashint8extended(seed * 1000 + j, 44) % 100000)::float8
					  / 100000.0 * scale)::real ORDER BY j)::halfvec
	  FROM generate_series(1, n) j
$$;
/*
 * hv_cmp() runs q - which returns columns id and d, ORDER BY d - through
 * the index and through a sequential scan and sort, and compares the
 * distances in order (to 4 places), then the rows with a distance, sorted
 * (rows of equal distance may come in either order), then the count of rows
 * without one (NULL vectors: any of them may come).  It says whether the
 * first plan really was an index scan.  (vector.sql's vec_cmp().)
 */
CREATE FUNCTION hv_cmp(q text) RETURNS text
LANGUAGE plpgsql AS $$
DECLARE
	ln text;
	r record;
	used boolean := false;
	ad text[] := '{}';
	bd text[] := '{}';
	ai int[] := '{}';
	bi int[] := '{}';
BEGIN
	PERFORM set_config('enable_seqscan', 'off', true);
	PERFORM set_config('enable_bitmapscan', 'off', true);
	PERFORM set_config('enable_sort', 'off', true);
	FOR ln IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP
		IF ln ~ 'Index Scan using' THEN
			used := true;
		END IF;
	END LOOP;
	FOR r IN EXECUTE q LOOP
		ad := ad || coalesce(round(r.d::numeric, 4)::text, 'NULL');
		IF r.d IS NOT NULL THEN
			ai := ai || r.id;
		END IF;
	END LOOP;
	PERFORM set_config('enable_seqscan', 'on', true);
	PERFORM set_config('enable_bitmapscan', 'on', true);
	PERFORM set_config('enable_sort', 'on', true);
	PERFORM set_config('enable_indexscan', 'off', true);
	FOR r IN EXECUTE q LOOP
		bd := bd || coalesce(round(r.d::numeric, 4)::text, 'NULL');
		IF r.d IS NOT NULL THEN
			bi := bi || r.id;
		END IF;
	END LOOP;
	PERFORM set_config('enable_indexscan', 'on', true);

	IF ad IS DISTINCT FROM bd THEN
		RETURN format('MISMATCH: %s rows through the index, %s by the sort; distances %s / %s',
					  coalesce(array_length(ad, 1), 0), coalesce(array_length(bd, 1), 0),
					  ad[1:3], bd[1:3]);
	END IF;
	IF (SELECT array_agg(x ORDER BY x) FROM unnest(ai) x) IS DISTINCT FROM
	   (SELECT array_agg(x ORDER BY x) FROM unnest(bi) x) THEN
		RETURN format('MISMATCH: other rows at the same distances');
	END IF;
	RETURN format('%s, %s rows',
				  CASE WHEN used THEN 'index' ELSE 'no index' END,
				  coalesce(array_length(ad, 1), 0));
END $$;
/*
 * hv_ord() runs q - which returns columns id and d, ORDER BY d - through
 * LionOrdered and through the ordinary plan, and compares them as hv_cmp()
 * does; and says whether the first plan really was the node.
 * (vector_filter.sql's vf_ord().)
 */
CREATE FUNCTION hv_ord(q text) RETURNS text
LANGUAGE plpgsql AS $$
DECLARE
	ln text;
	r record;
	used boolean := false;
	ad text[] := '{}';
	bd text[] := '{}';
	ai int[] := '{}';
	bi int[] := '{}';
BEGIN
	PERFORM set_config('enable_seqscan', 'off', true);
	PERFORM set_config('enable_bitmapscan', 'off', true);
	PERFORM set_config('enable_indexscan', 'off', true);
	PERFORM set_config('enable_indexonlyscan', 'off', true);
	PERFORM set_config('enable_tidscan', 'off', true);
	FOR ln IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP
		IF ln ~ 'Custom Scan \(LionOrdered\)' THEN
			used := true;
		END IF;
	END LOOP;
	FOR r IN EXECUTE q LOOP
		ad := ad || coalesce(round(r.d::numeric, 4)::text, 'NULL');
		IF r.d IS NOT NULL THEN
			ai := ai || r.id;
		END IF;
	END LOOP;

	PERFORM set_config('enable_seqscan', 'on', true);
	PERFORM set_config('enable_bitmapscan', 'on', true);
	PERFORM set_config('enable_indexscan', 'on', true);
	PERFORM set_config('enable_indexonlyscan', 'on', true);
	PERFORM set_config('enable_tidscan', 'on', true);
	PERFORM set_config('pg_lion.enable_ordered_scan', 'off', true);
	FOR r IN EXECUTE q LOOP
		bd := bd || coalesce(round(r.d::numeric, 4)::text, 'NULL');
		IF r.d IS NOT NULL THEN
			bi := bi || r.id;
		END IF;
	END LOOP;
	PERFORM set_config('pg_lion.enable_ordered_scan', 'on', true);

	IF ad IS DISTINCT FROM bd THEN
		RETURN format('MISMATCH: %s rows through the node, %s ordinary; distances %s / %s',
					  coalesce(array_length(ad, 1), 0), coalesce(array_length(bd, 1), 0),
					  ad[1:3], bd[1:3]);
	END IF;
	IF (SELECT array_agg(x ORDER BY x) FROM unnest(ai) x) IS DISTINCT FROM
	   (SELECT array_agg(x ORDER BY x) FROM unnest(bi) x) THEN
		RETURN 'MISMATCH: other rows at the same distances';
	END IF;
	RETURN format('%s, %s rows',
				  CASE WHEN used THEN 'LionOrdered' ELSE 'no LionOrdered' END,
				  coalesce(array_length(ad, 1), 0));
END $$;
-- 3000 rows in ten clusters, five NULL vectors and one of zeros, indexed in
-- 20 partitions in each operator class; and lion indexes on two scalar
-- columns, cat (10 values, the cluster) and tag (100, independent of it)
CREATE TABLE hv (id int PRIMARY KEY, cat int, tag int, v halfvec(40))
	WITH (autovacuum_enabled = off);
INSERT INTO hv
SELECT i, i % 10, ((hashint8extended(i::bigint, 7) & 9223372036854775807) % 100)::int,
	   hv_vec(-(i % 10) - 1, 40) + hv_vec(i, 40, 0.3)
  FROM generate_series(1, 3000) i;
INSERT INTO hv SELECT i, NULL, NULL, NULL FROM generate_series(3001, 3005) i;
INSERT INTO hv VALUES (3006, NULL, NULL, array_fill(0, ARRAY[40])::real[]::halfvec);
CREATE INDEX hv_l2 ON hv USING lionvec (v) WITH (partitions = 20);
CREATE INDEX hv_ip ON hv USING lionvec (v halfvec_ip_ops) WITH (partitions = 20);
CREATE INDEX hv_cos ON hv USING lionvec (v halfvec_cosine_ops) WITH (partitions = 20);
CREATE INDEX hv_cat ON hv USING lion (cat);
CREATE INDEX hv_tag ON hv USING lion (tag);
VACUUM (FREEZE, ANALYZE) hv;
SELECT r.relname AS index, a.amname, c.opcname
  FROM pg_index i
  JOIN pg_class r ON r.oid = i.indexrelid
  JOIN pg_am a ON a.oid = r.relam
  JOIN pg_opclass c ON c.oid = i.indclass[0]
 WHERE i.indrelid = 'hv'::regclass ORDER BY r.relname;
  index  | amname  |      opcname       
---------+---------+--------------------
 hv_cat  | lion    | int4_ops
 hv_cos  | lionvec | halfvec_cosine_ops
 hv_ip   | lionvec | halfvec_ip_ops
 hv_l2   | lionvec | halfvec_l2_ops
 hv_pkey | btree   | int4_ops
 hv_tag  | lion    | int4_ops
(6 rows)

SET pg_lion.vector_epsilon = 6;
SET pg_lion.vector_margin = 100;
SET pg_lion.vector_patience = 0;
-- the five nearest row 7, for each metric, through the index (a generic
-- plan, whose query is a Param) and by the sort: the row itself first (but
-- for the inner product, which ranks by length too), then its cluster's,
-- at distances apart
SELECT v AS q7 FROM hv WHERE id = 7 \gset
PREPARE hv_l2q(halfvec) AS
	SELECT id, round((v <-> $1)::numeric, 4) AS d FROM hv ORDER BY v <-> $1 LIMIT 5;
PREPARE hv_ipq(halfvec) AS
	SELECT id, round((v <#> $1)::numeric, 4) AS d FROM hv ORDER BY v <#> $1 LIMIT 5;
PREPARE hv_cosq(halfvec) AS
	SELECT id, round((v <=> $1)::numeric, 4) AS d FROM hv ORDER BY v <=> $1 LIMIT 5;
SET plan_cache_mode = force_generic_plan;
SET enable_seqscan = off;
SET enable_sort = off;
EXPLAIN (COSTS OFF) EXECUTE hv_l2q(:'q7');
             QUERY PLAN             
------------------------------------
 Limit
   ->  Index Scan using hv_l2 on hv
         Order By: (v <-> $1)
(3 rows)

EXPLAIN (COSTS OFF) EXECUTE hv_ipq(:'q7');
             QUERY PLAN             
------------------------------------
 Limit
   ->  Index Scan using hv_ip on hv
         Order By: (v <#> $1)
(3 rows)

EXPLAIN (COSTS OFF) EXECUTE hv_cosq(:'q7');
             QUERY PLAN              
-------------------------------------
 Limit
   ->  Index Scan using hv_cos on hv
         Order By: (v <=> $1)
(3 rows)

EXECUTE hv_l2q(:'q7');
