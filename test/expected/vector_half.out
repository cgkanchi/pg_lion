RESET client_min_messages;
RESET pg_lion.vector_prefetch;
RESET enable_seqscan; RESET enable_bitmapscan; RESET enable_indexscan;
SELECT op, hv_ord(format('SELECT id, v %s hv_vec(4, 40) AS d FROM hv WHERE cat <> 5
						  ORDER BY v %s hv_vec(4, 40) LIMIT 10', op, op)) AS result
  FROM (VALUES ('<->'), ('<#>'), ('<=>')) o(op) ORDER BY op;
 op  |        result        
-----+----------------------
 <#> | LionOrdered, 10 rows
 <-> | LionOrdered, 10 rows
 <=> | LionOrdered, 10 rows
(3 rows)

RESET pg_lion.vector_exact_rows;
RESET pg_lion.vector_exact_per_partition;
-- an expression index of a vector column as halfvec: the index's type is
-- its operator class's, halfvec, and the exact distances are of the
-- expression, computed from the table's vectors
CREATE TABLE hvx (id int, v vector(40));
INSERT INTO hvx SELECT id, v::vector FROM hv WHERE id <= 2000;
CREATE INDEX hvx_cos ON hvx USING lionvec ((v::halfvec(40)) halfvec_cosine_ops)
	WITH (partitions = 10);
SELECT hv_cmp('SELECT id, v::halfvec(40) <=> hv_vec(5, 40) AS d FROM hvx
			   ORDER BY v::halfvec(40) <=> hv_vec(5, 40) LIMIT 20');
     hv_cmp     
----------------
 index, 20 rows
(1 row)

-- a table empty at the build, whose column has no dimensions: the first
-- row sets them, and a row of others is pgvector's error
CREATE TABLE hve (id int, v halfvec);
CREATE INDEX hve_l2 ON hve USING lionvec (v);
CREATE INDEX hve_ip ON hve USING lionvec (v halfvec_ip_ops);
INSERT INTO hve VALUES (1, '[1,2,3]'), (2, '[3,2,1]'), (3, NULL), (4, '[0,0,1]'),
	(5, '[0.5,0.25,-0.125]');
INSERT INTO hve VALUES (6, '[1,2,3,4]');
ERROR:  expected 3 dimensions, not 4
SET enable_seqscan = off;
EXPLAIN (COSTS OFF) SELECT id FROM hve ORDER BY v <-> '[1,1,2]' LIMIT 2;
                  QUERY PLAN                  
----------------------------------------------
 Limit
   ->  Index Scan using hve_l2 on hve
         Order By: (v <-> '[1,1,2]'::halfvec)
(3 rows)

SELECT id, v <-> '[1,1,2]' AS d FROM hve ORDER BY v <-> '[1,1,2]';
 id |         d          
----+--------------------
  1 | 1.4142135623730951
  4 | 1.7320508075688772
  5 | 2.3082731640774234
  2 |  2.449489742783178
  3 |                   
(5 rows)

SELECT id, v <#> '[1,1,2]' AS d FROM hve ORDER BY v <#> '[1,1,2]';
 id |  d   
----+------
  1 |   -9
  2 |   -7
  4 |   -2
  5 | -0.5
