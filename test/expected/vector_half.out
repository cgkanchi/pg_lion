(5 rows)

SELECT id, round((v <=> :'q7')::numeric, 4) AS d FROM hv ORDER BY v <=> :'q7' LIMIT 5;
  id  |   d    
------+--------
    7 | 0.0000
  577 | 0.0397
 2247 | 0.0433
