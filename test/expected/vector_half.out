RESET enable_seqscan;
RESET enable_sort;
RESET plan_cache_mode;
DEALLOCATE hv_l2q;
DEALLOCATE hv_ipq;
DEALLOCATE hv_cosq;
SET enable_indexscan = off;
SELECT id, round((v <-> :'q7')::numeric, 4) AS d FROM hv ORDER BY v <-> :'q7' LIMIT 5;
  id  |   d    
------+--------
    7 | 0.0000
  577 | 1.0759
 2247 | 1.1076
  947 | 1.1697
 1877 | 1.1877
(5 rows)

SELECT id, round((v <#> :'q7')::numeric, 4) AS d FROM hv ORDER BY v <#> :'q7' LIMIT 5;
  id  |    d     
------+----------
 1257 | -15.2675
  487 | -15.0838
  787 | -15.0278
 1407 | -14.9593
