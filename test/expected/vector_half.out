(5 rows)

SELECT id FROM hve ORDER BY v <-> '[1,1]';
ERROR:  different halfvec dimensions 3 and 2
RESET enable_seqscan;
-- what lionvec refuses of halfvec: too many dimensions, an array
CREATE TABLE hvbad (v halfvec(9000), w halfvec(3)[]);
CREATE INDEX ON hvbad USING lionvec (v);
ERROR:  column cannot have more than 8128 dimensions for lionvec index
CREATE INDEX ON hvbad USING lionvec (w);
ERROR:  data type halfvec[] has no default operator class for access method "lionvec"
RESET pg_lion.vector_patience;
RESET pg_lion.vector_margin;
RESET pg_lion.vector_epsilon;
DROP TABLE hv, hv_cases, hvx, hve, hvbad;
DROP FUNCTION hv_ord(text);
DROP FUNCTION hv_cmp(text);
DROP FUNCTION hv_vec(bigint, int, float8);
