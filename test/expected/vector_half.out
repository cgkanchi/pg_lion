RESET enable_seqscan;
RESET enable_sort;
-- filtered through LionOrdered, which hands lion's set of the WHERE to the
-- vector scan (DESIGN.md §44.6): a filter of more members than
-- pg_lion.vector_exact_rows (2,000) probes partitions, one of fewer
-- computes every member's distance from the table
PREPARE hv_f(int, halfvec) AS
	SELECT id FROM hv WHERE tag = $1 ORDER BY v <=> $2 LIMIT 10;
SET plan_cache_mode = force_generic_plan;
SET enable_seqscan = off; SET enable_bitmapscan = off; SET enable_indexscan = off;
EXPLAIN (COSTS OFF) EXECUTE hv_f(3, :'q7');
              QUERY PLAN               
---------------------------------------
 Limit
   ->  Custom Scan (LionOrdered) on hv
         Ordered By: hv_cos
         Order By: (v <=> $2)
         Lion Cond: (tag = $1)
         Lion Indexes: hv_tag
(6 rows)

RESET enable_seqscan; RESET enable_bitmapscan; RESET enable_indexscan;
RESET plan_cache_mode;
DEALLOCATE hv_f;
SELECT op, f, k,
	   hv_ord(format('SELECT id, v %s hv_vec(4, 40) AS d FROM hv WHERE %s
					  ORDER BY v %s hv_vec(4, 40) %s', op, f, op, k)) AS result
  FROM (VALUES ('<->'), ('<#>'), ('<=>')) o(op),
	   (VALUES ('cat <> 5'), ('tag = 3'), ('cat IN (1, 2) AND tag < 50'),
			   ('tag = 1000')) f(f),
	   (VALUES ('LIMIT 10'), ('')) k(k)
 ORDER BY op, f, k;
 op  |             f              |    k     |         result         
