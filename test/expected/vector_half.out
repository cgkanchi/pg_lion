 <-> | cat IN (1, 2) AND tag < 50 |          | LionOrdered, 298 rows
 <-> | cat IN (1, 2) AND tag < 50 | LIMIT 10 | LionOrdered, 10 rows
 <-> | tag = 1000                 |          | LionOrdered, 0 rows
 <-> | tag = 1000                 | LIMIT 10 | LionOrdered, 0 rows
 <-> | tag = 3                    |          | LionOrdered, 38 rows
 <-> | tag = 3                    | LIMIT 10 | LionOrdered, 10 rows
 <=> | cat <> 5                   |          | LionOrdered, 3294 rows
 <=> | cat <> 5                   | LIMIT 10 | LionOrdered, 10 rows
 <=> | cat IN (1, 2) AND tag < 50 |          | LionOrdered, 298 rows
 <=> | cat IN (1, 2) AND tag < 50 | LIMIT 10 | LionOrdered, 10 rows
 <=> | tag = 1000                 |          | LionOrdered, 0 rows
 <=> | tag = 1000                 | LIMIT 10 | LionOrdered, 0 rows
 <=> | tag = 3                    |          | LionOrdered, 38 rows
 <=> | tag = 3                    | LIMIT 10 | LionOrdered, 10 rows
(24 rows)

-- the exact path: the scan's DEBUG1 line says it fetched every member, and
-- read no partition; at pg_lion.vector_exact_rows = 0 the same filter
-- probes (pg_lion.vector_exact_per_partition 0 too: its 38 members are 1.9
-- a partition of the 20, near its 1.5), and at 5,000 a filter of 3,294
-- members is exact; the order is the same either way
SET enable_seqscan = off; SET enable_bitmapscan = off; SET enable_indexscan = off;
-- (with no prefetch, whose counts the line would add: vector_scan_parallel)
SET pg_lion.vector_prefetch = off;
SET client_min_messages = debug1;
SELECT id FROM hv WHERE tag = 3 ORDER BY v <-> hv_vec(4, 40) LIMIT 3;
DEBUG:  lionvec scan of "hv_l2": 38 members fetched, 3 returned
  id  
------
 1627
 1537
 1302
