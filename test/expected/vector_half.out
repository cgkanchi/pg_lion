RESET enable_indexscan;
-- every metric, a query in a cluster, at one's edge and between them, at
-- any LIMIT: the same distances and rows as the sort's
CREATE TABLE hv_cases AS
SELECT op, q, k
  FROM (VALUES ('<->'), ('<#>'), ('<=>')) o(op),
	   (VALUES ('(SELECT v FROM hv WHERE id = 7)'),
			   ('(SELECT v FROM hv WHERE id = 2999)'),
			   ('hv_vec(77, 40, 0.5)')) q(q),
	   (VALUES (1), (10), (100), (3006)) k(k);
SELECT op, q, k, hv_cmp(format('SELECT id, v %s %s AS d FROM hv ORDER BY v %s %s LIMIT %s',
							   op, q, op, q, k)) AS result
  FROM hv_cases ORDER BY op, q, k;
 op  |                 q                  |  k   |      result      
-----+------------------------------------+------+------------------
 <#> | (SELECT v FROM hv WHERE id = 2999) |    1 | index, 1 rows
 <#> | (SELECT v FROM hv WHERE id = 2999) |   10 | index, 10 rows
 <#> | (SELECT v FROM hv WHERE id = 2999) |  100 | index, 100 rows
 <#> | (SELECT v FROM hv WHERE id = 2999) | 3006 | index, 3006 rows
 <#> | (SELECT v FROM hv WHERE id = 7)    |    1 | index, 1 rows
 <#> | (SELECT v FROM hv WHERE id = 7)    |   10 | index, 10 rows
 <#> | (SELECT v FROM hv WHERE id = 7)    |  100 | index, 100 rows
 <#> | (SELECT v FROM hv WHERE id = 7)    | 3006 | index, 3006 rows
 <#> | hv_vec(77, 40, 0.5)                |    1 | index, 1 rows
