(1 row)

SELECT rbi_ccmp('rbi_cnt_c10', 'rbi_cnt', 'c10', '7::int8');
 rbi_ccmp 
----------
 ok 20000
(1 row)

SELECT rbi_ccmp('rbi_cnt_c10', 'rbi_cnt', 'c10', '7::int2');
