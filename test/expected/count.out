DROP TABLE lion_cnt;
/*
 * DROP EXTENSION + CREATE EXTENSION in one backend (2026-09-20 review,
 * finding 7).  CASCADE takes every lion index with it, so recreating the
 * extension legitimately gives the access method a NEW pg_am Oid.  The count
 * functions used to cache the old one in a process-local static and then
 * reject every index with "is not a lion index"; the Oid now comes from
 * the AMNAME syscache, which is invalidated properly.  (This is the last
 * thing this file does: the CASCADE drops the indexes of every lion index
 * in the database.)
 */
CREATE TABLE lion_cnt_re (k int4);
INSERT INTO lion_cnt_re SELECT i % 10 FROM generate_series(1, 1000) i;
CREATE INDEX lion_cnt_re_k ON lion_cnt_re USING lion (k);
SELECT lion_index_count('lion_cnt_re_k', 3);
 lion_index_count 
------------------
              100
(1 row)

DROP EXTENSION pg_lion CASCADE;
CREATE EXTENSION pg_lion;
SELECT to_regclass('lion_cnt_re_k') IS NULL AS index_dropped_by_cascade;
 index_dropped_by_cascade 
--------------------------
 t
(1 row)

CREATE INDEX lion_cnt_re_k ON lion_cnt_re USING lion (k);
SELECT lion_index_count('lion_cnt_re_k', 3);
 lion_index_count 
------------------
              100
(1 row)

SELECT lion_index_verify('lion_cnt_re_k', true);
 lion_index_verify 
-------------------
 
(1 row)

SELECT count(*) FROM lion_cnt_re WHERE k = 3;
 count 
-------
   100
(1 row)

