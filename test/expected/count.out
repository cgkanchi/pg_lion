-----------
 ok 0
(1 row)

-- an intersection that is empty although both keys exist
SELECT rbi_ccmp2('rbi_cnt_c10', '1', 'rbi_cnt_c5000', '0',
				 'rbi_cnt', 'c10', 'c5000');
