(1 row)

DROP INDEX rbi_cnt_tiny_k;
INSERT INTO rbi_cnt_tiny VALUES (1);
CREATE INDEX rbi_cnt_tiny_k ON rbi_cnt_tiny USING roaring (k);
SELECT rbi_ccmp('rbi_cnt_tiny_k', 'rbi_cnt_tiny', 'k', '1');
