(1 row)

/*
 * Snapshot behaviour.  A cross-session test needs isolationtester (see
 * test/isolation/count_snapshot.spec); what a single session can show is that
 * the count uses the *active* snapshot, so inside a REPEATABLE READ
 * transaction it tracks the transaction's own changes and forgets them again
 * when they are rolled back.
 */
BEGIN ISOLATION LEVEL REPEATABLE READ;
SELECT lion_index_count('lion_cnt_c10', 0) = (SELECT count(*) FROM lion_cnt WHERE c10 = 0) AS agrees;
 agrees 
--------
 t
(1 row)

DELETE FROM lion_cnt WHERE c10 = 0 AND i % 30 = 10;
SELECT lion_index_count('lion_cnt_c10', 0) = (SELECT count(*) FROM lion_cnt WHERE c10 = 0) AS agrees_after_own_delete;
 agrees_after_own_delete 
-------------------------
 t
(1 row)

SAVEPOINT s;
DELETE FROM lion_cnt WHERE c10 = 0 AND i % 30 = 20;
SELECT lion_index_count('lion_cnt_c10', 0) = (SELECT count(*) FROM lion_cnt WHERE c10 = 0) AS agrees_in_subxact;
 agrees_in_subxact 
-------------------
 t
(1 row)

ROLLBACK TO s;
SELECT lion_index_count('lion_cnt_c10', 0) = (SELECT count(*) FROM lion_cnt WHERE c10 = 0) AS agrees_after_rollback_to;
 agrees_after_rollback_to 
--------------------------
 t
(1 row)

ROLLBACK;
SELECT lion_ccmp('lion_cnt_c10', 'lion_cnt', 'c10', '0');
 lion_ccmp 
-----------
 ok 10000
(1 row)

BEGIN ISOLATION LEVEL READ COMMITTED;
SELECT lion_index_count('lion_cnt_c10', 0) = (SELECT count(*) FROM lion_cnt WHERE c10 = 0) AS agrees;
 agrees 
--------
 t
(1 row)

DELETE FROM lion_cnt WHERE c10 = 0 AND i % 50 = 30;
SELECT lion_index_count('lion_cnt_c10', 0) = (SELECT count(*) FROM lion_cnt WHERE c10 = 0) AS agrees_after_own_delete;
 agrees_after_own_delete 
-------------------------
 t
(1 row)

ROLLBACK;
-- Serializable transactions must take the same predicate locks an
-- index-only scan would, and must still produce the right answer.
BEGIN ISOLATION LEVEL SERIALIZABLE;
SELECT lion_ccmp('lion_cnt_c10', 'lion_cnt', 'c10', '0');
 lion_ccmp 
-----------
 ok 10000
(1 row)

SELECT lion_ccmp('lion_cnt_c5000', 'lion_cnt', 'c5000', '1234');
 lion_ccmp 
-----------
 ok 40
(1 row)

COMMIT;
/*
 * Bounded recheck batches (2026-09-20 review, finding 6).
 *
 * The candidate TIDs of blocks that are not all-visible used to be kept until
 * the whole merge was over: 20 million of them - which a hot standby produces
 * for any 20-million-row posting set, because it never trusts the visibility
 * map - meant a 192 MiB array.  The list is now flushed whenever it reaches a
 * budget taken from work_mem, at a block boundary so that no heap block is
 * visited twice.  With the minimum work_mem the budget is about 10900 TIDs,
 * so the counts below take several batches each, and every answer and every
 * statistic must be exactly what one single batch produces.
 */
DELETE FROM lion_cnt WHERE i % 37 = 0;	-- every heap page is dirty again
CREATE TEMP TABLE lion_wm (q text, budget text, cnt bigint, blocks_skipped bigint,
						  tids_rechecked bigint, blocks_rechecked bigint,
						  cache_hits bigint);
SET work_mem = '64kB';
INSERT INTO lion_wm SELECT 'b3f', 'min', *
  FROM lion_index_count_stats('lion_cnt_b3', false);
INSERT INTO lion_wm SELECT 'c10', 'min', *
  FROM lion_index_count_stats('lion_cnt_c10', 0);
SELECT lion_ccmp('lion_cnt_b3', 'lion_cnt', 'b3', 'false');
 lion_ccmp 
-----------
 ok 97297
(1 row)

SELECT lion_ccmp('lion_cnt_c5000', 'lion_cnt', 'c5000', '1234');
 lion_ccmp 
-----------
 ok 39
(1 row)

SELECT lion_ccmp2('lion_cnt_c10', '3', 'lion_cnt_m7', '2', 'lion_cnt', 'c10', 'm7');
 lion_ccmp2 
------------
 ok 2780
(1 row)

RESET work_mem;
INSERT INTO lion_wm SELECT 'b3f', 'big', *
  FROM lion_index_count_stats('lion_cnt_b3', false);
INSERT INTO lion_wm SELECT 'c10', 'big', *
  FROM lion_index_count_stats('lion_cnt_c10', 0);
-- one answer per query, whatever the budget was
SELECT q, count(DISTINCT (cnt, blocks_skipped, tids_rechecked, blocks_rechecked))
			AS answers
  FROM lion_wm GROUP BY q ORDER BY q;
  q  | answers 
-----+---------
 b3f |       1
 c10 |       1
(2 rows)

SELECT cnt = (SELECT count(*) FROM lion_cnt WHERE NOT b3) AS count_ok,
	   tids_rechecked > 40000 AS enough_tids_for_several_batches
  FROM lion_wm WHERE q = 'b3f' AND budget = 'min';
 count_ok | enough_tids_for_several_batches 
----------+---------------------------------
 t        | t
(1 row)

-- a single count visits every heap block once, so it never has a cache hit
SELECT count(*) FILTER (WHERE cache_hits <> 0) AS single_counts_with_cache_hits
  FROM lion_wm;
 single_counts_with_cache_hits 
-------------------------------
                             0
(1 row)

DROP TABLE lion_wm;
/*
 * The batched heap recheck.
 *
 * Blocks that are not all-visible are visited one BLOCK at a time: the buffer
 * is read and share-locked once and every TID of the posting set that lives
 * on it is resolved under that one lock (lion_count.c, lion_recheck_heap_heap).
 * lion_index_count_stats() reports both numbers, so a posting set that is
 * dense enough to put many members on one page must report far fewer blocks
 * than TIDs -- that ratio IS the batching.
 *
 * The table is also the HOT test.  fillfactor leaves room on every page, and
 * payload is in no index, so UPDATEs of it are HOT: the index keeps pointing
 * at the root of the chain and the recheck has to follow the chain to find
 * the version this snapshot can see.  That is what heap_hot_search_buffer()
 * does, and getting it wrong would show up as a count that disagrees with
 * count(*) -- or, with a broken chain walk, as a count that agrees today and
 * not after the second UPDATE.
 */
CREATE TABLE lion_cnt_hot (id int4 NOT NULL, k int4 NOT NULL, g int4 NOT NULL,
						  payload int4 NOT NULL) WITH (fillfactor = 50);
INSERT INTO lion_cnt_hot
SELECT i, i % 5, i % 37, 0 FROM generate_series(1, 20000) i;
CREATE INDEX lion_cnt_hot_k ON lion_cnt_hot USING lion (k);
CREATE INDEX lion_cnt_hot_g ON lion_cnt_hot USING lion (g);
VACUUM ANALYZE lion_cnt_hot;
-- everything all-visible: no heap visit, so no blocks either
SELECT count = 4000 AS count_ok, blocks_skipped > 0 AS skipped_some,
       tids_rechecked = 0 AS nothing_rechecked,
       blocks_rechecked = 0 AS no_blocks_rechecked
  FROM lion_index_count_stats('lion_cnt_hot_k', 0);
 count_ok | skipped_some | nothing_rechecked | no_blocks_rechecked 
----------+--------------+-------------------+---------------------
 t        | t            | t                 | t
(1 row)

-- HOT updates: the chains the recheck has to walk.  A HOT update adds no
-- index entry, which is exactly why the index's TID count must not move.
UPDATE lion_cnt_hot SET payload = payload + 1 WHERE id % 3 = 0;
UPDATE lion_cnt_hot SET payload = payload + 1 WHERE id % 6 = 0;
SELECT ntids = 20000 AS index_unchanged_by_hot_updates
  FROM lion_index_stats('lion_cnt_hot_k');
 index_unchanged_by_hot_updates 
--------------------------------
 t
(1 row)

DELETE FROM lion_cnt_hot WHERE id % 7 = 0;
/*
 * Every page has been touched by now, so the whole posting set comes back
 * through the recheck: 4000 TIDs on a couple of hundred blocks.
 */
SELECT count = (SELECT count(*) FROM lion_cnt_hot WHERE k = 0) AS count_ok,
       tids_rechecked = 4000 AS all_rechecked,
       blocks_rechecked > 0 AS visited_blocks,
       blocks_rechecked * 10 < tids_rechecked AS batched_by_block
  FROM lion_index_count_stats('lion_cnt_hot_k', 0);
 count_ok | all_rechecked | visited_blocks | batched_by_block 
----------+---------------+----------------+------------------
 t        | t             | t              | t
(1 row)

SELECT lion_ccmp('lion_cnt_hot_k', 'lion_cnt_hot', 'k', '0');
 lion_ccmp 
-----------
 ok 3429
(1 row)

SELECT lion_ccmp('lion_cnt_hot_k', 'lion_cnt_hot', 'k', '3');
 lion_ccmp 
-----------
 ok 3429
(1 row)

SELECT lion_ccmp('lion_cnt_hot_g', 'lion_cnt_hot', 'g', '0');
 lion_ccmp 
-----------
 ok 463
(1 row)

SELECT lion_ccmp2('lion_cnt_hot_k', '1', 'lion_cnt_hot_g', '11',
				 'lion_cnt_hot', 'k', 'g');
 lion_ccmp2 
------------
 ok 93
(1 row)

-- A third update on top of the deleted rows: longer chains, and roots whose
-- chain ends in a dead tuple.
UPDATE lion_cnt_hot SET payload = payload + 1 WHERE id % 11 = 0;
SELECT lion_ccmp('lion_cnt_hot_k', 'lion_cnt_hot', 'k', '0');
 lion_ccmp 
-----------
 ok 3429
(1 row)

SELECT lion_ccmp('lion_cnt_hot_k', 'lion_cnt_hot', 'k', '4');
 lion_ccmp 
-----------
 ok 3428
(1 row)

/*
 * The same thing in a SERIALIZABLE transaction.  The recheck resolves each
 * TID with heap_hot_search_buffer(), which is the function the table AM's own
 * fetch uses, so it takes the same per-tuple predicate locks; the all-visible
 * blocks that are never looked at are locked page-wise.  Either way a
 * serializable reader must leave SIReadLocks behind on the table.
 */
BEGIN ISOLATION LEVEL SERIALIZABLE;
SELECT lion_ccmp('lion_cnt_hot_k', 'lion_cnt_hot', 'k', '0');
 lion_ccmp 
-----------
 ok 3429
(1 row)

SELECT lion_ccmp2('lion_cnt_hot_k', '2', 'lion_cnt_hot_g', '5',
				 'lion_cnt_hot', 'k', 'g');
 lion_ccmp2 
------------
 ok 92
(1 row)

SELECT count(*) > 0 AS took_predicate_locks
  FROM pg_locks
 WHERE mode = 'SIReadLock'
   AND relation = 'lion_cnt_hot'::regclass;
 took_predicate_locks 
----------------------
 t
(1 row)

COMMIT;
-- ... and once more with every block all-visible again.
VACUUM lion_cnt_hot;
BEGIN ISOLATION LEVEL SERIALIZABLE;
SELECT lion_ccmp('lion_cnt_hot_k', 'lion_cnt_hot', 'k', '0');
 lion_ccmp 
-----------
 ok 3429
(1 row)

SELECT count(*) > 0 AS took_predicate_locks
  FROM pg_locks
 WHERE mode = 'SIReadLock'
   AND relation = 'lion_cnt_hot'::regclass;
 took_predicate_locks 
----------------------
 t
(1 row)

COMMIT;
SELECT count = (SELECT count(*) FROM lion_cnt_hot WHERE k = 0) AS count_ok,
       tids_rechecked = 0 AS nothing_rechecked,
       blocks_rechecked = 0 AS no_blocks_rechecked
  FROM lion_index_count_stats('lion_cnt_hot_k', 0);
 count_ok | nothing_rechecked | no_blocks_rechecked 
----------+-------------------+---------------------
 t        | t                 | t
(1 row)

/*
 * The GROUP BY path of DESIGN.md section 10 intersects the same WHERE posting
 * sets with every group, and lion_count.c answers those from a materialized
 * copy after the first group (the group's own set is still read page by page,
 * which is what keeps the visibility-map interlock).  The pushdown is what
 * drives that code, so this one section turns it on -- and compares it
 * against the same query with the pushdown off, which is the reference.
 */
SET pg_lion.enable_count_pushdown = on;
CREATE TEMP TABLE lion_grp_on AS
SELECT g, count(*) AS n FROM lion_cnt_hot WHERE k = 0 GROUP BY g;
CREATE TEMP TABLE lion_grp_on2 AS
SELECT g, count(*) AS n FROM lion_cnt_hot GROUP BY g;
SET pg_lion.enable_count_pushdown = off;
CREATE TEMP TABLE lion_grp_off AS
SELECT g, count(*) AS n FROM lion_cnt_hot WHERE k = 0 GROUP BY g;
CREATE TEMP TABLE lion_grp_off2 AS
SELECT g, count(*) AS n FROM lion_cnt_hot GROUP BY g;
SELECT (SELECT count(*) FROM (SELECT * FROM lion_grp_on EXCEPT ALL SELECT * FROM lion_grp_off) x) AS extra_rows,
       (SELECT count(*) FROM (SELECT * FROM lion_grp_off EXCEPT ALL SELECT * FROM lion_grp_on) x) AS missing_rows,
       (SELECT count(*) FROM lion_grp_on) AS groups;
 extra_rows | missing_rows | groups 
------------+--------------+--------
          0 |            0 |     37
(1 row)

SELECT (SELECT count(*) FROM (SELECT * FROM lion_grp_on2 EXCEPT ALL SELECT * FROM lion_grp_off2) x) AS extra_rows,
       (SELECT count(*) FROM (SELECT * FROM lion_grp_off2 EXCEPT ALL SELECT * FROM lion_grp_on2) x) AS missing_rows,
       (SELECT count(*) FROM lion_grp_on2) AS groups;
 extra_rows | missing_rows | groups 
------------+--------------+--------
          0 |            0 |     37
(1 row)

-- and again with the dirty heap under it, so the materialized WHERE set is
-- ANDed against groups whose blocks all go through the recheck
DELETE FROM lion_cnt_hot WHERE id % 13 = 0;
SET pg_lion.enable_count_pushdown = on;
CREATE TEMP TABLE lion_grp_on3 AS
SELECT g, count(*) AS n FROM lion_cnt_hot WHERE k = 0 GROUP BY g;
SET pg_lion.enable_count_pushdown = off;
CREATE TEMP TABLE lion_grp_off3 AS
SELECT g, count(*) AS n FROM lion_cnt_hot WHERE k = 0 GROUP BY g;
SELECT (SELECT count(*) FROM (SELECT * FROM lion_grp_on3 EXCEPT ALL SELECT * FROM lion_grp_off3) x) AS extra_rows,
       (SELECT count(*) FROM (SELECT * FROM lion_grp_off3 EXCEPT ALL SELECT * FROM lion_grp_on3) x) AS missing_rows,
       (SELECT sum(n) FROM lion_grp_on3) AS total;
 extra_rows | missing_rows | total 
------------+--------------+-------
          0 |            0 |  3165
(1 row)

DROP TABLE lion_grp_on, lion_grp_on2, lion_grp_on3,
		   lion_grp_off, lion_grp_off2, lion_grp_off3;
/*
 * The per-query visibility cache (DESIGN.md section 9).
 *
 * A grouped count rechecks the dirty heap blocks of every group separately,
 * so 200 groups used to fetch the same dirty pages 200 times.  A TID's
 * visibility under one MVCC snapshot cannot change while that snapshot is
 * held, so the answer for every root line pointer of a page is resolved once
 * and reused: the block visits of the later groups become bitmap lookups with
 * no buffer access at all.
 *
 * lion_index_count_group_stats(idx, use_cache) is the SQL image of the
 * GROUP BY driver -- the same entry scan, one count per group, one cache for
 * the whole run -- so both halves of the A/B fit in one query.  What must
 * hold:
 *
 *	- the answer does not depend on the cache, and is the answer of the
 *	  equivalent GROUP BY;
 *	- the number of block visits does not depend on the cache either; what
 *	  changes is how many of them are fetches (blocks_rechecked) and how many
 *	  are cache hits;
 *	- the fetches collapse to about two per dirty page (the first visit only
 *	  records the block, the second resolves it), whatever the group count.
 */
CREATE TEMP TABLE lion_vc (idx text, mode text, groups bigint, cnt bigint,
						  blocks_skipped bigint, tids_rechecked bigint,
						  blocks_rechecked bigint, cache_hits bigint,
						  cache_full bigint);
INSERT INTO lion_vc
SELECT 'hot_g', 'nocache', * FROM lion_index_count_group_stats('lion_cnt_hot_g', false);
INSERT INTO lion_vc
SELECT 'hot_g', 'cached', * FROM lion_index_count_group_stats('lion_cnt_hot_g', true);
INSERT INTO lion_vc
SELECT 'hot_k', 'nocache', * FROM lion_index_count_group_stats('lion_cnt_hot_k', false);
INSERT INTO lion_vc
SELECT 'hot_k', 'cached', * FROM lion_index_count_group_stats('lion_cnt_hot_k', true);
-- one answer per index, whether or not the cache was used ...
SELECT idx, count(DISTINCT (groups, cnt, blocks_skipped, tids_rechecked)) AS answers,
	   count(DISTINCT blocks_rechecked + cache_hits) AS block_visits
  FROM lion_vc GROUP BY idx ORDER BY idx;
  idx  | answers | block_visits 
-------+---------+--------------
 hot_g |       1 |            1
 hot_k |       1 |            1
(2 rows)

-- ... and it is the answer of the equivalent GROUP BY
SELECT idx,
	   cnt = (SELECT count(*) FROM lion_cnt_hot) AS rows_ok,
	   groups = CASE idx
					WHEN 'hot_g' THEN (SELECT count(*) FROM
									   (SELECT g FROM lion_cnt_hot GROUP BY g) x)
					WHEN 'hot_k' THEN (SELECT count(*) FROM
									   (SELECT k FROM lion_cnt_hot GROUP BY k) x)
				END AS groups_ok
  FROM lion_vc WHERE mode = 'cached' ORDER BY idx;
  idx  | rows_ok | groups_ok 
-------+---------+-----------
 hot_g | t       | t
 hot_k | t       | t
(2 rows)

/*
 * The cache is used and it replaces fetches with hits.  How big the win is
 * depends on how many groups there are to share the answer: hot_g has 37
 * groups and hot_k has 5, and the cached run fetches each dirty page about
 * twice either way, so the ratio is the group count minus a constant.
 */
SELECT idx,
	   c.cache_hits > 0 AS cache_used,
	   c.cache_full = 0 AS budget_was_enough,
	   n.cache_hits = 0 AS nocache_has_no_hits,
	   n.blocks_rechecked > c.blocks_rechecked AS fewer_fetches,
	   n.blocks_rechecked > 5 * c.blocks_rechecked AS many_fewer_fetches
  FROM (SELECT * FROM lion_vc WHERE mode = 'cached') c
	   JOIN (SELECT * FROM lion_vc WHERE mode = 'nocache') n USING (idx)
 ORDER BY idx;
  idx  | cache_used | budget_was_enough | nocache_has_no_hits | fewer_fetches | many_fewer_fetches 
-------+------------+-------------------+---------------------+---------------+--------------------
 hot_g | t          | t                 | t                   | t             | t
 hot_k | t          | t                 | t                   | t             | f
(2 rows)

DELETE FROM lion_vc;
/*
 * Serializable isolation.  A cache hit calls neither
 * HeapCheckForSerializableConflictOut() nor PredicateLockTID(), so the page
 * whose answer was resolved is predicate-locked once, the way an index-only
 * scan locks a page it skips.  The result must be the same and the locks must
 * be there (SSI may coarsen page locks into a relation lock, which is why
 * only their presence is asserted).
 */
BEGIN ISOLATION LEVEL SERIALIZABLE;
INSERT INTO lion_vc
SELECT 'hot_g', 'serializable', * FROM lion_index_count_group_stats('lion_cnt_hot_g', true);
SELECT cnt = (SELECT count(*) FROM lion_cnt_hot) AS rows_ok,
	   cache_hits > 0 AS cache_used
  FROM lion_vc WHERE mode = 'serializable';
 rows_ok | cache_used 
---------+------------
 t       | t
(1 row)

SELECT count(*) > 0 AS took_predicate_locks
  FROM pg_locks
 WHERE mode = 'SIReadLock'
   AND relation = 'lion_cnt_hot'::regclass;
 took_predicate_locks 
----------------------
 t
(1 row)

COMMIT;
/*
 * A cache that fills up.  The budget is work_mem (in entries), and when it is
 * reached nothing more is inserted: the blocks that did not get in are
 * fetched per batch, exactly as they were before the cache existed, and
 * cache_full counts those visits.  lion_cnt is 200k rows over ~1600 heap
 * pages, every one of them dirtied by the DELETE above, which is well past
 * what 64kB of entries holds.
 */
SET work_mem = '64kB';
INSERT INTO lion_vc
SELECT 'c10', 'full', * FROM lion_index_count_group_stats('lion_cnt_c10', true);
RESET work_mem;
INSERT INTO lion_vc
SELECT 'c10', 'cached', * FROM lion_index_count_group_stats('lion_cnt_c10', true);
SELECT count(DISTINCT (groups, cnt, blocks_skipped, tids_rechecked)) AS answers,
	   count(DISTINCT blocks_rechecked + cache_hits) AS block_visits
  FROM lion_vc WHERE idx = 'c10';
 answers | block_visits 
---------+--------------
       1 |            1
(1 row)

SELECT cnt = (SELECT count(*) FROM lion_cnt) AS rows_ok,
	   groups = 10 AS groups_ok
  FROM lion_vc WHERE idx = 'c10' AND mode = 'full';
 rows_ok | groups_ok 
---------+-----------
 t       | t
(1 row)

SELECT (SELECT cache_full FROM lion_vc WHERE idx='c10' AND mode='full') > 0
			AS ran_out_of_budget,
	   (SELECT cache_full FROM lion_vc WHERE idx='c10' AND mode='cached') = 0
			AS budget_was_enough,
	   (SELECT cache_hits FROM lion_vc WHERE idx='c10' AND mode='full') > 0
			AS still_cached_something,
	   (SELECT blocks_rechecked FROM lion_vc WHERE idx='c10' AND mode='full') >
	   (SELECT blocks_rechecked FROM lion_vc WHERE idx='c10' AND mode='cached')
			AS a_small_cache_fetches_more;
 ran_out_of_budget | budget_was_enough | still_cached_something | a_small_cache_fetches_more 
-------------------+-------------------+------------------------+----------------------------
 t                 | t                 | t                      | t
(1 row)

DROP TABLE lion_vc;
-- the cache is on by default, and the function is STRICT like the others
SELECT count = (SELECT count(*) FROM lion_cnt) AS rows_ok, cache_hits > 0 AS cache_used
  FROM lion_index_count_group_stats('lion_cnt_c10');
 rows_ok | cache_used 
---------+------------
 t       | t
(1 row)

SELECT lion_index_count_group_stats(NULL) IS NULL AS null_index;
 null_index 
------------
 t
(1 row)

/* Error cases. */
-- wrong key type
SELECT lion_index_count('lion_cnt_c10', 'nope'::text);
ERROR:  type text cannot be compared with index "lion_cnt_c10"
SELECT lion_index_count('lion_cnt_t1000', 1);
ERROR:  type integer cannot be compared with index "lion_cnt_t1000"
-- not a lion index
CREATE INDEX lion_cnt_btree ON lion_cnt (c10);
SELECT lion_index_count('lion_cnt_btree', 0);
ERROR:  index "lion_cnt_btree" is not a lion index
-- not an index at all
SELECT lion_index_count('lion_cnt', 0);
ERROR:  "lion_cnt" is not an index
-- two indexes on different tables
CREATE TABLE lion_cnt_other (k int4);
CREATE INDEX lion_cnt_other_k ON lion_cnt_other USING lion (k);
SELECT lion_index_count('lion_cnt_c10', 0, 'lion_cnt_other_k', 0);
ERROR:  indexes "lion_cnt_c10" and "lion_cnt_other_k" are not on the same table
-- a materialized view created WITH NO DATA: its heap and indexes are empty,
-- and the query refuses to run; so does every count through it, rather than
-- answering 0 (2026-09-25 review)
CREATE MATERIALIZED VIEW lion_cnt_mv AS
SELECT i % 10 AS k FROM generate_series(1, 1000) i WITH NO DATA;
CREATE INDEX lion_cnt_mv_k ON lion_cnt_mv USING lion (k);
SELECT count(*) FROM lion_cnt_mv WHERE k = 1;
ERROR:  materialized view "lion_cnt_mv" has not been populated
SELECT lion_index_count('lion_cnt_mv_k', 1);
ERROR:  materialized view "lion_cnt_mv" has not been populated
SELECT lion_index_count('lion_cnt_mv_k', 1, 'lion_cnt_mv_k', 2);
ERROR:  materialized view "lion_cnt_mv" has not been populated
SELECT count FROM lion_index_count_stats('lion_cnt_mv_k', 1);
ERROR:  materialized view "lion_cnt_mv" has not been populated
SELECT lion_index_count_any('lion_cnt_mv_k', ARRAY[1, 2]);
ERROR:  materialized view "lion_cnt_mv" has not been populated
SELECT groups FROM lion_index_count_group_stats('lion_cnt_mv_k');
ERROR:  materialized view "lion_cnt_mv" has not been populated
REFRESH MATERIALIZED VIEW lion_cnt_mv;
SELECT lion_ccmp('lion_cnt_mv_k', 'lion_cnt_mv', 'k', '1');
 lion_ccmp 
-----------
 ok 100
(1 row)

SELECT lion_index_count_any('lion_cnt_mv_k', ARRAY[1, 2]) AS count_any;
 count_any 
-----------
       200
(1 row)

DROP MATERIALIZED VIEW lion_cnt_mv;
/*
 * Indexes that exist but that this transaction may not use (2026-09-20
 * review, finding 2).  A direct SQL count was handed an index nobody vetted,
 * so it makes the checks get_relation_info() makes for a query; the
 * cross-session indcheckxmin case, which is the one that produced a wrong
 * answer, is in test/isolation/count_checkxmin.spec.
 */
CREATE TABLE lion_cnt_elig (k int4);
INSERT INTO lion_cnt_elig SELECT i % 3 FROM generate_series(1, 300) i;
CREATE INDEX lion_cnt_elig_k ON lion_cnt_elig USING lion (k);
SELECT lion_index_count('lion_cnt_elig_k', 1);
 lion_index_count 
------------------
              100
(1 row)

UPDATE pg_index SET indisvalid = false
 WHERE indexrelid = 'lion_cnt_elig_k'::regclass;
SELECT lion_index_count('lion_cnt_elig_k', 1);
ERROR:  cannot count through index "lion_cnt_elig_k" because the index is not valid
SELECT lion_index_count('lion_cnt_elig_k', 1, 'lion_cnt_elig_k', 1);
ERROR:  cannot count through index "lion_cnt_elig_k" because the index is not valid
-- the verifier shares the check
SELECT lion_index_verify('lion_cnt_elig_k', true);
ERROR:  cannot verify index "lion_cnt_elig_k" against the heap because the index is not valid
UPDATE pg_index SET indisvalid = true, indisready = false
 WHERE indexrelid = 'lion_cnt_elig_k'::regclass;
SELECT lion_index_count('lion_cnt_elig_k', 1);
ERROR:  cannot count through index "lion_cnt_elig_k" because the index is not ready for queries
UPDATE pg_index SET indisready = true
 WHERE indexrelid = 'lion_cnt_elig_k'::regclass;
SELECT lion_index_count('lion_cnt_elig_k', 1);
 lion_index_count 
------------------
              100
(1 row)

SELECT lion_index_verify('lion_cnt_elig_k', true);
 lion_index_verify 
-------------------
 
(1 row)

