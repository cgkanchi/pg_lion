-- An empty table, and a table whose only key has one row.
CREATE TABLE lion_cnt_tiny (k int4);
CREATE INDEX lion_cnt_tiny_k ON lion_cnt_tiny USING lion (k);
SELECT lion_ccmp('lion_cnt_tiny_k', 'lion_cnt_tiny', 'k', '1');
