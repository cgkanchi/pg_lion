-------------------
 
(1 row)

SELECT q.q AS predicate, s.same, s.probed
  FROM lion_sc_q q, LATERAL lion_sc('SELECT count(*) FROM lion_sc WHERE ' || q.q) s
 ORDER BY q.n;
                                      predicate                                      | same | probed 
-------------------------------------------------------------------------------------+------+--------
 k BETWEEN 1000 AND 1300                                                             | t    | f
 k >= 15000                                                                          | t    | f
 k BETWEEN 1000 AND 4000 AND s = 7                                                   | t    | t
 k BETWEEN 1000 AND 1040 AND s = 7                                                   | t    | f
 k >= 500 AND s = 7                                                                  | t    | t
 k BETWEEN 1000 AND 4000 AND c = 7                                                   | t    | t
 k BETWEEN 1000 AND 1500 AND c = 7                                                   | t    | f
 k BETWEEN 1000 AND 4000 AND g = 3                                                   | t    | f
 k BETWEEN 1000 AND 20000 AND g = 3                                                  | t    | t
 k BETWEEN 3000 AND 9000 AND (s = 7 OR c = 3)                                        | t    | t
 k BETWEEN 3000 AND 9000 AND s = 7 AND n IS NOT NULL                                 | t    | t
 k >= 300 AND g = 3 AND s = 7                                                        | t    | t
 ts < '2025-01-15 00:00:00+00'                                                       | t    | f
 ts >= '2025-01-10 00:00:00+00' AND s = 7                                            | t    | t
 ts BETWEEN '2025-01-03 00:00:00+00' AND '2025-01-05 00:00:00+00' AND s IN (7, 8, 9) | t    | t
