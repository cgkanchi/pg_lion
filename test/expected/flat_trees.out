 2 | t       |      1 |        0 | t            |       1 |       0
 3 | t       |      4 |        0 | t            |       4 |       0
 4 | t       |      9 |        1 | f            |       0 |       0
 5 | t       |     11 |        1 | f            |       0 |       0
(5 rows)

