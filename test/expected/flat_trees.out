(6 rows)

-- ---------------------------------------------------------------------
-- 4. Position trees
-- ---------------------------------------------------------------------
-- A key of an index WITH (store_positions = true) keeps its rows' positions
-- in its entry while it is INLINE, and in a position tree of its own once it
-- spills - with no internal level up to 16 leaves, as a posting set.  Here
-- 'rare' stays INLINE, 'some' - 100 positions in every other row - has a few
-- position leaves, and 'many' - 255 in every row, about fifteen rows to a
-- leaf - grows past 16.
CREATE TABLE ftp (id int, d tsvector) WITH (autovacuum_enabled = off);
CREATE INDEX ftp_d ON ftp USING lion (d) WITH (store_positions = true);
-- The position trees of an index, by size: leaves, internal pages, whether
-- the head is a leaf, the chain from it.
CREATE FUNCTION ftp_report(OUT leaves int, OUT internal int,
	OUT head_is_leaf bool, OUT chained int, OUT flagged int)
RETURNS SETOF record LANGUAGE sql AS $$
	SELECT s.*
	  FROM (SELECT DISTINCT owner FROM ft_pages('ftp_d') WHERE flags & 128 <> 0) o,
		   LATERAL ft_set('ftp_d', o.owner) s
	 ORDER BY 1, 2
$$;
-- phrase queries through the positions, against the heap
CREATE FUNCTION ftp_counts(OUT q text, OUT via_index bigint, OUT via_heap bigint)
RETURNS SETOF record LANGUAGE plpgsql AS $$
BEGIN
	FOR q IN SELECT unnest(ARRAY['many <-> many', 'many <-> some', 'some <-> many',
								 'some <2> some', 'some <-> some', 'rare <-> many',
								 'some <146> rare', 'many & !some', 'rare'])
	LOOP
		PERFORM set_config('enable_seqscan', 'off', true);
		EXECUTE format('SELECT count(*) FROM ftp WHERE d @@ %L::tsquery', q) INTO via_index;
		PERFORM set_config('enable_seqscan', 'on', true);
		PERFORM set_config('enable_bitmapscan', 'off', true);
		PERFORM set_config('enable_indexscan', 'off', true);
		EXECUTE format('SELECT count(*) FROM ftp WHERE d @@ %L::tsquery', q) INTO via_heap;
		PERFORM set_config('enable_bitmapscan', 'on', true);
		PERFORM set_config('enable_indexscan', 'on', true);
		RETURN NEXT;
	END LOOP;
END $$;
-- a document: 'many' at positions 1 to 255, then 'some' at every other
-- position of the next 200 and 'rare' after them, when asked (one cast:
-- tsvector || tsvector would shift the right one's positions)
CREATE FUNCTION ftp_doc(with_some bool, with_rare bool) RETURNS tsvector
LANGUAGE sql AS $$
	SELECT ((SELECT string_agg('many:' || p, ' ') FROM generate_series(1, 255) p)
			|| CASE WHEN with_some
					THEN (SELECT ' ' || string_agg('some:' || p, ' ')
							FROM generate_series(256, 455, 2) p)
					ELSE '' END
			|| CASE WHEN with_rare THEN ' rare:600' ELSE '' END)::tsvector
$$;
INSERT INTO ftp SELECT i, ftp_doc(i % 2 = 0, i % 50 = 0) FROM generate_series(1, 150) i;
SELECT * FROM ftp_report();
 leaves | internal | head_is_leaf | chained | flagged 
--------+----------+--------------+---------+---------
      1 |        0 | t            |       1 |       0
      9 |        0 | t            |       9 |       0
(2 rows)

SELECT * FROM ft_check('ftp_d');
 stats_agree | height | verified 
-------------+--------+----------
 t           |      0 | t
(1 row)

SELECT * FROM ftp_counts();
        q        | via_index | via_heap 
-----------------+-----------+----------
 many <-> many   |       150 |      150
 many <-> some   |        75 |       75
 some <-> many   |         0 |        0
 some <2> some   |        75 |       75
 some <-> some   |         0 |        0
 rare <-> many   |         0 |        0
 some <146> rare |         3 |        3
 many & !some    |        75 |       75
 rare            |         3 |        3
(9 rows)

-- 'many' grown until its position tree is promoted
DO $$
BEGIN
	FOR i IN 151 .. 1000 LOOP
		INSERT INTO ftp VALUES (i, ftp_doc(i % 2 = 0, false));
		EXIT WHEN (SELECT max(internal) FROM ftp_report()) > 0;
	END LOOP;
END $$;
SELECT * FROM ftp_report();
