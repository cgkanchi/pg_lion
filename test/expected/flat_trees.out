(6 rows)

-- Each key grown until its shape changes: the INLINE set spills to one leaf,
-- the one leaf splits, the chains grow by a leaf, the set of 16 is promoted -
-- its head is now an internal page over 17 leaves, at the same block - and
-- the tree grows by a leaf.
SELECT lion_index_posting_root('ft_k', 4) AS head4 \gset
CALL ft_grow(1, 50);
CALL ft_grow(2, 50);
CALL ft_grow(3, 50);
CALL ft_grow(4, 50);
CALL ft_grow(5, 50);
SELECT * FROM ft_report();
 k | spilled | leaves | internal | head_is_leaf | chained | flagged 
---+---------+--------+----------+--------------+---------+---------
