 2 | t       |      1 |        0 | t            |       1 |       0
 3 | t       |      5 |        0 | t            |       5 |       0
 4 | t       |     17 |        1 | f            |       0 |       0
 5 | t       |     21 |        1 | f            |       0 |       0
(5 rows)

SELECT lion_index_posting_root('ft_k', 4) = :head4 AS promoted_head_kept_its_block;
