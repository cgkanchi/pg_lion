-- fixed edge cases: raw scalars, empty containers, numbers, nesting, NULLs
INSERT INTO jz VALUES (9001, '"s0"'), (9002, '["s0", 1]'), (9003, '[]'), (9004, '{}'),
	(9005, '{"k0": {}}'), (9006, '{"k0": []}'), (9007, '{"k0": [[]]}'), (9008, '{"k0": [{"k1": 1}, {"k2": 2}]}'),
	(9009, '{"k0": [{"k1": 1, "k2": 2}]}'), (9010, '[[1], [2]]'), (9011, '[[1, 2]]'), (9012, 'null'),
	(9013, '{"k0": 1e2}'), (9014, '{"k0": [1, [1]]}'), (9015, '{"k0": {"k1": [1]}}');
INSERT INTO jz_g SELECT * FROM jz WHERE id > 9000;
INSERT INTO jz_gp SELECT * FROM jz WHERE id > 9000;
INSERT INTO jz_l SELECT * FROM jz WHERE id > 9000;
SELECT x.* FROM (VALUES
	('@>', '"s0"'), ('@>', '["s0"]'), ('@>', '[]'), ('@>', '{}'), ('@>', '{"k0": {}}'),
	('@>', '{"k0": []}'), ('@>', '{"k0": [[]]}'), ('@>', '{"k0": [{}]}'), ('@>', '{"k0": [{"k1": 1, "k2": 2}]}'),
	('@>', '{"k0": [{"k1": 1}, {"k2": 2}]}'), ('@>', '[[1, 2]]'), ('@>', '[[1], [2]]'), ('@>', 'null'),
	('@>', '{"k0": 100}'), ('@>', '{"k0": 100.000}'), ('@>', '{"k0": [[1]]}'), ('@>', '{"k0": 1}'),
	('@>', '{"k0": {"k1": []}}'), ('@>', '1'), ('@>', '[1, 1]'), ('@>', '{"k0": [1, 1]}'),
	('?', 's0'), ('?', 'k0'), ('?', ''), ('?|', '{}'), ('?&', '{}'), ('?|', '{NULL}'), ('?&', '{NULL}'),
	('?|', '{NULL,k0}'), ('?&', '{NULL,k0}'), ('?&', '{k0,k1}'), ('?|', '{s0,k9}')) e(op, q),
	LATERAL jz_check(e.op, e.q) x;
