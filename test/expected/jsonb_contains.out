-- keys too long to be keys are hashed; a query that needs one is rechecked
INSERT INTO jz VALUES (9101, jsonb_build_object('k0', repeat('x', 3000))),
	(9102, jsonb_build_object(repeat('y', 3000), 1)), (9103, jsonb_build_array(repeat('z', 3000)));
