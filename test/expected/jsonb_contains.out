SELECT x.* FROM (VALUES
	('@>', jsonb_build_object('k0', repeat('x', 3000))::text), ('@>', jsonb_build_object('k0', repeat('x', 2999))::text),
	('@>', jsonb_build_object(repeat('y', 3000), 1)::text), ('@>', jsonb_build_array(repeat('z', 3000))::text),
	('?', repeat('y', 3000)), ('?', repeat('z', 3000)), ('?&', ARRAY[repeat('y', 3000), 'k0']::text)) e(op, q),
	LATERAL jz_check(e.op, e.q) x;
