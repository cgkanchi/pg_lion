-- `= ANY (array)` forms, which the count pushdown answers as an OR
CREATE FUNCTION jz_any(cond text) RETURNS boolean LANGUAGE plpgsql AS $$
DECLARE a int; b int;
BEGIN
	EXECUTE 'SELECT count(*) FROM jz WHERE ' || cond INTO a;
	PERFORM set_config('enable_seqscan', 'off', true);
	EXECUTE 'SELECT count(*) FROM jz_l WHERE ' || cond INTO b;
	PERFORM set_config('enable_seqscan', 'on', true);
	RETURN a = b;
END $$;
SELECT cond, jz_any(cond) AS same FROM (VALUES
	($$doc @> ANY (ARRAY['{"k0": 1}', '"s0"']::jsonb[])$$),
	($$doc @> ANY (ARRAY['{"k0": [{"k1": 1, "k2": 2}]}', '{"k1": true}']::jsonb[])$$),
	($$doc ? ANY (ARRAY['k0', 's1'])$$)) v(cond);
                                    cond                                     | same 
-----------------------------------------------------------------------------+------
 doc @> ANY (ARRAY['{"k0": 1}', '"s0"']::jsonb[])                            | t
 doc @> ANY (ARRAY['{"k0": [{"k1": 1, "k2": 2}]}', '{"k1": true}']::jsonb[]) | t
 doc ? ANY (ARRAY['k0', 's1'])                                               | t
(3 rows)

-- what the plans are: an exact query is counted from the index, one whose
-- keys only bound it is counted with a recheck, and `?& '{}'` (every row)
-- stays with the ordinary plan
SET enable_seqscan = off;
EXPLAIN (COSTS OFF) SELECT count(*) FROM jz_l WHERE doc @> '{"k0": [{"k1": 1}]}';
                          QUERY PLAN                          
--------------------------------------------------------------
 Custom Scan (LionCount)
   Lion Indexes: jz_l_i (doc @> '{"k0": [{"k1": 1}]}'::jsonb)
(2 rows)

EXPLAIN (COSTS OFF) SELECT count(*) FROM jz_l WHERE doc @> '{"k0": [{"k1": 1, "k2": 2}]}';
                              QUERY PLAN                               
-----------------------------------------------------------------------
 Custom Scan (LionCount)
   Lion Indexes: jz_l_i (doc @> '{"k0": [{"k1": 1, "k2": 2}]}'::jsonb)
(2 rows)

EXPLAIN (COSTS OFF) SELECT count(*) FROM jz_l WHERE doc ? 'k0' AND doc ?| '{s0,s1}';
                                  QUERY PLAN                                  
------------------------------------------------------------------------------
 Custom Scan (LionCount)
   Lion Indexes: jz_l_i (doc ? 'k0'::text), jz_l_i (doc ?| '{s0,s1}'::text[])
(2 rows)

EXPLAIN (COSTS OFF) SELECT count(*) FROM jz_l WHERE doc ?& '{}';
                   QUERY PLAN                    
-------------------------------------------------
 Aggregate
   ->  Bitmap Heap Scan on jz_l
         Recheck Cond: (doc ?& '{}'::text[])
         ->  Bitmap Index Scan on jz_l_i
               Index Cond: (doc ?& '{}'::text[])
(5 rows)

EXPLAIN (COSTS OFF) SELECT count(*) FROM jz_l WHERE doc ? ANY (ARRAY['k0', 's1']);
                                QUERY PLAN                                 
---------------------------------------------------------------------------
 Custom Scan (LionCount)
   Lion Indexes: jz_l_i, jz_l_i ((doc ? 'k0'::text) OR (doc ? 's1'::text))
(2 rows)

EXPLAIN (COSTS OFF) SELECT id FROM jz_l WHERE doc @> '{"k0": 1}';
                   QUERY PLAN                    
-------------------------------------------------
 Bitmap Heap Scan on jz_l
   Recheck Cond: (doc @> '{"k0": 1}'::jsonb)
   ->  Bitmap Index Scan on jz_l_i
         Index Cond: (doc @> '{"k0": 1}'::jsonb)
