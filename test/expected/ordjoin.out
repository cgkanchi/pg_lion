SELECT oj('SELECT f.id, f.score, d.pk, d.lvl FROM fact f JOIN dim d ON f.fk = d.pk
	WHERE f.grp = 2 AND d.lvl = 3 AND d.flag
	ORDER BY f.score DESC NULLS LAST, f.id LIMIT 20');
