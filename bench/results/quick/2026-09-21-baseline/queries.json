  "data_sql": {
    "scalar": "SELECT i::bigint AS id,\n        ((hashint8extended(i::bigint,11) & 9223372036854775807)%2)::int AS c2, ((hashint8extended(i::bigint,22) & 9223372036854775807)%20)::int AS c20,\n        ((hashint8extended(i::bigint,33) & 9223372036854775807)%200)::int AS c200, ((hashint8extended(i::bigint,44) & 9223372036854775807)%20000)::int AS c20k,\n        ((hashint8extended(i::bigint,55) & 9223372036854775807)%1000000)::int AS c1m,\n        LEAST(199, ((i-1)*200/500000))::int AS clustered,\n        CASE WHEN (hashint8extended(i::bigint,66) & 9223372036854775807)%10<9 THEN 0 ELSE 1+((hashint8extended(i::bigint,77) & 9223372036854775807)%999)::int END AS skew,\n        CASE WHEN (hashint8extended(i::bigint,88) & 9223372036854775807)%10=0 THEN NULL ELSE ((hashint8extended(i::bigint,99) & 9223372036854775807)%200)::int END AS nullable,\n        repeat(md5(i::text),2) AS payload\n        FROM generate_series(1::bigint,500000::bigint) i",
    "documents": "SELECT i::bigint AS id, ((hashint8extended(i::bigint,13) & 9223372036854775807)%20)::int AS grp,\n        CASE WHEN i%101=0 THEN NULL WHEN i%97=0 THEN ARRAY[]::text[]\n             ELSE ARRAY['t'||((hashint8extended(i::bigint,14) & 9223372036854775807)%20),'t'||((hashint8extended(i::bigint,15) & 9223372036854775807)%200),'t'||((hashint8extended(i::bigint,16) & 9223372036854775807)%2000)] END AS tags,\n        CASE WHEN i%101=0 THEN NULL ELSE to_tsvector('simple',\n             CASE WHEN i%97=0 THEN '' ELSE\n             'common w'||((hashint8extended(i::bigint,14) & 9223372036854775807)%20)||' w'||((hashint8extended(i::bigint,15) & 9223372036854775807)%200)||' w'||((hashint8extended(i::bigint,16) & 9223372036854775807)%2000)||\n             ' rare'||((hashint8extended(i::bigint,17) & 9223372036854775807)%10000)||' endword' END) END AS tsv,\n        repeat(md5(i::text),2) AS payload\n        FROM generate_series(1::bigint,50000::bigint) i"
  },
